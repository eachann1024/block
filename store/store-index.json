      "name": {
        "zh": "同步",
        "en": "Sync"
      },
      "version": "1.3.28",
      "author": "Block Community",
      "repo": "blockmd-plugins/block-sync",
      "summary": {
        "zh": "支持本地目录镜像、WebDAV 与 Git 仓库的多端增量同步",
        "en": "Incremental notebook sync via local mirror, WebDAV, and Git"
      },
      "download_url": "https://github.com/blockmd-plugins/block-sync/releases/download/v1.3.28/block-sync-v1.3.28.tar.gz",
      "sha256": "3f18bbc28cf43743a65463f8e0b5d58bc09d7faf9633b167d16baad3aa20019a",
      "downloads": 1281,
      "stars": 0,
