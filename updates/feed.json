    {
      "version": "1.0.915",
      "tag": "v1.0.915",
      "published_at": "2026-11-23T17:41:44Z",
      "html_url": "https://github.com/eachann1024/block/releases/tag/v1.0.915",
      "zh": {
        "highlights": "",
        "new": [
          "插件现在可以通过宿主接口将文件移入回收站，操作前会检查文件版本。",
          "活动日志现在会记录用户移入回收站的操作、插件文件写入，以及通过插件日志接口写入的内容。"
        ],
        "improvements": [
          "插件分类现在按作用位置排列，同步和导入导出归入工具分类。",
          "插件分类现在由各自的清单决定，官方插件必须声明分类。"
        ],
        "fixes": [
          "从行内文本或表格单元格复制纯文本时，不再包含 Markdown 标记。",
          "输入法提交带后续文本的反引号时，现在也能正确转换为行内代码。",
          "不确定进度条现在会保持在轨道范围内。"
        ],
        "other": []
      },
      "en": {
        "highlights": "",
        "new": [
          "Plugins can now move files to the trash through a host API that checks the file revision before acting.",
          "The activity log now records user trash actions, plugin file writes, and entries written through the plugin logging API."
        ],
        "improvements": [
          "Plugin categories are now ordered by where they operate, with sync and import/export grouped under Tools.",
          "Plugin categories are now determined by each plugin’s manifest, and official plugins must declare a category."
        ],
        "fixes": [
          "Plain text copied from inline text or table cells no longer includes Markdown markers.",
          "Inline code is now correctly converted when an IME commits backticks followed by additional text.",
          "Indeterminate progress bars now stay within the bounds of their tracks."
        ],
        "other": []
      },
      "assets": []
    },
