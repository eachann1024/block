_block_run_as_user_env() {
  local target_user="$1"
  local target_uid="$2"
  local target_home="$3"
  shift 3
  [ -n "$target_user" ] && [ "$target_uid" != "0" ] && [ -d "$target_home" ] || return 0
  if command -v runuser >/dev/null 2>&1; then
    runuser -u "$target_user" -- env HOME="$target_home" USER="$target_user" LOGNAME="$target_user" "$@" >/dev/null 2>&1 || return 1
  elif command -v su >/dev/null 2>&1; then
    su -s /bin/sh "$target_user" -c 'exec env "$@"' -- _ HOME="$target_home" USER="$target_user" LOGNAME="$target_user" "$@" >/dev/null 2>&1 || return 1
  fi
}

_block_resolve_installing_user() {
  local target_spec=""
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    target_spec="$SUDO_USER"
  elif [ -n "${DOAS_USER:-}" ] && [ "$DOAS_USER" != "root" ]; then
    target_spec="$DOAS_USER"
  elif [ -n "${PKEXEC_UID:-}" ] && [ "$PKEXEC_UID" != "0" ]; then
    target_spec="$PKEXEC_UID"
  fi
  [ -n "$target_spec" ] || return 1
  getent passwd "$target_spec" 2>/dev/null
}

_block_sync_for_installing_user_session() {
  local pw_entry target_user target_uid target_home runtime_dir sess_env
  local sess_desktop="" sess_cfg_home="" sess_data_home="" sess_cfg_dirs="" sess_data_dirs="" sess_dbus=""
  pw_entry="$(_block_resolve_installing_user || true)"
  [ -n "$pw_entry" ] || return 0
  target_user="$(printf '%s\n' "$pw_entry" | cut -d: -f1)"
  target_uid="$(printf '%s\n' "$pw_entry" | cut -d: -f3)"
  target_home="$(printf '%s\n' "$pw_entry" | cut -d: -f6)"
  [ -n "$target_user" ] && [ "$target_uid" != "0" ] && [ -d "$target_home" ] || return 0
  runtime_dir="/run/user/$target_uid"
  sess_env=""
  if [ -S "$runtime_dir/bus" ] && command -v systemctl >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
    sess_env="$(runuser -u "$target_user" -- env HOME="$target_home" XDG_RUNTIME_DIR="$runtime_dir" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus" systemctl --user show-environment 2>/dev/null || true)"
  fi
  if [ -n "$sess_env" ]; then
    sess_desktop="$(printf '%s\n' "$sess_env" | sed -n 's/^XDG_CURRENT_DESKTOP=//p' | head -n1)"
    sess_cfg_home="$(printf '%s\n' "$sess_env" | sed -n 's/^XDG_CONFIG_HOME=//p' | head -n1)"
    sess_data_home="$(printf '%s\n' "$sess_env" | sed -n 's/^XDG_DATA_HOME=//p' | head -n1)"
    sess_cfg_dirs="$(printf '%s\n' "$sess_env" | sed -n 's/^XDG_CONFIG_DIRS=//p' | head -n1)"
    sess_data_dirs="$(printf '%s\n' "$sess_env" | sed -n 's/^XDG_DATA_DIRS=//p' | head -n1)"
    sess_dbus="$(printf '%s\n' "$sess_env" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n1)"
  fi
  if [ -z "$sess_desktop" ] && [ -n "${XDG_CURRENT_DESKTOP:-}" ]; then
    sess_desktop="$XDG_CURRENT_DESKTOP"
    case "${XDG_CONFIG_HOME:-}" in ""|/root|/root/*) ;; *) sess_cfg_home="$XDG_CONFIG_HOME" ;; esac
    case "${XDG_DATA_HOME:-}" in ""|/root|/root/*) ;; *) sess_data_home="$XDG_DATA_HOME" ;; esac
    sess_cfg_dirs="${XDG_CONFIG_DIRS:-}"
    sess_data_dirs="${XDG_DATA_DIRS:-}"
  fi
  [ -n "$sess_desktop" ] || return 0
  local env_args=(-u BLOCK_DATA_DIR -u XDG_CONFIG_HOME -u XDG_DATA_HOME -u XDG_CONFIG_DIRS -u XDG_DATA_DIRS -u DBUS_SESSION_BUS_ADDRESS "XDG_CURRENT_DESKTOP=$sess_desktop")
  [ -d "$runtime_dir" ] && env_args+=("XDG_RUNTIME_DIR=$runtime_dir")
  [ -n "$sess_cfg_home" ] && env_args+=("XDG_CONFIG_HOME=$sess_cfg_home")
  [ -n "$sess_data_home" ] && env_args+=("XDG_DATA_HOME=$sess_data_home")
  [ -n "$sess_cfg_dirs" ] && env_args+=("XDG_CONFIG_DIRS=$sess_cfg_dirs")
  [ -n "$sess_data_dirs" ] && env_args+=("XDG_DATA_DIRS=$sess_data_dirs")
  [ -n "$sess_dbus" ] && env_args+=("DBUS_SESSION_BUS_ADDRESS=$sess_dbus")
  _block_run_as_user_env "$target_user" "$target_uid" "$target_home" "${env_args[@]}" /usr/bin/block --sync-user-linux-file-associations --require-desktop-session || true
}

_block_cleanup_single_user() {
  local target_user="$1"
  local target_uid="$2"
  local target_home="$3"
  [ -n "$target_user" ] && [ "$target_uid" != "0" ] && [ -d "$target_home" ] || return 0
  local runtime_dir="/run/user/$target_uid"
  local sess_env="" sess_cfg_home="" sess_data_home=""
  if [ -S "$runtime_dir/bus" ] && command -v systemctl >/dev/null 2>&1 && command -v runuser >/dev/null 2>&1; then
    sess_env="$(runuser -u "$target_user" -- env HOME="$target_home" XDG_RUNTIME_DIR="$runtime_dir" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus" systemctl --user show-environment 2>/dev/null || true)"
  fi
  if [ -n "$sess_env" ]; then
    sess_cfg_home="$(printf '%s\n' "$sess_env" | sed -n 's/^XDG_CONFIG_HOME=//p' | head -n1)"
    sess_data_home="$(printf '%s\n' "$sess_env" | sed -n 's/^XDG_DATA_HOME=//p' | head -n1)"
  fi
  local env_args=(-u BLOCK_DATA_DIR -u XDG_CONFIG_HOME -u XDG_DATA_HOME)
  [ -n "$sess_cfg_home" ] && env_args+=("XDG_CONFIG_HOME=$sess_cfg_home")
  [ -n "$sess_data_home" ] && env_args+=("XDG_DATA_HOME=$sess_data_home")
  _block_run_as_user_env "$target_user" "$target_uid" "$target_home" "${env_args[@]}" /usr/bin/block --cleanup-file-associations || true
}

_block_cleanup_all_users() {
  local cleaned_users="" pw_inst u_name u_uid u_home has_block f
  pw_inst="$(_block_resolve_installing_user || true)"
  if [ -n "$pw_inst" ]; then
    u_name="$(printf '%s\n' "$pw_inst" | cut -d: -f1)"
    u_uid="$(printf '%s\n' "$pw_inst" | cut -d: -f3)"
    u_home="$(printf '%s\n' "$pw_inst" | cut -d: -f6)"
    _block_cleanup_single_user "$u_name" "$u_uid" "$u_home"
    cleaned_users=" $u_name "
  fi
  getent passwd 2>/dev/null | while IFS=: read -r u_name _ u_uid _ _ u_home _; do
    [ -n "$u_name" ] && [ "$u_uid" != "0" ] && [ -d "$u_home" ] || continue
    case "$cleaned_users" in *" $u_name "*) continue ;; esac
    has_block=0
    if [ -f "$u_home/.local/share/Block/file-associations.json" ] || [ -f "$u_home/.config/.block-fileassoc/file-associations.json" ] || [ -f "$u_home/.local/share/applications/block-plugins.desktop" ]; then
      has_block=1
    else
      for f in "$u_home/.local/share/applications"/block-assoc-*.desktop; do
        if [ -e "$f" ]; then has_block=1; break; fi
      done
    fi
    [ "$has_block" = "1" ] || continue
    _block_cleanup_single_user "$u_name" "$u_uid" "$u_home"
  done
}

_block_install_deferred_user_cleanup() {
  local target_desktop_id="$1"
  [ -n "$target_desktop_id" ] || return 0
  mkdir -p /var/lib/block/pending-uninstall /etc/xdg/autostart || return 0
  printf '%s\n' "/usr/bin/block" > "/var/lib/block/pending-uninstall/$target_desktop_id" || true
  cat > /var/lib/block/cleanup-user-assoc.sh <<'BLOCK_CLEANUP_EOF'
#!/bin/sh
set -eu
[ ! -x /usr/bin/block ] || exit 0
TARGET_ID="__BLOCK_TARGET_DESKTOP_ID__"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
APP_DIR="$DATA_HOME/applications"
XDG_STATE="$CONFIG_HOME/.block-fileassoc"
DESKTOP_FILE="$APP_DIR/$TARGET_ID"
SIDECAR="$XDG_STATE/pins-$TARGET_ID.tsv"
JSON_SHARED="$XDG_STATE/file-associations.json"
JSON_LOCAL="$DATA_HOME/Block/file-associations.json"
LOCK_FILE="$XDG_STATE/.file-associations.v2.lock"
HAS_JSON=0
for _jf in "$JSON_SHARED" "$JSON_LOCAL"; do
  if [ -f "$_jf" ] && (grep -qF "\"$TARGET_ID\"" "$_jf" 2>/dev/null || grep -qF '"/usr/bin/block"' "$_jf" 2>/dev/null); then
    HAS_JSON=1
    break
  fi
done
[ -e "$DESKTOP_FILE" ] || [ -e "$SIDECAR" ] || [ "$HAS_JSON" = "1" ] || exit 0
do_cleanup() {
  [ ! -x /usr/bin/block ] || exit 0
  TMP_RM="$(mktemp "${TMPDIR:-/tmp}/.block-rm-pins.XXXXXX")"
  TMP_KEEP="$(mktemp "${TMPDIR:-/tmp}/.block-keep-pins.XXXXXX")"
  TMP_DHS="$(mktemp "${TMPDIR:-/tmp}/.block-dhs.XXXXXX")"
  trap 'rm -f "$TMP_RM" "$TMP_KEEP" "$TMP_DHS"' EXIT INT TERM
  printf '%s\n' "$DATA_HOME" > "$TMP_DHS"
  if [ -f "$SIDECAR" ]; then
    sed -n 's/^#data_home=//p' "$SIDECAR" >> "$TMP_DHS" || true
    awk -F'\t' '!/^#/ && NF>=2 && $1!="" && $2!="" {print $1 "\t" $2}' "$SIDECAR" >> "$TMP_RM" || true
  fi
  for sc in "$XDG_STATE"/pins-*.tsv; do
    [ -f "$sc" ] || continue
    [ "$sc" != "$SIDECAR" ] || continue
    base="$(basename "$sc")"
    other_id="${base#pins-}"
    other_id="${other_id%.tsv}"
    other_dh="$(sed -n 's/^#data_home=//p' "$sc" | head -n1)"
    [ -n "$other_dh" ] || other_dh="$DATA_HOME"
    [ -e "$other_dh/applications/$other_id" ] || continue
    awk -F'\t' '!/^#/ && NF>=1 && $1!="" {print $1}' "$sc" >> "$TMP_KEEP" || true
  done
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$TARGET_ID" "$DATA_HOME" "$TMP_RM" "$TMP_KEEP" "$TMP_DHS" "$JSON_SHARED" "$JSON_LOCAL" <<'PY_EXTRACT' || exit 1
import json, os, sys
target_id, default_dh, rm_path, keep_path, dhs_path = sys.argv[1:6]
json_paths = sys.argv[6:]
rm_lines, keep_lines, dhs = [], [], []
def add_pairs(dst, m):
    if isinstance(m, dict):
        for k, v in m.items():
            if isinstance(k, str) and isinstance(v, str) and k.strip() and v.strip():
                dst.append(f"{k.strip()}\t{v.strip()}\n")
def add_keys(dst, m):
    if isinstance(m, dict):
        for k in m.keys():
            if isinstance(k, str) and k.strip():
                dst.append(f"{k.strip()}\n")
for jp in json_paths:
    if not os.path.isfile(jp):
        continue
    try:
        with open(jp, "r", encoding="utf-8") as f:
            st = json.load(f)
    except Exception:
        continue
    if not isinstance(st, dict):
        continue
    main_id = (st.get("linux_main_desktop_id") or "block-user.desktop").strip()
    main_dh = (st.get("linux_main_data_home") or default_dh).strip() or default_dh
    if main_id and main_id != target_id and os.path.exists(os.path.join(main_dh, "applications", main_id)):
        add_keys(keep_lines, st.get("pinned_linux_main_defaults"))
        add_keys(keep_lines, st.get("pending_pinned_linux_main_defaults"))
    scopes = st.get("linux_scopes")
    found_target = False
    if isinstance(scopes, dict):
        for sid, sc in scopes.items():
            if not isinstance(sc, dict):
                continue
            dh = (sc.get("data_home") or default_dh).strip() or default_dh
            if sid == target_id:
                found_target = True
                dhs.append(dh + "\n")
                add_pairs(rm_lines, sc.get("pinned_linux_defaults"))
                add_pairs(rm_lines, sc.get("pending_pinned_linux_defaults"))
            elif os.path.exists(os.path.join(dh, "applications", sid)):
                add_keys(keep_lines, sc.get("pinned_linux_defaults"))
                add_keys(keep_lines, sc.get("pending_pinned_linux_defaults"))
    if not found_target and (st.get("executable_path") or "").strip() == "/usr/bin/block":
        add_pairs(rm_lines, st.get("pinned_linux_defaults"))
with open(rm_path, "a", encoding="utf-8") as f:
    f.writelines(rm_lines)
with open(keep_path, "a", encoding="utf-8") as f:
    f.writelines(keep_lines)
with open(dhs_path, "a", encoding="utf-8") as f:
    f.writelines(dhs)
PY_EXTRACT
  fi
  SEEN_DHS=""
  while IFS= read -r _dh; do
    [ -n "$_dh" ] || continue
    case "$SEEN_DHS" in *"|$_dh|"*) continue ;; esac
    SEEN_DHS="$SEEN_DHS|$_dh|"
    _df="$_dh/applications/$TARGET_ID"
    if [ -e "$_df" ]; then
      rm -f "$_df" || exit 1
      if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database "$_dh/applications" >/dev/null 2>&1 || exit 1
      fi
    fi
  done < "$TMP_DHS"
  if [ -s "$TMP_RM" ] && [ -e "$CONFIG_HOME/mimeapps.list" ]; then
    mimeapps_sig() {
      _f="$1"
      _st="$(stat -c "%d:%i:%s:%Y:%Z" "$_f" 2>/dev/null || stat -f "%d:%i:%z:%m:%c" "$_f" 2>/dev/null || true)"
      _ck="$(cksum < "$_f" 2>/dev/null || true)"
      printf "%s|%s" "$_st" "$_ck"
    }
    copy_file_mode() {
      _src="$1"; _dst="$2"
      chmod --reference="$_src" "$_dst" 2>/dev/null || {
        _m="$(stat -c "%a" "$_src" 2>/dev/null || stat -f "%Lp" "$_src" 2>/dev/null || echo 644)"
        chmod "$_m" "$_dst" 2>/dev/null || chmod 0644 "$_dst" 2>/dev/null || true
      }
    }
    COMMITTED=0
    ATTEMPT=0
    while [ "$ATTEMPT" -lt 5 ]; do
      ATTEMPT=$((ATTEMPT + 1))
      REAL_MIMEAPPS="$CONFIG_HOME/mimeapps.list"
      if [ -L "$REAL_MIMEAPPS" ]; then
        REAL_MIMEAPPS="$(readlink -f "$REAL_MIMEAPPS" 2>/dev/null || true)"
        [ -n "$REAL_MIMEAPPS" ] && [ -f "$REAL_MIMEAPPS" ] || { COMMITTED=1; break; }
      fi
      [ -f "$REAL_MIMEAPPS" ] || { COMMITTED=1; break; }
      BEFORE_SIG="$(mimeapps_sig "$REAL_MIMEAPPS")"
      TMP_OUT="$(mktemp "$(dirname "$REAL_MIMEAPPS")/.block-mimeapps-clean.XXXXXX")"
      if ! awk -v rm_file="$TMP_RM" -v keep_file="$TMP_KEEP" '
        BEGIN {
          FS="\t";
          while ((getline line < rm_file) > 0) {
            if (line ~ /^#/ || line == "") continue;
            split(line, kv, "\t");
            if (kv[1] != "" && kv[2] != "") rm_pair[tolower(kv[1]) SUBSEP kv[2]] = 1;
          }
          close(rm_file);
          while ((getline line < keep_file) > 0) {
            if (line ~ /^#/ || line == "") continue;
            split(line, kv, "\t");
            if (kv[1] != "") keep[tolower(kv[1])] = 1;
          }
          close(keep_file);
          FS="="; sec="";
        }
        /^[[:space:]]*\[.*\][[:space:]]*$/ { sec = $0; gsub(/^[[:space:]]+|[[:space:]]+$/, "", sec); print; next }
        {
          if (sec == "[Default Applications]" && index($0, "=") > 0) {
            k = tolower($1); gsub(/^[[:space:]]+|[[:space:]]+$/, "", k);
            v = substr($0, index($0, "=") + 1); gsub(/^[[:space:]]+|[[:space:]]+$/, "", v);
            vc = v; sub(/;$/, "", vc);
            if (!(k in keep) && ((k SUBSEP vc) in rm_pair)) next;
          }
          print
        }
      ' "$REAL_MIMEAPPS" > "$TMP_OUT"; then
        rm -f "$TMP_OUT"
        exit 1
      fi
      AFTER_SIG="$(mimeapps_sig "$REAL_MIMEAPPS")"
      if [ "$AFTER_SIG" != "$BEFORE_SIG" ]; then
        rm -f "$TMP_OUT"
        continue
      fi
      if cmp -s "$REAL_MIMEAPPS" "$TMP_OUT"; then
        rm -f "$TMP_OUT"
        COMMITTED=1
        break
      fi
      copy_file_mode "$REAL_MIMEAPPS" "$TMP_OUT"
      AFTER_SIG="$(mimeapps_sig "$REAL_MIMEAPPS")"
      if [ "$AFTER_SIG" != "$BEFORE_SIG" ]; then
        rm -f "$TMP_OUT"
        continue
      fi
      mv -f "$TMP_OUT" "$REAL_MIMEAPPS"
      COMMITTED=1
      break
    done
    [ "$COMMITTED" = "1" ] || exit 1
  fi
  rm -f "$SIDECAR"
  if command -v python3 >/dev/null 2>&1; then
    python3 - "$TARGET_ID" "$JSON_SHARED" "$JSON_LOCAL" <<'PY_PRUNE' || true
import json, os, sys, tempfile
target_id = sys.argv[1]
for jp in sys.argv[2:]:
    if not os.path.isfile(jp):
        continue
    try:
        with open(jp, "r", encoding="utf-8") as f:
            st = json.load(f)
    except Exception:
        continue
    if not isinstance(st, dict):
        continue
    changed = False
    scopes = st.get("linux_scopes")
    if isinstance(scopes, dict) and target_id in scopes:
        del scopes[target_id]
        changed = True
    if (st.get("executable_path") or "").strip() == "/usr/bin/block":
        st["executable_path"] = ""
        st["extensions"] = []
        st.pop("pinned_linux_defaults", None)
        changed = True
    if not changed:
        continue
    has_scopes = isinstance(scopes, dict) and len(scopes) > 0
    has_main = bool(st.get("pinned_linux_main_defaults")) or bool(st.get("pending_pinned_linux_main_defaults"))
    if not has_scopes and not has_main:
        try:
            os.remove(jp)
        except OSError:
            pass
        continue
    if has_scopes:
        first_key = sorted(scopes.keys())[0]
        keep = scopes[first_key] if isinstance(scopes[first_key], dict) else {}
        st["executable_path"] = keep.get("executable_path", "")
        st["extensions"] = keep.get("extensions", [])
        if keep.get("pinned_linux_defaults"):
            st["pinned_linux_defaults"] = keep["pinned_linux_defaults"]
        else:
            st.pop("pinned_linux_defaults", None)
    d = os.path.dirname(jp)
    fd, tmp = tempfile.mkstemp(prefix=".file-assoc-clean.", dir=d)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(st, f, indent=2)
            f.write("\n")
        os.chmod(tmp, 0o644)
        os.replace(tmp, jp)
    except Exception:
        try:
            os.remove(tmp)
        except OSError:
            pass
PY_PRUNE
  fi
}
if [ "${BLOCK_CLEANUP_LOCKED:-0}" = "1" ]; then
  do_cleanup
elif ([ -d "$XDG_STATE" ] || mkdir -p "$XDG_STATE" 2>/dev/null) && command -v flock >/dev/null 2>&1; then
  exec 9>>"$LOCK_FILE"
  flock -w 10 9 || exit 1
  do_cleanup
elif ([ -d "$XDG_STATE" ] || mkdir -p "$XDG_STATE" 2>/dev/null) && command -v python3 >/dev/null 2>&1; then
  python3 - "$LOCK_FILE" "$0" <<'PY_LOCK'
import fcntl, os, subprocess, sys, time
lock_path, script_path = sys.argv[1], sys.argv[2]
fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o600)
deadline = time.monotonic() + 10.0
while True:
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        break
    except BlockingIOError:
        if time.monotonic() >= deadline:
            sys.exit(1)
        time.sleep(0.025)
env = os.environ.copy()
env["BLOCK_CLEANUP_LOCKED"] = "1"
rc = subprocess.call(["/bin/sh", script_path], env=env)
fcntl.flock(fd, fcntl.LOCK_UN)
os.close(fd)
sys.exit(rc)
PY_LOCK
else
  exit 1
fi
BLOCK_CLEANUP_EOF
  sed -i "s|__BLOCK_TARGET_DESKTOP_ID__|$target_desktop_id|g" /var/lib/block/cleanup-user-assoc.sh
  chmod 0755 /var/lib/block/cleanup-user-assoc.sh
  cat > /etc/xdg/autostart/block-fileassoc-cleanup.desktop <<'BLOCK_AUTOSTART_EOF'
[Desktop Entry]
Type=Application
Name=Block File Association Cleanup
TryExec=/var/lib/block/cleanup-user-assoc.sh
Exec=/var/lib/block/cleanup-user-assoc.sh
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
BLOCK_AUTOSTART_EOF
}

post_install() {
  rm -f /etc/xdg/autostart/block-fileassoc-cleanup.desktop /var/lib/block/cleanup-user-assoc.sh /var/lib/block/uninstall-helper-id
  rm -rf /var/lib/block/pending-uninstall
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q /usr/share/icons/hicolor || true
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
  fi
  if [ -x /usr/bin/block ]; then
    _block_sync_for_installing_user_session
  fi
}

post_upgrade() {
  post_install
}

pre_remove() {
  if [ -x /usr/bin/block ]; then
    local helper_id
    helper_id="$(/usr/bin/block --print-linux-helper-id 2>/dev/null || true)"
    if [ -n "$helper_id" ]; then
      mkdir -p /var/lib/block || true
      printf '%s\n' "$helper_id" > /var/lib/block/uninstall-helper-id || true
    fi
    /usr/bin/block --cleanup-system-linux-desktop || true
    _block_cleanup_all_users
  fi
}

post_remove() {
  local helper_id=""
  if [ -f /var/lib/block/uninstall-helper-id ]; then
    helper_id="$(cat /var/lib/block/uninstall-helper-id 2>/dev/null || true)"
    rm -f /var/lib/block/uninstall-helper-id
  fi
  if [ -n "$helper_id" ]; then
    _block_install_deferred_user_cleanup "$helper_id"
  fi
  if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q /usr/share/icons/hicolor || true
  fi
  if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
  fi
}
