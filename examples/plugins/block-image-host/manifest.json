{
  "app": "blockmd",
  "schema_version": 1,
  "id": "block-image-host",
  "name": {
    "zh": "图床上传",
    "en": "Image Host"
  },
  "version": "1.0.0",
  "author": "Block Community",
  "repo": "blockmd-community/block-image-host",
  "summary": {
    "zh": "支持 Cloudflare R2、S3 兼容存储与 GitHub 仓库的笔记图片自动上传",
    "en": "Upload local note images to Cloudflare R2, S3-compatible storage, or GitHub"
  },
  "entry": {
    "command": ["python3", "-u", "main.py"]
  },
  "permissions": [
    "storage",
    "notes:read",
    "notes:write",
    "network",
    "events:note_saved"
  ],
  "surfaces": [
    "settings_page"
  ],
  "icon": {
    "view_box": "0 0 24 24",
    "fill_paths": [
