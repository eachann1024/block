<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>更新图标动效 A · 气泡簇拥 + 图标弹入 + 手绘狂草绕圈线（含悬停双色 Duo 动效）</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<style>
body{margin:0}
button{font-family:inherit;cursor:pointer}

/* ===== 进场 3 段式时序（1. 气泡先出 -> 2. 显示图标 -> 3. 双色乱糟糟绕圈线条） ===== */
@keyframes puffA1{
  0%{transform:translate(0,0) scale(.15);opacity:0}
  5%{opacity:.95}
  26%{transform:translate(-64px,-46px) scale(1.05);opacity:0}
  100%{transform:translate(-64px,-46px) scale(1.05);opacity:0}
}
@keyframes puffA2{
  0%,2%{transform:translate(0,0) scale(.15);opacity:0}
  7%{opacity:.95}
  28%{transform:translate(-28px,-68px) scale(1.1);opacity:0}
  100%{transform:translate(-28px,-68px) scale(1.1);opacity:0}
}
@keyframes puffA3{
  0%,3%{transform:translate(0,0) scale(.15);opacity:0}
  8%{opacity:.95}
  27%{transform:translate(18px,-72px) scale(1);opacity:0}
  100%{transform:translate(18px,-72px) scale(1);opacity:0}
}
@keyframes puffA4{
  0%,1%{transform:translate(0,0) scale(.15);opacity:0}
  6%{opacity:.95}
  29%{transform:translate(62px,-48px) scale(1.08);opacity:0}
  100%{transform:translate(62px,-48px) scale(1.08);opacity:0}
}
@keyframes puffA5{
  0%,4%{transform:translate(0,0) scale(.15);opacity:0}
  9%{opacity:.95}
  30%{transform:translate(74px,-8px) scale(.95);opacity:0}
  100%{transform:translate(74px,-8px) scale(.95);opacity:0}
}
@keyframes puffA6{
  0%,2%{transform:translate(0,0) scale(.15);opacity:0}
  7%{opacity:.95}
  28%{transform:translate(-72px,16px) scale(1);opacity:0}
  100%{transform:translate(-72px,16px) scale(1);opacity:0}
}
@keyframes puffA7{
  0%,5%{transform:translate(0,0) scale(.15);opacity:0}
  10%{opacity:.95}
  31%{transform:translate(46px,38px) scale(1);opacity:0}
  100%{transform:translate(46px,38px) scale(1);opacity:0}
}

/* 第 2 步：气泡冒出后图标弹入 */
@keyframes iconPopA{
  0%,17%{transform:scale(0) rotate(-14deg);opacity:0}
  26%{transform:scale(1.16) rotate(4deg);opacity:1}
  32%{transform:scale(.95) rotate(-2deg);opacity:1}
  37%,90%{transform:scale(1) rotate(0deg);opacity:1}
  96%,100%{transform:scale(0) rotate(0deg);opacity:0}
}

/* 第 3 步：双色乱糟糟手绘绕圈线（浅蓝语义粗衬底 #c9d8f3 + 强调蓝主线 #547dd0 + 深墨飞白 #20242c） */
@keyframes scribbleCoilA{
  0%,35%{stroke-dashoffset:680;opacity:0}
  38%{opacity:1}
  66%{stroke-dashoffset:0;opacity:1}
  84%{stroke-dashoffset:0;opacity:.92}
  94%,100%{stroke-dashoffset:-680;opacity:0}
}
@keyframes scribbleScratchA{
  0%,40%{stroke-dashoffset:360;opacity:0}
  43%{opacity:1}
  70%{stroke-dashoffset:0;opacity:1}
  85%{stroke-dashoffset:0;opacity:.88}
  95%,100%{stroke-dashoffset:-360;opacity:0}
}

/* 单次触发重播组 */
@keyframes puffOnce1{0%{transform:translate(0,0) scale(.2);opacity:0}12%{opacity:.95}100%{transform:translate(-64px,-46px) scale(1.05);opacity:0}}
@keyframes puffOnce2{0%{transform:translate(0,0) scale(.2);opacity:0}12%{opacity:.95}100%{transform:translate(-28px,-68px) scale(1.1);opacity:0}}
@keyframes puffOnce3{0%{transform:translate(0,0) scale(.2);opacity:0}12%{opacity:.95}100%{transform:translate(18px,-72px) scale(1);opacity:0}}
@keyframes puffOnce4{0%{transform:translate(0,0) scale(.2);opacity:0}12%{opacity:.95}100%{transform:translate(62px,-48px) scale(1.08);opacity:0}}
@keyframes puffOnce5{0%{transform:translate(0,0) scale(.2);opacity:0}12%{opacity:.95}100%{transform:translate(74px,-8px) scale(.95);opacity:0}}
@keyframes puffOnce6{0%{transform:translate(0,0) scale(.2);opacity:0}12%{opacity:.95}100%{transform:translate(-72px,16px) scale(1);opacity:0}}
@keyframes puffOnce7{0%{transform:translate(0,0) scale(.2);opacity:0}12%{opacity:.95}100%{transform:translate(46px,38px) scale(1);opacity:0}}
@keyframes iconOnce{
  0%,24%{transform:scale(0) rotate(-14deg);opacity:0}
  42%{transform:scale(1.16) rotate(4deg);opacity:1}
  52%{transform:scale(.96) rotate(-1deg);opacity:1}
  62%,100%{transform:scale(1) rotate(0deg);opacity:1}
}
@keyframes coilOnce{
  0%,48%{stroke-dashoffset:680;opacity:0}
  52%{opacity:1}
  88%,100%{stroke-dashoffset:0;opacity:1}
}
@keyframes scratchOnce{
  0%,54%{stroke-dashoffset:360;opacity:0}
  58%{opacity:1}
  92%,100%{stroke-dashoffset:0;opacity:1}
}

.stage-loop .p1{animation:puffA1 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p2{animation:puffA2 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p3{animation:puffA3 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p4{animation:puffA4 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p5{animation:puffA5 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p6{animation:puffA6 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p7{animation:puffA7 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .u-icon{animation:iconPopA var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}
.stage-loop .s-coil{stroke-dasharray:680;animation:scribbleCoilA var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}
.stage-loop .s-scratch{stroke-dasharray:360;animation:scribbleScratchA var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}

.stage-once-a .p1,.stage-once-b .p1{animation:puffOnce1 .88s cubic-bezier(.215,.61,.355,1) forwards}
.stage-once-a .p2,.stage-once-b .p2{animation:puffOnce2 .94s cubic-bezier(.215,.61,.355,1) .03s forwards}
.stage-once-a .p3,.stage-once-b .p3{animation:puffOnce3 .86s cubic-bezier(.215,.61,.355,1) .05s forwards}
.stage-once-a .p4,.stage-once-b .p4{animation:puffOnce4 .98s cubic-bezier(.215,.61,.355,1) .02s forwards}
.stage-once-a .p5,.stage-once-b .p5{animation:puffOnce5 .92s cubic-bezier(.215,.61,.355,1) .06s forwards}
.stage-once-a .p6,.stage-once-b .p6{animation:puffOnce6 .96s cubic-bezier(.215,.61,.355,1) .04s forwards}
.stage-once-a .p7,.stage-once-b .p7{animation:puffOnce7 .90s cubic-bezier(.215,.61,.355,1) .07s forwards}
.stage-once-a .u-icon,.stage-once-b .u-icon{animation:iconOnce 1.4s cubic-bezier(.22,1,.36,1) forwards}
.stage-once-a .s-coil,.stage-once-b .s-coil{stroke-dasharray:680;animation:coilOnce 1.75s cubic-bezier(.22,1,.36,1) forwards}
.stage-once-a .s-scratch,.stage-once-b .s-scratch{stroke-dasharray:360;animation:scratchOnce 1.85s cubic-bezier(.22,1,.36,1) forwards}

/* 单步定格模式 */
.stage-step1 .p1{transform:translate(-38px,-28px) scale(.88);opacity:.9}
.stage-step1 .p2{transform:translate(-16px,-44px) scale(.95);opacity:.92}
.stage-step1 .p3{transform:translate(12px,-46px) scale(.86);opacity:.88}
.stage-step1 .p4{transform:translate(40px,-30px) scale(.92);opacity:.9}
.stage-step1 .p5{transform:translate(48px,-6px) scale(.82);opacity:.84}
.stage-step1 .p6{transform:translate(-44px,10px) scale(.86);opacity:.86}
.stage-step1 .p7{transform:translate(30px,24px) scale(.85);opacity:.86}
.stage-step1 .u-icon{transform:scale(0);opacity:0}
.stage-step1 .s-coil,.stage-step1 .s-scratch{opacity:0}

.stage-step2 .p1,.stage-step2 .p2,.stage-step2 .p3,.stage-step2 .p4,.stage-step2 .p5,.stage-step2 .p6,.stage-step2 .p7{opacity:0}
.stage-step2 .u-icon{transform:scale(1);opacity:1}
.stage-step2 .s-coil,.stage-step2 .s-scratch{opacity:0}

.stage-step3 .p1,.stage-step3 .p2,.stage-step3 .p3,.stage-step3 .p4,.stage-step3 .p5,.stage-step3 .p6,.stage-step3 .p7{opacity:0}
.stage-step3 .u-icon{transform:scale(1);opacity:1}
.stage-step3 .s-coil,.stage-step3 .s-scratch{stroke-dasharray:none;stroke-dashoffset:0;opacity:1}

/* ===== 鼠标悬停 Duo 双色动画（对标 Block 全局 Duo 图标：常态单色线稿 -> 悬停绽放 #c9d8f3 语义面 + #547dd0 强调蓝 + #20242c 主线） ===== */
.duo-btn{
  background:#ffffff;
  border:2px solid #dcdcdc;
  color:#52514e;
  transition:background-color .22s cubic-bezier(.22,1,.36,1),border-color .22s cubic-bezier(.22,1,.36,1),box-shadow .22s cubic-bezier(.22,1,.36,1),transform .22s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-fill-disc{
  fill:#c9d8f3;
  opacity:0;
  transform:scale(.45);
  transform-origin:12px 12px;
  transition:opacity .24s cubic-bezier(.22,1,.36,1),transform .28s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-fill-wing{
  fill:#c9d8f3;
  opacity:0;
  transform:translateY(-2px) scale(.6);
  transform-origin:12px 12.5px;
  transition:opacity .22s cubic-bezier(.22,1,.36,1),transform .26s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-line{
  stroke:#52514e;
  transition:stroke .2s ease,transform .26s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-accent{
  stroke:#52514e;
  transition:stroke .2s ease,transform .26s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-dot{
  background:#547dd0;
  transition:transform .24s cubic-bezier(.22,1,.36,1),background-color .2s ease,box-shadow .2s ease;
}

/* 鼠标移入或开启「悬停双色预览」时触发 Duo 双色动画 */
.duo-btn:hover,.force-duo .duo-btn{
  background:#eef3fc;
  border-color:#547dd0;
  box-shadow:0 10px 26px rgba(84,125,208,0.22);
}
.duo-btn:hover .duo-fill-disc,.force-duo .duo-btn .duo-fill-disc{
  opacity:1;
  transform:scale(1);
}
.duo-btn:hover .duo-fill-wing,.force-duo .duo-btn .duo-fill-wing{
  opacity:1;
  transform:translateY(1px) scale(1);
}
.duo-btn:hover .duo-line,.force-duo .duo-btn .duo-line{
  stroke:#1f1e1d;
  transform:translateY(1px);
}
.duo-btn:hover .duo-accent,.force-duo .duo-btn .duo-accent{
  stroke:#547dd0;
}
.duo-btn:hover .duo-dot,.force-duo .duo-btn .duo-dot{
  background:#2f5ec4;
  transform:scale(1.18);
  box-shadow:0 0 0 3px #c9d8f3;
}

.puff-fill{position:absolute;top:50%;left:50%;border-radius:50%;background:#c9d8f3;box-shadow:inset 0 0 0 1.5px #547dd0;pointer-events:none}
.puff-acc{position:absolute;top:50%;left:50%;border-radius:50%;background:rgba(84,125,208,0.26);box-shadow:inset 0 0 0 1.5px #20242c;pointer-events:none}
.ctrl-btn{height:32px;padding:0 12px;border-radius:8px;border:1px solid #d5dbe3;background:#ffffff;color:#20242c;font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:6px}
.ctrl-btn:hover{background:#eef3fc;border-color:#547dd0}
.ctrl-btn-active{height:32px;padding:0 12px;border-radius:8px;border:1px solid #476ec2;background:#e5edfc;color:#1d3f8a;font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
</style>
</helmet>

<div class="{{hoverWrapClass}}" style="width:840px;height:680px;box-sizing:border-box;padding:22px 26px;background:#f4f5f7;font-family:-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;color:#20242c;display:flex;flex-direction:column;gap:14px;{{durVar}}">

  <!-- 顶部标题与交互控制栏 -->
  <header style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
    <h1 style="margin:0;font-size:18px;line-height:26px;font-weight:600;color:#20242c">方案 A · 气泡簇拥 + 图标弹入 + 狂草绕圈线（悬停 Duo 双色）</h1>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <button type="button" class="ctrl-btn-active" onClick="{{triggerOnce}}">单次重播</button>
      <button type="button" class="{{loopBtnClass}}" onClick="{{setLoopMode}}">循环演示</button>
      <button type="button" class="{{duoBtnClass}}" onClick="{{toggleDuoHover}}">{{duoBtnLabel}}</button>
      <button type="button" class="{{slowBtnClass}}" onClick="{{toggleSlow}}">{{slowLabel}}</button>
    </div>
  </header>

  <!-- 三步拆解可交互切换条 -->
  <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px">
    <button type="button" onClick="{{showStep1}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step1Bd}};background:{{step1Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">1. 气泡动画先出来</span>
      <span style="font-size:14px;color:#526071">浅蓝 #c9d8f3 与强调蓝双色气泡散开</span>
    </button>
    <button type="button" onClick="{{showStep2}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step2Bd}};background:{{step2Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">2. 显现图标（悬停变双色）</span>
      <span style="font-size:14px;color:#526071">常态单色线稿，鼠标移入绽放双色填充</span>
    </button>
    <button type="button" onClick="{{showStep3}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step3Bd}};background:{{step3Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">3. 接着乱糟糟线条动画</span>
      <span style="font-size:14px;color:#526071">浅蓝衬底面 + 强调蓝双色狂草绕圈线</span>
    </button>
  </div>

  <!-- 中央 3 倍放大交互特写舞台（把鼠标移到中央图标或右下 1:1 图标上即可看到 Duo 双色动画！） -->
  <div class="{{stageClass}}" style="flex:1;min-height:0;border-radius:14px;background:#ffffff;border:1px solid #e4e6ea;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden">

    <!-- 左上角：常态单色 vs 鼠标悬停双色 Duo 实时对照说明 -->
    <div style="position:absolute;top:14px;left:16px;display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;background:#f8f9fb;border:1px solid #e4e6ea">
      <div style="display:flex;align-items:center;gap:6px">
        <span style="width:14px;height:14px;border-radius:4px;border:1.5px solid #52514e;display:inline-block"></span>
        <span style="font-size:14px;color:#526071">常态：单色线稿</span>
      </div>
      <span style="font-size:14px;color:#9aa5b4">→</span>
      <div style="display:flex;align-items:center;gap:6px">
        <span style="width:14px;height:14px;border-radius:4px;background:#c9d8f3;border:1.5px solid #20242c;box-shadow:inset 0 -3px 0 #547dd0;display:inline-block"></span>
        <span style="font-size:14px;font-weight:500;color:#20242c">鼠标移上去：#c9d8f3 语义面 + #547dd0 双色动效</span>
      </div>
    </div>

    <div style="position:relative;width:240px;height:190px;display:flex;align-items:center;justify-content:center;margin-top:-12px">
      <!-- 第 1 步：7 颗 Duo 双色气泡（#c9d8f3 语义填充泡 + #547dd0 描边泡） -->
      <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none">
        <span class="puff-fill p1" style="width:28px;height:28px;margin-left:-14px;margin-top:-14px"></span>
        <span class="puff-acc p2" style="width:42px;height:42px;margin-left:-21px;margin-top:-21px"></span>
        <span class="puff-fill p3" style="width:24px;height:24px;margin-left:-12px;margin-top:-12px"></span>
        <span class="puff-acc p4" style="width:36px;height:36px;margin-left:-18px;margin-top:-18px"></span>
        <span class="puff-fill p5" style="width:22px;height:22px;margin-left:-11px;margin-top:-11px"></span>
        <span class="puff-acc p6" style="width:32px;height:32px;margin-left:-16px;margin-top:-16px"></span>
        <span class="puff-fill p7" style="width:26px;height:26px;margin-left:-13px;margin-top:-13px"></span>
      </div>

      <!-- 第 3 步：双色乱糟糟手绘狂草绕圈线条（底层 #c9d8f3 浅蓝语义粗笔触 + 上层 #547dd0 / #20242c 狂草细线） -->
      <svg width="220" height="190" viewBox="0 0 220 190" fill="none" aria-hidden="true" style="position:absolute;left:10px;top:0;pointer-events:none;overflow:visible">
        <path class="s-coil" d="M 62 52 C 98 22, 168 30, 174 86 C 180 142, 118 168, 66 146 C 18 124, 26 56, 86 38 C 146 20, 192 66, 166 124 C 140 176, 52 162, 42 104" stroke="#c9d8f3" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <path class="s-coil" d="M 62 52 C 98 22, 168 30, 174 86 C 180 142, 118 168, 66 146 C 18 124, 26 56, 86 38 C 146 20, 192 66, 166 124 C 140 176, 52 162, 42 104 C 32 48, 114 18, 162 58 C 194 86, 168 148, 112 154" stroke="#547dd0" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
        <path class="s-scratch" d="M 46 68 Q 22 44 58 32 T 96 24 M 156 144 Q 188 158 176 124 T 194 96 M 38 128 L 22 142 L 48 152 L 32 164" stroke="#20242c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>

      <!-- 第 2 步：支持鼠标悬停双色动画的更新图标本体（移入鼠标即刻绽放 #c9d8f3 语义面 + #547dd0 强调蓝） -->
      <button type="button" onClick="{{triggerOnce}}" class="u-icon duo-btn" style="width:78px;height:78px;border-radius:18px;display:flex;align-items:center;justify-content:center;position:relative;padding:0">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <!-- Duo 语义填充面层（悬停时从中心绽放 #c9d8f3） -->
          <circle class="duo-fill-disc" cx="12" cy="12" r="8.5"></circle>
          <path class="duo-fill-wing" d="M7.5 10.5L12 15L16.5 10.5Z"></path>
          <!-- Duo 主描边层（常态 #52514e -> 悬停 #1f1e1d 并微沉 1px） -->
          <g class="duo-line" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4.5V15"></path>
            <path d="M7.5 10.5L12 15L16.5 10.5"></path>
          </g>
          <!-- Duo 动作强调层（底部托盘线：常态 #52514e -> 悬停强调蓝 #547dd0） -->
          <path class="duo-accent" d="M5.5 19.5H18.5" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span class="duo-dot" aria-hidden="true" style="position:absolute;top:8px;right:8px;width:11px;height:11px;border-radius:6px"></span>
      </button>
    </div>

    <!-- 底部 1:1 真实侧栏底栏尺寸同步预览（鼠标移到 1:1 图标上同样有双色 Duo 动画） -->
    <div style="position:absolute;bottom:14px;left:20px;right:20px;display:flex;align-items:center;justify-content:space-between;padding:10px 16px;background:#fafafa;border:1px solid #e4e6ea;border-radius:10px">
      <span style="font-size:14px;color:#526071">请把鼠标移到中央大图标或右侧 1:1 底栏图标上，体验 Duo 双色悬停动效</span>
      <div style="width:236px;padding:6px 8px;background:#ffffff;border:1px solid #e4e6ea;border-radius:8px;display:flex;align-items:center;gap:6px">
        <span style="flex:1;font-size:14px;font-weight:500;color:#20242c;padding-left:4px">本地笔记</span>
        <div style="position:relative;width:30px;height:30px;display:flex;align-items:center;justify-content:center">
          <svg width="56" height="50" viewBox="0 0 220 190" fill="none" aria-hidden="true" style="position:absolute;left:-13px;top:-10px;pointer-events:none">
            <path class="s-coil" d="M 62 52 C 98 22, 168 30, 174 86 C 180 142, 118 168, 66 146 C 18 124, 26 56, 86 38" stroke="#c9d8f3" stroke-width="10" stroke-linecap="round"></path>
