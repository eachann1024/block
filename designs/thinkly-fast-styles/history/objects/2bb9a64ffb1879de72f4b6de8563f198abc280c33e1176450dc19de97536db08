<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>自定义字体 · 方案 B 字样卡片画廊</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..600&amp;family=JetBrains+Mono:wght@400;500&amp;family=Noto+Sans+SC:wght@400;500;600&amp;family=Noto+Serif+SC:wght@400;600&amp;family=LXGW+WenKai+TC:wght@400;700&amp;family=Source+Serif+4:opsz,wght@8..60,400;600&amp;family=Fira+Code:wght@400;500&amp;family=IBM+Plex+Mono:wght@400;500&amp;family=Lora:wght@400;600&amp;display=swap">
<style>
body{margin:0}
a{color:#547dd0}a:hover{color:#3d63b0}
button,input{font-family:inherit}
.row{font:inherit;font-size:14px;line-height:20px;width:100%;height:34px;display:flex;align-items:center;gap:8px;padding:0 10px;border:0;border-radius:6px;background:transparent;text-align:left;cursor:pointer;box-sizing:border-box;transition:background-color 140ms ease-out}
.row:hover{background:var(--hover)}
.seg{font:inherit;font-size:14px;line-height:20px;font-weight:460;height:32px;padding:0 14px;border:0;border-radius:6px;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;white-space:nowrap;transition:background-color 180ms cubic-bezier(.16,1,.3,1),box-shadow 180ms cubic-bezier(.16,1,.3,1),color 180ms ease-out}
.spec{font:inherit;position:relative;height:112px;padding:14px 14px 12px;border-radius:10px;cursor:pointer;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;text-align:left;box-sizing:border-box;transition:background-color 160ms ease-out,box-shadow 200ms cubic-bezier(.16,1,.3,1),border-color 200ms ease-out,transform 160ms cubic-bezier(.16,1,.3,1),opacity 260ms cubic-bezier(.16,1,.3,1)}
.spec:hover{background:var(--hover)}
.spec:active{transform:scale(.98)}
.add{font:inherit;height:112px;border-radius:10px;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;box-sizing:border-box;transition:background-color 160ms ease-out,border-color 160ms ease-out,transform 160ms cubic-bezier(.16,1,.3,1)}
.add:hover{background:var(--hover)}
.add:active{transform:scale(.98)}
.range{width:220px;accent-color:var(--accent);cursor:pointer}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</helmet>
<div style="width:100%;min-height:900px;box-sizing:border-box;display:flex;flex-direction:column;background:{{shellBg}};font-family:Inter,-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;color:{{textPrimary}};font-size:14px;line-height:20px;-webkit-font-smoothing:antialiased;--hover:{{hoverBg}};--accent:{{accent}};transition:background-color 200ms ease-out,color 200ms ease-out">

<header style="height:40px;flex:none;display:flex;align-items:center;border-bottom:1px solid {{sidebarBorder}};box-sizing:border-box">
<div style="width:260px;flex:none;height:100%;box-sizing:border-box;display:flex;align-items:center;padding:0 16px;border-right:1px solid {{sidebarBorder}}">
<div aria-hidden="true" style="display:flex;gap:8px"><span style="width:12px;height:12px;border-radius:6px;background:#ff5f57"></span><span style="width:12px;height:12px;border-radius:6px;background:#febc2e"></span><span style="width:12px;height:12px;border-radius:6px;background:#28c840"></span></div>
</div>
<div style="flex:1;min-width:0;display:flex;align-items:center;gap:6px;padding:0 16px;color:{{textSecondary}}">
<span>设置</span><span>/</span><span style="color:{{textPrimary}};font-weight:460">外观与字体</span>
</div>
</header>

<div style="flex:1;min-height:0;display:flex">

<aside aria-label="设置分类导航" style="width:260px;flex:none;background:{{sidebarBg}};border-right:1px solid {{sidebarBorder}};box-sizing:border-box;display:flex;flex-direction:column">
<div style="padding:18px 16px 10px"><span style="font-size:18px;line-height:24px;font-weight:560">设置</span></div>
<nav aria-label="设置分类" style="padding:4px 10px;display:flex;flex-direction:column;gap:4px">
<button type="button" class="row" style="color:{{textSecondary}}">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none"><path d="M12 3.5L14.2 9.3L20 11.5L14.2 13.7L12 19.5L9.8 13.7L4 11.5L9.8 9.3L12 3.5Z" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M18.5 4V7M17 5.5H20" stroke="{{accent}}" stroke-width="1.6" stroke-linecap="round"></path></svg>
<span>AI 助手</span>
</button>
<button type="button" class="row" aria-current="page" style="background:{{selectedBg}};color:{{textPrimary}};box-shadow:inset 0 0 0 1px {{accent}};font-weight:460">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none"><rect x="3.5" y="4.5" width="17" height="12" rx="2" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 20H16M12 16.5V20" stroke="{{accent}}" stroke-width="1.6" stroke-linecap="round"></path></svg>
<span>外观与字体</span>
</button>
<button type="button" class="row" style="color:{{textSecondary}}">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><circle cx="9" cy="7" r="2" fill="{{iconFill}}" stroke="{{accent}}" stroke-width="1.5"></circle><circle cx="15" cy="12" r="2" fill="{{iconFill}}" stroke="{{accent}}" stroke-width="1.5"></circle><circle cx="10" cy="17" r="2" fill="{{iconFill}}" stroke="{{accent}}" stroke-width="1.5"></circle></svg>
<span>通用与编辑</span>
</button>
<button type="button" class="row" style="color:{{textSecondary}}">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none"><rect x="3.25" y="5.75" width="17.5" height="12.5" rx="2" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5"></rect><path d="M7 10H8.5M11.25 10H12.75M15.5 10H17M7.5 14H16.5" stroke="{{accent}}" stroke-width="1.6" stroke-linecap="round"></path></svg>
<span>基础快捷键</span>
</button>
</nav>
</aside>

<main style="flex:1;min-width:0;background:{{settingsBg}};overflow:auto;transition:background-color 200ms ease-out">
<div style="max-width:720px;margin:0 auto;padding:40px 28px 64px;display:flex;flex-direction:column;gap:24px">
<div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
<h1 style="margin:0;font-size:24px;line-height:32px;font-weight:560">外观与字体</h1>
<div role="group" aria-label="外观主题" style="display:flex;gap:2px;padding:3px;background:{{shellBg}};border:1px solid {{borderCol}};border-radius:8px">
<sc-for list="{{themeSegs}}" as="s" hint-placeholder-count="2">
<button type="button" class="seg" aria-pressed="{{s.on}}" onClick="{{s.pick}}" style="background:{{s.bg}};color:{{s.col}};box-shadow:{{s.ring}}">{{s.label}}</button>
</sc-for>
</div>
</div>

<section style="background:{{cardBg}};border:1px solid {{borderCol}};border-radius:14px;padding:18px 20px 20px;display:flex;flex-direction:column;gap:16px;transition:background-color 200ms ease-out,border-color 200ms ease-out">
<div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
<h2 style="margin:0;font-size:15px;line-height:22px;font-weight:560">字体</h2>
<div role="tablist" aria-label="字体用途" style="display:flex;gap:2px;padding:3px;background:{{shellBg}};border:1px solid {{borderCol}};border-radius:8px">
<sc-for list="{{roleTabs}}" as="rt" hint-placeholder-count="3">
<button type="button" role="tab" class="seg" aria-selected="{{rt.on}}" onClick="{{rt.pick}}" style="background:{{rt.bg}};color:{{rt.col}};box-shadow:{{rt.ring}};gap:8px">
<span>{{rt.label}}</span>
<span style="font-family:{{rt.fam}};color:{{textSecondary}};font-weight:400">{{rt.fontName}}</span>
</button>
</sc-for>
</div>
</div>

<div role="radiogroup" aria-label="{{roleLabel}}字体" style="display:grid;grid-template-columns:repeat(3, minmax(0, 1fr));gap:10px;opacity:{{gridOpacity}};transform:{{gridTransform}};transition:opacity 160ms cubic-bezier(.16,1,.3,1),transform 200ms cubic-bezier(.16,1,.3,1)">
<sc-for list="{{cards}}" as="c" hint-placeholder-count="6">
<button type="button" class="spec" role="radio" aria-checked="{{c.on}}" onClick="{{c.pick}}" style="background:{{c.bg}};border:1px solid {{c.border}};box-shadow:{{c.ring}};color:{{textPrimary}};opacity:{{c.opacity}};transform:{{c.transform}}">
<span style="font-family:{{c.fam}};font-size:30px;line-height:36px;font-weight:400;color:{{editorText}}">{{c.sample}}</span>
<span style="display:flex;align-items:center;justify-content:space-between;width:100%;gap:8px">
<span style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:460">{{c.name}}</span>
<span style="color:{{textSecondary}};flex:none">{{c.meta}}</span>
</span>
<span aria-hidden="true" style="position:absolute;top:10px;right:10px;width:18px;height:18px;border-radius:9px;background:{{accent}};display:flex;align-items:center;justify-content:center;opacity:{{c.check}};transform:scale({{c.checkScale}});transition:opacity 160ms ease-out,transform 220ms cubic-bezier(.34,1.56,.64,1)">
<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
</span>
</button>
</sc-for>

<sc-if value="{{showAdd}}" hint-placeholder-val="{{true}}">
<button type="button" class="add" onClick="{{startImport}}" style="background:transparent;border:1px dashed {{btnBorder}};color:{{textSecondary}}">
<sc-if value="{{idle}}" hint-placeholder-val="{{true}}">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4.75h8l4.25 4.25v10.25H6Z" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path><path d="M12 11v5M9.5 13.5h5" stroke="{{accent}}" stroke-width="1.6" stroke-linecap="round"></path></svg>
<span style="color:{{textPrimary}};font-weight:460">添加字体</span>
<span>拖入 .ttf / .otf</span>
</sc-if>
<sc-if value="{{importing}}" hint-placeholder-val="{{false}}">
<span style="color:{{textPrimary}}">Lora-Regular.ttf</span>
<span style="width:70%;height:3px;border-radius:2px;background:{{shellBg}};overflow:hidden;display:block"><span style="display:block;height:100%;width:{{progress}}%;background:{{accent}};border-radius:2px;transition:width 900ms cubic-bezier(.22,1,.36,1)"></span></span>
</sc-if>
</button>
</sc-if>
</div>

<div style="height:1px;background:{{borderCol}}"></div>

<div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
<label for="v2-size">字号</label>
<div style="display:flex;align-items:center;gap:12px">
<input id="v2-size" class="range" type="range" min="13" max="22" step="1" value="{{size}}" onChange="{{onSize}}">
<span style="width:44px;text-align:right;font-variant-numeric:tabular-nums;font-weight:460">{{size}} px</span>
</div>
</div>
<div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
<span>行距</span>
<div role="group" aria-label="行距" style="display:flex;gap:2px;padding:3px;background:{{shellBg}};border:1px solid {{borderCol}};border-radius:8px">
<sc-for list="{{lhSegs}}" as="s" hint-placeholder-count="3">
<button type="button" class="seg" aria-pressed="{{s.on}}" onClick="{{s.pick}}" style="background:{{s.bg}};color:{{s.col}};box-shadow:{{s.ring}}">{{s.label}}</button>
</sc-for>
</div>
</div>
</section>

<section aria-label="预览" style="background:{{paperBg}};border:1px solid {{borderCol}};border-radius:14px;padding:28px 36px 30px;display:flex;flex-direction:column;gap:10px;transition:background-color 200ms ease-out">
<h3 style="margin:0 -8px;padding:2px 8px;border-radius:6px;background:{{hlHeading}};font-family:{{headingFam}};font-size:{{headingSize}}px;line-height:1.35;font-weight:600;color:{{editorText}};transition:background-color 240ms ease-out,font-size 200ms cubic-bezier(.16,1,.3,1)">关于慢读</h3>
<p style="margin:0 -8px;padding:2px 8px;border-radius:6px;background:{{hlBody}};font-family:{{bodyFam}};font-size:{{size}}px;line-height:{{lh}};color:{{editorText}};transition:background-color 240ms ease-out,font-size 200ms cubic-bezier(.16,1,.3,1),line-height 200ms cubic-bezier(.16,1,.3,1)">读一本书，最好的速度是能听见自己思考的速度。把打动你的句子抄下来，再用自己的话复述一遍——Reading slowly is a way of writing.</p>
<pre style="margin:4px 0 0;padding:10px 14px;border-radius:8px;background:{{codeBox}};font-family:{{codeFam}};font-size:{{codeSize}}px;line-height:1.6;color:{{editorText}};overflow:auto;transition:background-color 240ms ease-out,font-size 200ms cubic-bezier(.16,1,.3,1)">let words = note.split_whitespace().count();</pre>
</section>
</div>
</main>
</div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"theme":{"editor":"enum","options":["light","dark"],"default":"light"},"$preview":{"width":1440,"height":900}}'>
class Component extends DCLogic {
  constructor(p) {
    super(p);
    this.state = { dark: null, role: 'body', shownRole: 'body', switching: false, fonts: { body: 'notoserif', heading: 'follow', code: 'jetbrains' }, imported: false, importing: false, progress: 0, entering: false, size: 16, lh: 'normal' };
  }

  catalog() {
    const list = [
      { id: 'system', name: '系统默认', fam: "-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif", grp: 'text', sample: '永 Aa', meta: '苹方' },
      { id: 'notosans', name: '思源黑体', fam: "'Noto Sans SC',sans-serif", grp: 'text', sample: '永 Aa', meta: '黑体' },
      { id: 'notoserif', name: '思源宋体', fam: "'Noto Serif SC',serif", grp: 'text', sample: '永 Aa', meta: '宋体' },
      { id: 'wenkai', name: '霞鹜文楷', fam: "'LXGW WenKai TC','Noto Serif SC',serif", grp: 'text', sample: '永 Aa', meta: '楷体' },
      { id: 'inter', name: 'Inter', fam: "Inter,'PingFang SC',sans-serif", grp: 'text', sample: 'Aa Rg', meta: '西文' },
      { id: 'sourceserif', name: 'Source Serif 4', fam: "'Source Serif 4','Noto Serif SC',serif", grp: 'text', sample: 'Aa Rg', meta: '西文' },
      { id: 'jetbrains', name: 'JetBrains Mono', fam: "'JetBrains Mono',ui-monospace,monospace", grp: 'mono', sample: '{ } =>', meta: '等宽' },
      { id: 'fira', name: 'Fira Code', fam: "'Fira Code',ui-monospace,monospace", grp: 'mono', sample: '{ } =>', meta: '等宽' },
      { id: 'plex', name: 'IBM Plex Mono', fam: "'IBM Plex Mono',ui-monospace,monospace", grp: 'mono', sample: '{ } =>', meta: '等宽' }
    ];
    if (this.state.imported) list.push({ id: 'lora', name: 'Lora', fam: "Lora,'Noto Serif SC',serif", grp: 'any', sample: 'Aa Rg', meta: '已导入' });
    return list;
  }

  switchRole(role) {
    if (role === this.state.role) return;
    this.setState({ role, switching: true });
    clearTimeout(this._sw);
    this._sw = setTimeout(() => this.setState({ shownRole: role, switching: false }), 130);
  }

  startImport() {
    if (this.state.importing || this.state.imported) return;
    this.setState({ importing: true, progress: 0 });
    setTimeout(() => this.setState({ progress: 100 }), 30);
    setTimeout(() => {
      this.setState((s) => ({ importing: false, imported: true, entering: true, fonts: { ...s.fonts, [s.shownRole]: 'lora' } }));
      setTimeout(() => this.setState({ entering: false }), 30);
    }, 1000);
  }

  componentWillUnmount() { clearTimeout(this._sw); }

  renderVals() {
    const st = this.state;
    const dark = st.dark ?? ((this.props.theme ?? 'light') === 'dark');
    const t = {
      shellBg: dark ? '#343434' : '#f1f1f1', sidebarBg: dark ? '#222222' : '#fafafa', settingsBg: dark ? '#181818' : '#f8f8f8',
      cardBg: dark ? '#222222' : '#ffffff', paperBg: dark ? '#181818' : '#ffffff',
      textPrimary: dark ? '#ececec' : '#20242c', textSecondary: dark ? '#b4b4b4' : '#526071', editorText: dark ? '#ececec' : '#1f1e1d',
      accent: dark ? '#779de8' : '#547dd0', iconFill: dark ? '#31456a' : '#c9d8f3', selectedBg: dark ? '#343434' : '#e5edfc',
      hoverBg: dark ? '#2c2c2c' : '#eef3fc', borderCol: dark ? '#2e2e2e' : '#e4e6ea', sidebarBorder: dark ? '#333333' : '#e6e6e6',
      btnBorder: dark ? '#444444' : '#dcdcdc', codeBg: dark ? '#242424' : '#f3f1ec'
    };
    const ring = 'inset 0 0 0 1px ' + t.accent;
    const all = this.catalog();
    const byId = (id) => all.find((f) => f.id === id) || all[0];
    const bodyF = byId(st.fonts.body);
    const fontOf = (role) => (role === 'heading' && st.fonts.heading === 'follow' ? { name: '跟随正文', fam: bodyF.fam } : byId(st.fonts[role]));
    const labels = { body: '正文', heading: '标题', code: '代码' };
    const roleTabs = ['body', 'heading', 'code'].map((k) => {
      const on = st.role === k; const f = fontOf(k);
      return { label: labels[k], on, fontName: f.name, fam: f.fam, pick: () => this.switchRole(k), bg: on ? t.selectedBg : 'transparent', col: on ? t.textPrimary : t.textSecondary, ring: on ? ring : 'none' };
    });
    const role = st.shownRole;
    const cur = st.fonts[role];
    let pool = all.filter((f) => f.grp === 'any' || (role === 'code' ? f.grp === 'mono' : f.grp === 'text'));
    if (role === 'heading') pool = [{ id: 'follow', name: '跟随正文', fam: bodyF.fam, sample: '永 Aa', meta: bodyF.name }].concat(pool);
    const cards = pool.map((f) => {
      const on = cur === f.id; const fresh = f.id === 'lora' && st.entering;
      return {
        name: f.name, fam: f.fam, sample: f.sample, meta: f.meta, on,
        bg: on ? t.selectedBg : 'transparent', border: on ? t.accent : t.borderCol, ring: on ? ring : 'none',
        check: on ? 1 : 0, checkScale: on ? 1 : 0.6,
        opacity: fresh ? 0 : 1, transform: fresh ? 'scale(0.94)' : 'none',
        pick: () => this.setState((s) => ({ fonts: { ...s.fonts, [role]: f.id } }))
      };
    });
    const mode = dark ? 'dark' : 'light';
    const seg = (on) => ({ bg: on ? t.selectedBg : 'transparent', col: on ? t.textPrimary : t.textSecondary, ring: on ? ring : 'none' });
    const themeSegs = [['light', '浅色'], ['dark', '深色']].map(([k, label]) => ({ label, on: mode === k, pick: () => this.setState({ dark: k === 'dark' }), ...seg(mode === k) }));
    const lhMap = { tight: 1.55, normal: 1.75, loose: 2 };
    const lhSegs = [['tight', '紧凑'], ['normal', '标准'], ['loose', '宽松']].map(([k, label]) => ({ label, on: st.lh === k, pick: () => this.setState({ lh: k }), ...seg(st.lh === k) }));
    const hl = (r) => (st.role === r ? t.selectedBg : 'transparent');
    return {
      ...t, roleTabs, cards, themeSegs, lhSegs, roleLabel: labels[st.role],
      gridOpacity: st.switching ? 0 : 1, gridTransform: st.switching ? 'translateY(4px)' : 'none',
      showAdd: !st.imported, idle: !st.importing, importing: st.importing, progress: st.progress, startImport: () => this.startImport(),
      size: st.size, onSize: (e) => this.setState({ size: Number(e.target.value) }), lh: lhMap[st.lh],
      headingSize: Math.round(st.size * 1.5), codeSize: st.size - 2,
      bodyFam: bodyF.fam, headingFam: fontOf('heading').fam, codeFam: byId(st.fonts.code).fam,
      hlHeading: hl('heading'), hlBody: hl('body'), codeBox: st.role === 'code' ? t.selectedBg : t.codeBg
    };
  }
}
</script>
</body>
</html>
