<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>更新图标动效 B · 气泡涌出 + 图标落位 + 涂鸦折返乱线团（含悬停双色 Duo 动效）</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<style>
body{margin:0}
button{font-family:inherit;cursor:pointer}

/* ===== 方案 B：1. 双色气泡向上喷涌 -> 2. 图标跳跃落位 -> 3. 四角双色折返涂鸦毛线团炸裂 ===== */
@keyframes puffB1{
  0%{transform:translate(0,12px) scale(.18);opacity:0}
  6%{opacity:.95}
  26%{transform:translate(-58px,-54px) scale(1.06);opacity:0}
  100%{transform:translate(-58px,-54px) scale(1.06);opacity:0}
}
@keyframes puffB2{
  0%,2%{transform:translate(0,12px) scale(.18);opacity:0}
  7%{opacity:.95}
  28%{transform:translate(-22px,-76px) scale(1.12);opacity:0}
  100%{transform:translate(-22px,-76px) scale(1.12);opacity:0}
}
@keyframes puffB3{
  0%,3%{transform:translate(0,12px) scale(.18);opacity:0}
  8%{opacity:.95}
  27%{transform:translate(24px,-74px) scale(1.02);opacity:0}
  100%{transform:translate(24px,-74px) scale(1.02);opacity:0}
}
@keyframes puffB4{
  0%,1%{transform:translate(0,12px) scale(.18);opacity:0}
  6%{opacity:.95}
  29%{transform:translate(64px,-46px) scale(1.08);opacity:0}
  100%{transform:translate(64px,-46px) scale(1.08);opacity:0}
}
@keyframes puffB5{
  0%,4%{transform:translate(0,12px) scale(.18);opacity:0}
  9%{opacity:.95}
  30%{transform:translate(-70px,-10px) scale(.96);opacity:0}
  100%{transform:translate(-70px,-10px) scale(.96);opacity:0}
}
@keyframes puffB6{
  0%,2%{transform:translate(0,12px) scale(.18);opacity:0}
  7%{opacity:.95}
  28%{transform:translate(72px,4px) scale(.98);opacity:0}
  100%{transform:translate(72px,4px) scale(.98);opacity:0}
}
@keyframes puffB7{
  0%,5%{transform:translate(0,12px) scale(.18);opacity:0}
  10%{opacity:.95}
  31%{transform:translate(0px,-88px) scale(.9);opacity:0}
  100%{transform:translate(0px,-88px) scale(.9);opacity:0}
}

/* 第 2 步：气泡涌出后，图标上跃回弹显示 */
@keyframes iconJumpB{
  0%,18%{transform:translateY(18px) scale(0);opacity:0}
  27%{transform:translateY(-8px) scale(1.12);opacity:1}
  33%{transform:translateY(2px) scale(.97);opacity:1}
  38%,90%{transform:translateY(0) scale(1);opacity:1}
  96%,100%{transform:translateY(10px) scale(0);opacity:0}
}

/* 第 3 步：图标显示后，头顶与四周炸出双色折返乱涂毛线团 */
@keyframes tangleDrawB{
  0%,36%{stroke-dashoffset:520;opacity:0}
  39%{opacity:1}
  66%{stroke-dashoffset:0;opacity:1}
  84%{stroke-dashoffset:0;opacity:.92}
  95%,100%{stroke-dashoffset:-520;opacity:0}
}
@keyframes zigDrawB{
  0%,41%{stroke-dashoffset:320;opacity:0}
  44%{opacity:1}
  72%{stroke-dashoffset:0;opacity:1}
  86%{stroke-dashoffset:0;opacity:.88}
  96%,100%{stroke-dashoffset:-320;opacity:0}
}

/* 单次触发重播组 */
@keyframes puffOnceB1{0%{transform:translate(0,12px) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(-58px,-54px) scale(1.06);opacity:0}}
@keyframes puffOnceB2{0%{transform:translate(0,12px) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(-22px,-76px) scale(1.12);opacity:0}}
@keyframes puffOnceB3{0%{transform:translate(0,12px) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(24px,-74px) scale(1.02);opacity:0}}
@keyframes puffOnceB4{0%{transform:translate(0,12px) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(64px,-46px) scale(1.08);opacity:0}}
@keyframes puffOnceB5{0%{transform:translate(0,12px) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(-70px,-10px) scale(.96);opacity:0}}
@keyframes puffOnceB6{0%{transform:translate(0,12px) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(72px,4px) scale(.98);opacity:0}}
@keyframes puffOnceB7{0%{transform:translate(0,12px) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(0px,-88px) scale(.9);opacity:0}}
@keyframes iconOnceB{
  0%,25%{transform:translateY(18px) scale(0);opacity:0}
  44%{transform:translateY(-8px) scale(1.12);opacity:1}
  56%{transform:translateY(2px) scale(.97);opacity:1}
  66%,100%{transform:translateY(0) scale(1);opacity:1}
}
@keyframes tangleOnceB{
  0%,50%{stroke-dashoffset:520;opacity:0}
  54%{opacity:1}
  90%,100%{stroke-dashoffset:0;opacity:1}
}
@keyframes zigOnceB{
  0%,56%{stroke-dashoffset:320;opacity:0}
  60%{opacity:1}
  94%,100%{stroke-dashoffset:0;opacity:1}
}

.stage-loop .p1{animation:puffB1 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p2{animation:puffB2 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p3{animation:puffB3 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p4{animation:puffB4 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p5{animation:puffB5 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p6{animation:puffB6 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p7{animation:puffB7 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .u-icon{animation:iconJumpB var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}
.stage-loop .s-tangle{stroke-dasharray:520;animation:tangleDrawB var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}
.stage-loop .s-zig{stroke-dasharray:320;animation:zigDrawB var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}

.stage-once-a .p1,.stage-once-b .p1{animation:puffOnceB1 .88s cubic-bezier(.215,.61,.355,1) forwards}
.stage-once-a .p2,.stage-once-b .p2{animation:puffOnceB2 .94s cubic-bezier(.215,.61,.355,1) .03s forwards}
.stage-once-a .p3,.stage-once-b .p3{animation:puffOnceB3 .86s cubic-bezier(.215,.61,.355,1) .05s forwards}
.stage-once-a .p4,.stage-once-b .p4{animation:puffOnceB4 .98s cubic-bezier(.215,.61,.355,1) .02s forwards}
.stage-once-a .p5,.stage-once-b .p5{animation:puffOnceB5 .92s cubic-bezier(.215,.61,.355,1) .06s forwards}
.stage-once-a .p6,.stage-once-b .p6{animation:puffOnceB6 .96s cubic-bezier(.215,.61,.355,1) .04s forwards}
.stage-once-a .p7,.stage-once-b .p7{animation:puffOnceB7 .90s cubic-bezier(.215,.61,.355,1) .07s forwards}
.stage-once-a .u-icon,.stage-once-b .u-icon{animation:iconOnceB 1.4s cubic-bezier(.22,1,.36,1) forwards}
.stage-once-a .s-tangle,.stage-once-b .s-tangle{stroke-dasharray:520;animation:tangleOnceB 1.75s cubic-bezier(.22,1,.36,1) forwards}
.stage-once-a .s-zig,.stage-once-b .s-zig{stroke-dasharray:320;animation:zigOnceB 1.88s cubic-bezier(.22,1,.36,1) forwards}

/* 单步定格模式 */
.stage-step1 .p1{transform:translate(-36px,-34px) scale(.88);opacity:.9}
.stage-step1 .p2{transform:translate(-14px,-50px) scale(.96);opacity:.92}
.stage-step1 .p3{transform:translate(16px,-48px) scale(.88);opacity:.9}
.stage-step1 .p4{transform:translate(42px,-30px) scale(.92);opacity:.9}
.stage-step1 .p5{transform:translate(-46px,-6px) scale(.84);opacity:.85}
.stage-step1 .p6{transform:translate(48px,4px) scale(.86);opacity:.86}
.stage-step1 .p7{transform:translate(0px,-58px) scale(.82);opacity:.86}
.stage-step1 .u-icon{transform:scale(0);opacity:0}
.stage-step1 .s-tangle,.stage-step1 .s-zig{opacity:0}

.stage-step2 .p1,.stage-step2 .p2,.stage-step2 .p3,.stage-step2 .p4,.stage-step2 .p5,.stage-step2 .p6,.stage-step2 .p7{opacity:0}
.stage-step2 .u-icon{transform:scale(1);opacity:1}
.stage-step2 .s-tangle,.stage-step2 .s-zig{opacity:0}

.stage-step3 .p1,.stage-step3 .p2,.stage-step3 .p3,.stage-step3 .p4,.stage-step3 .p5,.stage-step3 .p6,.stage-step3 .p7{opacity:0}
.stage-step3 .u-icon{transform:scale(1);opacity:1}
.stage-step3 .s-tangle,.stage-step3 .s-zig{stroke-dasharray:none;stroke-dashoffset:0;opacity:1}

/* ===== 鼠标悬停 Duo 双色动画 ===== */
.duo-btn{
  background:#ffffff;
  border:2px solid #dcdcdc;
  color:#52514e;
  transition:background-color .22s cubic-bezier(.22,1,.36,1),border-color .22s cubic-bezier(.22,1,.36,1),box-shadow .22s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-fill-tray{
  fill:#c9d8f3;
  opacity:0;
  transform:scaleX(.4);
  transform-origin:12px 17px;
  transition:opacity .22s cubic-bezier(.22,1,.36,1),transform .26s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-fill-wing{
  fill:#c9d8f3;
  opacity:0;
  transform:translateY(-3px) scale(.55);
  transform-origin:12px 12px;
  transition:opacity .24s cubic-bezier(.22,1,.36,1),transform .28s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-line{
  stroke:#52514e;
  transition:stroke .2s ease,transform .26s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-accent{
  stroke:#52514e;
  transition:stroke .2s ease;
}
.duo-btn .duo-dot{
  background:#547dd0;
  transition:transform .24s cubic-bezier(.22,1,.36,1),background-color .2s ease,box-shadow .2s ease;
}

.duo-btn:hover,.force-duo .duo-btn{
  background:#eef3fc;
  border-color:#547dd0;
  box-shadow:0 10px 26px rgba(84,125,208,0.22);
}
.duo-btn:hover .duo-fill-tray,.force-duo .duo-btn .duo-fill-tray{
  opacity:1;
  transform:scaleX(1);
}
.duo-btn:hover .duo-fill-wing,.force-duo .duo-btn .duo-fill-wing{
  opacity:1;
  transform:translateY(1px) scale(1);
}
.duo-btn:hover .duo-line,.force-duo .duo-btn .duo-line{
  stroke:#1f1e1d;
  transform:translateY(1px);
}
.duo-btn:hover .duo-accent,.force-duo .duo-btn .duo-accent{
  stroke:#547dd0;
}
.duo-btn:hover .duo-dot,.force-duo .duo-btn .duo-dot{
  background:#2f5ec4;
  transform:scale(1.18);
  box-shadow:0 0 0 3px #c9d8f3;
}

.puff-fill{position:absolute;top:50%;left:50%;border-radius:50%;background:#c9d8f3;box-shadow:inset 0 0 0 1.5px #547dd0;pointer-events:none}
.puff-acc{position:absolute;top:50%;left:50%;border-radius:50%;background:rgba(84,125,208,0.26);box-shadow:inset 0 0 0 1.5px #20242c;pointer-events:none}
.ctrl-btn{height:32px;padding:0 12px;border-radius:8px;border:1px solid #d5dbe3;background:#ffffff;color:#20242c;font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:6px}
.ctrl-btn:hover{background:#eef3fc;border-color:#547dd0}
.ctrl-btn-active{height:32px;padding:0 12px;border-radius:8px;border:1px solid #476ec2;background:#e5edfc;color:#1d3f8a;font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
</style>
</helmet>

<div class="{{hoverWrapClass}}" style="width:840px;height:680px;box-sizing:border-box;padding:22px 26px;background:#f4f5f7;font-family:-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;color:#20242c;display:flex;flex-direction:column;gap:14px;{{durVar}}">

  <!-- 顶部标题与交互控制栏 -->
  <header style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
    <h1 style="margin:0;font-size:18px;line-height:26px;font-weight:600;color:#20242c">方案 B · 气泡喷泉 + 图标落位 + 涂鸦折返乱线团（悬停 Duo 双色）</h1>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <button type="button" class="ctrl-btn-active" onClick="{{triggerOnce}}">单次重播</button>
      <button type="button" class="{{loopBtnClass}}" onClick="{{setLoopMode}}">循环演示</button>
      <button type="button" class="{{duoBtnClass}}" onClick="{{toggleDuoHover}}">{{duoBtnLabel}}</button>
      <button type="button" class="{{slowBtnClass}}" onClick="{{toggleSlow}}">{{slowLabel}}</button>
    </div>
  </header>

  <!-- 三步拆解可交互切换条 -->
  <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px">
    <button type="button" onClick="{{showStep1}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step1Bd}};background:{{step1Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">1. 气泡动画先出来</span>
      <span style="font-size:14px;color:#526071">7 颗双色圆泡自底向上喷涌散开</span>
    </button>
    <button type="button" onClick="{{showStep2}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step2Bd}};background:{{step2Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">2. 显现图标（悬停变双色）</span>
      <span style="font-size:14px;color:#526071">常态单色，移入绽放箭头翼与托盘双色面</span>
    </button>
    <button type="button" onClick="{{showStep3}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step3Bd}};background:{{step3Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">3. 接着乱糟糟线条动画</span>
      <span style="font-size:14px;color:#526071">双色毛线团与四角 Z 字折返乱线簇</span>
    </button>
  </div>

  <!-- 中央 3 倍放大交互特写舞台 -->
  <div class="{{stageClass}}" style="flex:1;min-height:0;border-radius:14px;background:#ffffff;border:1px solid #e4e6ea;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden">

    <div style="position:absolute;top:14px;left:16px;display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;background:#f8f9fb;border:1px solid #e4e6ea">
      <div style="display:flex;align-items:center;gap:6px">
        <span style="width:14px;height:14px;border-radius:4px;border:1.5px solid #52514e;display:inline-block"></span>
        <span style="font-size:14px;color:#526071">常态：单色线稿</span>
      </div>
      <span style="font-size:14px;color:#9aa5b4">→</span>
      <div style="display:flex;align-items:center;gap:6px">
        <span style="width:14px;height:14px;border-radius:4px;background:#c9d8f3;border:1.5px solid #20242c;box-shadow:inset 0 -3px 0 #547dd0;display:inline-block"></span>
        <span style="font-size:14px;font-weight:500;color:#20242c">鼠标移上去：#c9d8f3 语义面 + #547dd0 双色动效</span>
      </div>
    </div>

    <div style="position:relative;width:240px;height:200px;display:flex;align-items:center;justify-content:center;margin-top:-10px">
      <!-- 第 1 步：7 颗向上喷涌的 Duo 双色气泡 -->
      <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none">
        <span class="puff-fill p1" style="width:28px;height:28px;margin-left:-14px;margin-top:-14px"></span>
        <span class="puff-acc p2" style="width:40px;height:40px;margin-left:-20px;margin-top:-20px"></span>
        <span class="puff-fill p3" style="width:26px;height:26px;margin-left:-13px;margin-top:-13px"></span>
        <span class="puff-acc p4" style="width:36px;height:36px;margin-left:-18px;margin-top:-18px"></span>
        <span class="puff-fill p5" style="width:22px;height:22px;margin-left:-11px;margin-top:-11px"></span>
        <span class="puff-acc p6" style="width:30px;height:30px;margin-left:-15px;margin-top:-15px"></span>
        <span class="puff-fill p7" style="width:24px;height:24px;margin-left:-12px;margin-top:-12px"></span>
      </div>

      <!-- 第 3 步：双色涂鸦毛线团 + Z 字折返线条 -->
      <svg width="240" height="210" viewBox="0 0 240 210" fill="none" aria-hidden="true" style="position:absolute;left:0;top:-5px;pointer-events:none;overflow:visible">
        <path class="s-tangle" d="M 88 46 C 72 18, 126 10, 112 42 C 96 70, 152 14, 146 46 C 140 74, 82 32, 124 18" stroke="#c9d8f3" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"></path>
        <path class="s-tangle" d="M 88 46 C 72 18, 126 10, 112 42 C 96 70, 152 14, 146 46 C 140 74, 82 32, 124 18 C 162 6, 174 52, 134 54" stroke="#547dd0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <path class="s-zig" d="M 56 76 L 24 54 L 52 50 L 18 32 L 48 28 M 184 74 L 216 52 L 188 46 L 222 28 L 194 24 M 54 140 L 22 156 L 48 164 L 26 180 M 186 140 L 218 154 L 192 164 L 214 178" stroke="#20242c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>

      <!-- 第 2 步：支持鼠标悬停双色动画的更新图标本体 -->
      <button type="button" onClick="{{triggerOnce}}" class="u-icon duo-btn" style="width:78px;height:78px;border-radius:18px;display:flex;align-items:center;justify-content:center;position:relative;padding:0">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect class="duo-fill-tray" x="5" y="15.5" width="14" height="4.2" rx="1.8"></rect>
          <path class="duo-fill-wing" d="M7.5 10.5L12 15L16.5 10.5Z"></path>
          <g class="duo-line" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4.5V15"></path>
            <path d="M7.5 10.5L12 15L16.5 10.5"></path>
          </g>
          <path class="duo-accent" d="M5.5 19.5H18.5" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span class="duo-dot" aria-hidden="true" style="position:absolute;top:8px;right:8px;width:11px;height:11px;border-radius:6px"></span>
      </button>
    </div>

    <!-- 底部 1:1 真实侧栏底栏尺寸同步预览 -->
    <div style="position:absolute;bottom:14px;left:20px;right:20px;display:flex;align-items:center;justify-content:space-between;padding:10px 16px;background:#fafafa;border:1px solid #e4e6ea;border-radius:10px">
      <span style="font-size:14px;color:#526071">请把鼠标移到中央大图标或右侧 1:1 底栏图标上，体验 Duo 双色悬停动效</span>
      <div style="width:236px;padding:6px 8px;background:#ffffff;border:1px solid #e4e6ea;border-radius:8px;display:flex;align-items:center;gap:6px">
        <span style="flex:1;font-size:14px;font-weight:500;color:#20242c;padding-left:4px">本地笔记</span>
        <div style="position:relative;width:30px;height:30px;display:flex;align-items:center;justify-content:center">
          <svg width="60" height="54" viewBox="0 0 240 210" fill="none" aria-hidden="true" style="position:absolute;left:-15px;top:-14px;pointer-events:none">
            <path class="s-tangle" d="M 88 46 C 72 18, 126 10, 112 42 C 96 70, 152 14, 146 46" stroke="#c9d8f3" stroke-width="10" stroke-linecap="round"></path>
            <path class="s-tangle" d="M 88 46 C 72 18, 126 10, 112 42 C 96 70, 152 14, 146 46 C 140 74, 82 32, 124 18" stroke="#547dd0" stroke-width="5" stroke-linecap="round"></path>
            <path class="s-zig" d="M 56 76 L 24 54 L 52 50 L 18 32 M 184 74 L 216 52 L 188 46 L 222 28" stroke="#20242c" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <button type="button" onClick="{{triggerOnce}}" class="u-icon duo-btn" style="width:30px;height:30px;border-radius:6px;border-width:1px;display:flex;align-items:center;justify-content:center;position:relative;padding:0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect class="duo-fill-tray" x="5" y="15.5" width="14" height="4.2" rx="1.8"></rect>
              <path class="duo-fill-wing" d="M7.5 10.5L12 15L16.5 10.5Z"></path>
              <g class="duo-line" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4.5V15"></path>
                <path d="M7.5 10.5L12 15L16.5 10.5"></path>
              </g>
              <path class="duo-accent" d="M5.5 19.5H18.5" stroke-width="1.65" stroke-linecap="round"></path>
            </svg>
            <span class="duo-dot" aria-hidden="true" style="position:absolute;top:3px;right:3px;width:5px;height:5px;border-radius:3px"></span>
          </button>
        </div>
