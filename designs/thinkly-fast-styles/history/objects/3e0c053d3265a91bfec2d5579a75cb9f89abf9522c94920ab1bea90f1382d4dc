<script type="text/x-dc" data-dc-script data-props='{"themeMode":{"editor":"enum","default":"light","options":["light","dark"]},"contextMode":{"editor":"enum","default":"empty","options":["empty","selection"]},"$preview":{"width":1440,"height":980}}'>
class Component extends DCLogic {
  constructor(p) {
    super(p);
    this.state = {
      ctx: null,
      stage: 'input',
      prompt: '',
      attachedNote: '核心环境变量清单',
      hasRef: true,
      pop: 'none',
      modelIdx: 0,
      draftVer: 1,
      streamTick: 16,
      autoFinish: false,
      sidebarChatOpen: false
    };
    this._timer = null;
  }

  componentWillUnmount() {
    if (this._timer) {
      clearInterval(this._timer);
      this._timer = null;
    }
  }

  startStream(autoFinish) {
    if (this._timer) clearInterval(this._timer);
    this.setState({ stage: 'stream', streamTick: 0, autoFinish: Boolean(autoFinish), pop: 'none' });
    this._timer = setInterval(() => {
      const cur = (this.state.streamTick ?? 0) + 1;
      if (cur >= 28) {
        clearInterval(this._timer);
        this._timer = null;
        if (this.state.autoFinish) {
          this.setState({ stage: 'review', streamTick: 28 });
        } else {
          this.setState({ streamTick: 24 });
        }
      } else {
        this.setState({ streamTick: cur });
      }
    }, 95);
  }

  renderVals() {
    const dark = (this.props.themeMode ?? 'light') === 'dark';
    const ctx = this.state.ctx ?? (this.props.contextMode ?? 'empty');
    const isEmptyCtx = ctx === 'empty';
    const stage = this.state.stage ?? 'input';
    const pop = this.state.pop ?? 'none';
    const draftVer = this.state.draftVer ?? 1;
    const tick = this.state.streamTick ?? 16;

    const stages = [
      { id: 'trigger', label: '01 / 唤出' },
      { id: 'input', label: '02 指令与引用' },
      { id: 'stream', label: '03 生成动画' },
      { id: 'review', label: '04 审阅追问' },
      { id: 'interrupt', label: '05 中断接力' },
      { id: 'done', label: '06 完成落纸' }
    ];

    const activeBg = dark ? '#343434' : '#e5edfc';
    const activeFg = dark ? '#ececec' : '#20242c';
    const mutedFg = dark ? '#b4b4b4' : '#526071';
    const accent = dark ? '#779de8' : '#547dd0';

    const stageTabs = stages.map((s) => ({
      label: s.label,
      active: stage === s.id,
      bg: stage === s.id ? activeBg : 'transparent',
      fg: stage === s.id ? activeFg : mutedFg,
      ring: stage === s.id ? ('inset 0 0 0 1px ' + accent) : 'none',
      pick: () => {
        if (s.id === 'stream') {
          this.startStream(false);
        } else {
          if (this._timer) { clearInterval(this._timer); this._timer = null; }
          this.setState({ stage: s.id, pop: 'none' });
        }
      }
    }));

    const fullStreamEmpty = '- [ ] 环境变量核对：确认新增密钥已在灰度集群注入\n- [ ] 流量降级开关：验证特性开关可在 10 秒内切回旧链路\n- [ ] 回滚演练确认：核对双写快照与索引无破坏性删除';
    const fullStreamSel = '灰度发布前需逐项核验核心环境变量、特性开关与秒级回滚步骤，确保回滚路径清晰可执行。';
    const targetStreamSource = isEmptyCtx ? fullStreamEmpty : fullStreamSel;
    const isReasoningPhase = tick < 7;
    const ratio = Math.min(1, Math.max(0.08, (tick - 6) / 20));
    const sliceChars = Math.max(2, Math.floor(targetStreamSource.length * ratio));
    const streamVisibleText = targetStreamSource.slice(0, sliceChars);
    const pct = Math.min(100, Math.round((tick / 28) * 100)) + '%';

    const streamStatusText = isReasoningPhase
      ? (isEmptyCtx ? '正在结合上文与 @核心环境变量清单 构思结构…' : '正在分析长句冗余并提炼关键检查项…')
      : (isEmptyCtx ? '正在原位流式写入待办检查项…' : '正在流式生成精简改写稿…');

    const emptyPresets = [
      { label: '续写上文', run: () => this.startStream(true) },
      { label: '列检查清单', run: () => this.startStream(true) },
      { label: '提炼大纲', run: () => this.startStream(true) }
    ];
    const selPresets = [
      { label: '润色', run: () => this.startStream(true) },
      { label: '精简', run: () => this.startStream(true) },
      { label: '转待办', run: () => this.startStream(true) }
    ];

    const morePresets = (isEmptyCtx
      ? ['头脑风暴 5 点', '生成风险对比表', '起草总结段', '口语化草稿']
      : ['翻译成英文', '翻译成中文', '改为严谨书面语', '整理为无序列表']
    ).map((label) => ({ label, run: () => this.startStream(true) }));

    const models = [
      { name: 'Claude Sonnet 4', short: 'Sonnet', tag: '均衡' },
      { name: 'DeepSeek V3', short: 'DeepSeek', tag: '极速' },
      { name: 'GPT-5 Mini', short: 'GPT-5m', tag: '轻量' }
    ];
    const curModel = models[this.state.modelIdx ?? 0] || models[0];
    const modelOptions = models.map((m, i) => ({
      name: m.name,
      tag: m.tag,
      bg: i === (this.state.modelIdx ?? 0) ? activeBg : 'transparent',
      ring: i === (this.state.modelIdx ?? 0) ? ('inset 0 0 0 1px ' + accent) : 'none',
      pick: () => this.setState({ modelIdx: i, pop: 'none' })
    }));

    const refNotes = ['核心环境变量清单', '产品原则', '上次故障复盘纪要'].map((name) => ({
      name,
      pick: () => this.setState({ attachedNote: name, hasRef: true, pop: 'none' })
    }));

    const checklistV1 = [
      { head: '环境变量核对：', body: '确认新增配置与密钥已在灰度集群就绪，默认值可安全兜底。' },
      { head: '特性开关验证：', body: '确认降级开关可在 10 秒内切回旧链路，无需重新发版。' },
      { head: '数据兼容检查：', body: '确认迁移脚本保留旧列读取兼容，满足双版本并行窗口。' }
    ];
    const checklistV2 = [
      { head: '配置与密钥：', body: '灰度注入完毕且默认兜底生效。' },
      { head: '秒级回滚开关：', body: '10 秒内可切回旧版本链路。' },
      { head: '旧列兼容：', body: '灰度期内禁止删除旧字段。' }
    ];

    const isStageTrigger = stage === 'trigger';
    const isStageInput = stage === 'input';
    const isStageStream = stage === 'stream';
    const isStageReview = stage === 'review';
    const isStageInterrupt = stage === 'interrupt';
    const isStageDone = stage === 'done';

    return {
      pageBg: dark ? '#181818' : '#f1f1f1',
      shellBg: dark ? '#343434' : '#f1f1f1',
      barBg: dark ? '#222222' : '#fafafa',
      paperBg: dark ? '#181818' : '#ffffff',
      menuBg: dark ? '#222222' : '#ffffff',
      codeBg: dark ? '#242424' : '#f3f1ec',
      hoverBg: dark ? '#2c2c2c' : '#eef3fc',
      selBg: activeBg,
      textPri: activeFg,
      textSec: mutedFg,
      editorFg: dark ? '#ececec' : '#1f1e1d',
      accentCol: accent,
      duoFill: dark ? '#31456a' : '#c9d8f3',
      borderCol: dark ? '#2e2e2e' : '#e4e6ea',
      shellBorder: dark ? '#333333' : '#e6e6e6',
      btnBorder: dark ? '#444444' : '#dcdcdc',

      isEmptyCtx,
      isSelCtx: !isEmptyCtx,
      ctxEmptyBg: isEmptyCtx ? activeBg : 'transparent',
      ctxEmptyFg: isEmptyCtx ? activeFg : mutedFg,
      ctxEmptyRing: isEmptyCtx ? ('inset 0 0 0 1px ' + accent) : 'none',
      ctxSelBg: !isEmptyCtx ? activeBg : 'transparent',
      ctxSelFg: !isEmptyCtx ? activeFg : mutedFg,
      ctxSelRing: !isEmptyCtx ? ('inset 0 0 0 1px ' + accent) : 'none',
      pickEmptyCtx: () => this.setState({ ctx: 'empty', pop: 'none' }),
      pickSelCtx: () => this.setState({ ctx: 'selection', pop: 'none' }),

      stageTabs,
      isStageTrigger,
      isStageInput,
      isStageStream,
      isStageReview,
      isStageInterrupt,
      isStageDone,
      showDashedTarget: isStageInput || isStageStream || isStageReview || isStageInterrupt,
      showFloatingPod: isStageInput || isStageStream || isStageReview || isStageInterrupt,
      showPromptBox: isStageInput || isStageReview,
      targetBorderCol: isStageInterrupt ? '#b86b11' : accent,
      targetBgCol: isStageInterrupt ? (dark ? '#2b2418' : '#fdf5e8') : (dark ? '#242c3d' : '#eef3fc'),

      isReasoningPhase,
      isWritingPhase: !isReasoningPhase,
      streamVisibleText,
      streamStatusText,
      streamProgressPct: pct,
      replayStream: () => this.startStream(false),
      runStream: () => this.startStream(true),
      stopToInterrupt: () => {
        if (this._timer) { clearInterval(this._timer); this._timer = null; }
        this.setState({ stage: 'interrupt', pop: 'none' });
      },

      goSlash: () => this.setState({ stage: 'trigger', pop: 'none' }),
      goInput: () => this.setState({ stage: 'input', pop: 'none' }),
      goReview: () => this.setState({ stage: 'review', pop: 'none' }),
      acceptToDone: () => this.setState({ stage: 'done', pop: 'none' }),

      promptValue: this.state.prompt ?? '',
      onPromptInput: (e) => this.setState({ prompt: e && e.target ? e.target.value : '' }),
      promptPlaceholder: isStageReview
        ? '输入追问继续微调（如：再简短一半、改成表格）…'
        : (isEmptyCtx ? '输入主题起草，或点下方续写（@ 可引用笔记）…' : '告诉 AI 如何改写这段内容（如：精简、转列表）…'),

      showRefRow: Boolean(this.state.hasRef) && (isStageInput || isStageReview),
      attachedNote: this.state.attachedNote ?? '核心环境变量清单',
      clearRef: () => this.setState({ hasRef: false }),
      isRefOpen: pop === 'ref',
      refBtnBg: pop === 'ref' ? activeBg : 'transparent',
      refBtnRing: pop === 'ref' ? ('inset 0 0 0 1px ' + accent) : 'none',
      toggleRefPopover: () => this.setState({ pop: this.state.pop === 'ref' ? 'none' : 'ref' }),
      refNotes,

      activePresets: isEmptyCtx ? emptyPresets : selPresets,
      moreBtnLabel: isEmptyCtx ? '更多起草' : '翻译与语气',
      isMoreOpen: pop === 'more',
      moreBtnBg: pop === 'more' ? activeBg : 'transparent',
      moreBtnRing: pop === 'more' ? ('inset 0 0 0 1px ' + accent) : 'none',
      toggleMorePopover: () => this.setState({ pop: this.state.pop === 'more' ? 'none' : 'more' }),
      morePresets,

      activeModelShort: curModel.short,
      isModelOpen: pop === 'model',
      modelBtnBg: pop === 'model' ? activeBg : 'transparent',
      modelBtnRing: pop === 'model' ? ('inset 0 0 0 1px ' + accent) : 'none',
      toggleModelPopover: () => this.setState({ pop: this.state.pop === 'model' ? 'none' : 'model' }),
      modelOptions,

      acceptBtnLabel: isEmptyCtx ? '写入正文' : '替换原文',
      reviewChecklist: draftVer === 2 ? checklistV2 : checklistV1,
      selAddedSpan: draftVer === 2
        ? '核心环境变量与 10 秒级特性回滚开关'
        : '核心环境变量、特性降级开关与标准回滚步骤',
      draftVerText: draftVer + '/2',
      refineShorter: () => this.setState({ draftVer: 2 }),
      prevDraftVer: () => this.setState({ draftVer: 1 }),
      nextDraftVer: () => this.setState({ draftVer: 2 }),

      sidebarChatOpen: Boolean(this.state.sidebarChatOpen),
      chatBtnBg: this.state.sidebarChatOpen ? activeBg : 'transparent',
      chatBtnRing: this.state.sidebarChatOpen ? ('inset 0 0 0 1px ' + accent) : 'none',
      toggleSidebarChat: () => this.setState({ sidebarChatOpen: !this.state.sidebarChatOpen }),
      escalateToSidebar: () => this.setState({ sidebarChatOpen: true })
    };
  }
}
</script>
</body>
</html>
