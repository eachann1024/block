<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>行内 AI 全流程 A（推荐）· 420px 悬浮指挥舱 + 纸面原位流式落墨</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..600&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap">
<style>
body{margin:0;font-family:Inter,-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:#3d63b0}a:hover{color:#2c4c8c}
*{box-sizing:border-box}
button,input{font-family:inherit;font-size:14px;line-height:20px}
::selection{background:#cde2fb;color:#184f95}
.ib{width:28px;height:28px;border:0;border-radius:6px;background:transparent;display:inline-flex;align-items:center;justify-content:center;padding:0;cursor:pointer;flex:none}
.ib:hover{background:#eef3fc}
.seg{height:30px;padding:0 10px;border:0;border-radius:6px;background:transparent;font-size:14px;font-weight:460;cursor:pointer;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.chip{height:28px;padding:0 8px;border:0;border-radius:6px;background:transparent;font-size:14px;font-weight:460;display:inline-flex;align-items:center;gap:4px;cursor:pointer;white-space:nowrap;flex:none}
.chip:hover{background:#eef3fc}
.chip-pri{height:28px;padding:0 10px;border:1px solid #547dd0;border-radius:6px;background:#e5edfc;box-shadow:inset 0 0 0 1px #547dd0;color:#20242c;font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:5px;cursor:pointer;white-space:nowrap;flex:none}
.chip-pri:hover{background:#dce8fb}
.mi{width:100%;height:32px;padding:0 10px;border:0;border-radius:6px;background:transparent;display:flex;align-items:center;gap:8px;font-size:14px;text-align:left;cursor:pointer}
.mi:hover{background:#eef3fc}
.kbd{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:12px;line-height:16px;padding:1px 5px;border-radius:5px;border:1px solid #dcdcdc;background:#f1f1f1;color:#526071;flex:none}
.shimmer{background:linear-gradient(90deg,#526071 0%,#526071 35%,#20242c 50%,#526071 65%,#526071 100%);background-size:200% 100%;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;animation:shimmer-sweep 1.6s linear infinite}
.ink-caret{display:inline-block;width:2px;height:18px;background:#547dd0;vertical-align:-3px;margin-left:2px;border-radius:1px;animation:caret-pulse 0.9s ease-in-out infinite}
.dot-pulse{width:8px;height:8px;border-radius:4px;background:#547dd0;flex:none;animation:dot-breathe 1.2s ease-in-out infinite}
.skel-bar{height:14px;border-radius:4px;background:#e5edfc;animation:skel-fade 1.3s ease-in-out infinite}
@keyframes shimmer-sweep{from{background-position:140% 0}to{background-position:-40% 0}}
@keyframes caret-pulse{0%,100%{opacity:1}50%{opacity:0.2}}
@keyframes dot-breathe{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(0.75);opacity:0.45}}
@keyframes skel-fade{0%,100%{opacity:0.85}50%{opacity:0.4}}
@media(prefers-reduced-motion:reduce){.shimmer,.ink-caret,.dot-pulse,.skel-bar{animation:none}.shimmer{-webkit-text-fill-color:#526071}}
</style>
</helmet>

<div style="width:100%;min-height:980px;display:flex;flex-direction:column;background:{{pageBg}};color:{{textPri}};font-size:14px;line-height:20px">

  <!-- 顶部全流程交互切换条 -->
  <div style="min-height:48px;flex:none;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px;padding:8px 18px;background:{{barBg}};border-bottom:1px solid {{shellBorder}}">
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px">
      <div style="display:inline-flex;align-items:center;gap:2px;padding:3px;border-radius:8px;background:{{shellBg}};border:1px solid {{borderCol}}">
        <button type="button" class="seg" onClick="{{pickEmptyCtx}}" style="background:{{ctxEmptyBg}};color:{{ctxEmptyFg}};box-shadow:{{ctxEmptyRing}}">空行 / 起草</button>
        <button type="button" class="seg" onClick="{{pickSelCtx}}" style="background:{{ctxSelBg}};color:{{ctxSelFg}};box-shadow:{{ctxSelRing}}">选区改写</button>
      </div>
      <sc-if value="{{isStageStream}}" hint-placeholder-val="{{false}}">
        <button type="button" class="chip" onClick="{{replayStream}}" style="border:1px solid {{btnBorder}};background:{{paperBg}};color:{{textPri}}">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#547dd0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path></svg>
          <span>重播流式动画</span>
        </button>
      </sc-if>
    </div>

    <div role="tablist" aria-label="行内 AI 生命周期阶段" style="display:inline-flex;flex-wrap:wrap;align-items:center;gap:2px;padding:3px;border-radius:8px;background:{{shellBg}};border:1px solid {{borderCol}}">
      <sc-for list="{{stageTabs}}" as="st" hint-placeholder-count="6">
        <button type="button" role="tab" aria-selected="{{st.active}}" class="seg" onClick="{{st.pick}}" style="background:{{st.bg}};color:{{st.fg}};box-shadow:{{st.ring}}">{{st.label}}</button>
      </sc-for>
    </div>
  </div>

  <!-- Block 标准 40px 窗口顶栏 -->
  <header style="height:40px;flex:none;display:flex;align-items:center;background:{{shellBg}};border-bottom:1px solid {{shellBorder}}">
    <div style="width:260px;height:100%;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 10px 0 14px;border-right:1px solid {{shellBorder}}">
      <div aria-hidden="true" style="display:flex;align-items:center;gap:8px">
        <span style="width:12px;height:12px;border-radius:6px;background:#ff5f57;display:inline-block"></span>
        <span style="width:12px;height:12px;border-radius:6px;background:#febc2e;display:inline-block"></span>
        <span style="width:12px;height:12px;border-radius:6px;background:#28c840;display:inline-block"></span>
      </div>
      <button type="button" class="ib" aria-label="切换侧栏" style="color:{{textSec}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M3.75 4.75H9.25V19.25H5.75A2 2 0 0 1 3.75 17.25V6.75A2 2 0 0 1 5.75 4.75Z" fill="{{duoFill}}"></path>
          <rect x="3.75" y="4.75" width="16.5" height="14.5" rx="2" stroke="currentColor" stroke-width="1.5"></rect>
          <path d="M9.25 4.75V19.25" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="已打开标签页" style="flex:1;min-width:0;display:flex;align-items:center;gap:4px;padding:0 10px;overflow:hidden">
      <button type="button" style="height:28px;padding:0 12px;border:0;border-radius:6px;background:{{selBg}};box-shadow:inset 0 0 0 1px {{accentCol}};color:{{textPri}};font-weight:500;display:inline-flex;align-items:center;gap:7px;cursor:pointer">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="{{accentCol}}" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.75h8l4 4V20.25H6z" fill="{{duoFill}}" stroke="none"></path><path d="M6 3.75h8l4 4V20.25H6z"></path><path d="M14 3.75v4h4"></path></svg>
        <span>发布就绪与回滚规范</span>
      </button>
      <button type="button" style="height:28px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:{{textSec}};display:inline-flex;align-items:center;gap:7px;cursor:pointer">
        <span>产品原则</span>
      </button>
    </nav>

    <div style="height:100%;display:flex;align-items:center;gap:6px;padding:0 12px;border-left:1px solid {{shellBorder}}">
      <button type="button" class="ib" onClick="{{toggleSidebarChat}}" aria-label="AI 助手侧栏" style="background:{{chatBtnBg}};box-shadow:{{chatBtnRing}};color:{{textPri}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2L12 3z" fill="{{duoFill}}" stroke="{{accentCol}}" stroke-width="1.6" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </header>

  <!-- 主工作区（侧栏 + 672px 标准纸面 + 可选接力侧栏） -->
  <div style="flex:1;min-height:0;display:flex;flex-wrap:wrap">

    <!-- 左侧文件树 260px -->
    <aside aria-label="工作区文件树" style="width:260px;flex:none;background:{{barBg}};border-right:1px solid {{shellBorder}};padding:12px 10px;display:flex;flex-direction:column;gap:4px">
      <div style="height:32px;padding:0 10px;border-radius:6px;background:{{selBg}};box-shadow:inset 0 0 0 1px {{accentCol}};color:{{textPri}};font-weight:460;display:flex;align-items:center;gap:8px">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="{{accentCol}}" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.75h8l4 4V20.25H6z" fill="{{duoFill}}" stroke="none"></path><path d="M6 3.75h8l4 4V20.25H6z"></path></svg>
        <span>发布就绪与回滚规范</span>
      </div>
      <div style="height:32px;padding:0 10px;border-radius:6px;color:{{textSec}};display:flex;align-items:center;gap:8px">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.75h8l4 4V20.25H6z"></path></svg>
        <span>产品原则</span>
      </div>
      <div style="height:32px;padding:0 10px;border-radius:6px;color:{{textSec}};display:flex;align-items:center;gap:8px">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.75h8l4 4V20.25H6z"></path></svg>
        <span>核心环境变量清单</span>
      </div>
    </aside>

    <!-- 正文编辑区（标准版心 672px） -->
    <main style="flex:999 1 560px;min-width:0;background:{{paperBg}};padding:44px 40px 120px;display:flex;justify-content:center;overflow-y:auto">
      <article style="width:100%;max-width:672px;display:flex;flex-direction:column;gap:18px;font-size:16px;line-height:28px;color:{{editorFg}}">

        <h1 style="margin:0;font-size:28px;line-height:36px;font-weight:600;color:{{textPri}}">发布就绪与回滚规范</h1>

        <p style="margin:0;color:{{editorFg}}">每次生产环境变更必须在灰度窗口开启前完成双人交叉核验。数据库结构变更需兼容前一个稳定版本，禁止在同一批次内同时执行字段重命名与旧列清理。</p>

        <!-- 目标块区域（承载全套 6 阶段原位状态） -->
        <div style="position:relative;margin-top:4px">

          <!-- 左侧块把手 + -->
          <button type="button" onClick="{{goSlash}}" aria-label="打开块菜单" style="position:absolute;left:-32px;top:6px;width:24px;height:24px;border:0;border-radius:6px;background:transparent;color:{{textSec}};display:inline-flex;align-items:center;justify-content:center;cursor:pointer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          </button>

          <!-- 01 唤出态：空行斜杠 vs 选区浮动条 -->
          <sc-if value="{{isStageTrigger}}" hint-placeholder-val="{{false}}">
            <sc-if value="{{isEmptyCtx}}" hint-placeholder-val="{{true}}">
              <div style="padding:6px 12px;border-radius:8px;border:1px dashed {{accentCol}};background:{{hoverBg}};display:flex;align-items:center;gap:2px">
                <span style="font-family:'JetBrains Mono',monospace;color:{{accentCol}};font-weight:500">/</span>
                <span class="ink-caret"></span>
                <span style="margin-left:8px;color:{{textSec}};font-size:15px">输入命令过滤，或按空格直达 AI 写作</span>
              </div>

              <!-- 紧凑斜杠菜单 244px -->
              <div role="menu" aria-label="斜杠命令菜单" style="margin-top:6px;width:248px;padding:5px;border-radius:10px;background:{{menuBg}};border:1px solid {{borderCol}};box-shadow:0 10px 28px rgba(32,36,44,0.12);display:flex;flex-direction:column;gap:2px">
                <button type="button" role="menuitem" class="mi" onClick="{{goInput}}" style="background:{{selBg}};box-shadow:inset 0 0 0 1px {{accentCol}};color:{{textPri}};font-weight:500">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none"><path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2L12 3z" fill="{{duoFill}}" stroke="{{accentCol}}" stroke-width="1.6" stroke-linejoin="round"></path></svg>
                  <span style="flex:1">AI 写作</span>
                  <span class="kbd">空格 / ↵</span>
                </button>
                <div style="height:1px;background:{{borderCol}};margin:3px 6px"></div>
                <button type="button" role="menuitem" class="mi" onClick="{{goInput}}" style="color:{{textPri}}">
                  <span style="width:16px;text-align:center;font-weight:600;color:{{textSec}};font-size:13px">H1</span>
                  <span style="flex:1">一级标题</span>
                  <span class="kbd">⌘⌥1</span>
                </button>
                <button type="button" role="menuitem" class="mi" onClick="{{goInput}}" style="color:{{textPri}}">
                  <span style="width:16px;text-align:center;font-weight:600;color:{{textSec}};font-size:13px">H2</span>
                  <span style="flex:1">二级标题</span>
                  <span class="kbd">⌘⌥2</span>
                </button>
                <button type="button" role="menuitem" class="mi" onClick="{{goInput}}" style="color:{{textPri}}">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="{{textSec}}" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="3"></rect><path d="M8.5 12.5l2.3 2.3 4.7-4.8"></path></svg>
                  <span style="flex:1">待办清单</span>
                  <span class="kbd">⌘⌥4</span>
                </button>
                <button type="button" role="menuitem" class="mi" onClick="{{goInput}}" style="color:{{textPri}}">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="{{textSec}}" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"></rect><path d="M3.5 9.5h17M9.5 9.5v10"></path></svg>
                  <span style="flex:1">表格</span>
                </button>
              </div>
            </sc-if>

            <sc-if value="{{isSelCtx}}" hint-placeholder-val="{{false}}">
              <!-- 选区唤出浮动格式条 -->
              <div role="toolbar" aria-label="选区格式与 AI 工具栏" style="margin-bottom:8px;display:inline-flex;align-items:center;gap:3px;padding:4px;border-radius:8px;background:{{menuBg}};border:1px solid {{borderCol}};box-shadow:0 8px 22px rgba(32,36,44,0.12)">
                <button type="button" class="chip-pri" onClick="{{goInput}}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2L12 3z" fill="{{duoFill}}" stroke="{{accentCol}}" stroke-width="1.7" stroke-linejoin="round"></path></svg>
                  <span>AI 改写</span>
                  <span class="kbd" style="background:#ffffff">⌘J</span>
                </button>
                <div style="width:1px;height:16px;background:{{borderCol}};margin:0 2px"></div>
                <button type="button" class="chip" style="color:{{textPri}};font-weight:600">B</button>
                <button type="button" class="chip" style="color:{{textPri}};font-style:italic">I</button>
                <button type="button" class="chip" style="color:{{textPri}};font-family:'JetBrains Mono',monospace">&lt;/&gt;</button>
              </div>
              <div style="padding:8px 12px;border-radius:8px;background:#cde2fb;color:#184f95">
                灰度发布前需要把所有零散的环境变量、特性开关还有如果出问题怎么切回老版本的步骤全部人工对一遍，确保大家都能看懂并且不会漏掉关键项。
              </div>
            </sc-if>
          </sc-if>

          <!-- 02..05 纸面锚定虚线框（输入 / 流式落墨 / 原位审阅 / 中断挽留） -->
          <sc-if value="{{showDashedTarget}}" hint-placeholder-val="{{true}}">
            <div style="padding:10px 14px;border-radius:10px;border:1px dashed {{targetBorderCol}};background:{{targetBgCol}};transition:background 0.2s">

              <!-- 02 输入态下的纸面锚点显示 -->
              <sc-if value="{{isStageInput}}" hint-placeholder-val="{{true}}">
                <sc-if value="{{isEmptyCtx}}" hint-placeholder-val="{{true}}">
                  <span style="color:{{textSec}};font-size:15px">AI 将在此处结合上文起草内容…</span>
                </sc-if>
                <sc-if value="{{isSelCtx}}" hint-placeholder-val="{{false}}">
                  <span>灰度发布前需要把所有零散的环境变量、特性开关还有如果出问题怎么切回老版本的步骤全部人工对一遍，确保大家都能看懂并且不会漏掉关键项。</span>
                </sc-if>
              </sc-if>

              <!-- 03 生成过程动画：思考骨架 -> 纸面原位流式吐字 -->
              <sc-if value="{{isStageStream}}" hint-placeholder-val="{{false}}">
                <sc-if value="{{isReasoningPhase}}" hint-placeholder-val="{{false}}">
                  <div style="display:flex;flex-direction:column;gap:10px;padding:4px 0">
                    <div class="skel-bar" style="width:72%"></div>
                    <div class="skel-bar" style="width:90%"></div>
                    <div class="skel-bar" style="width:54%"></div>
                  </div>
                </sc-if>
                <sc-if value="{{isWritingPhase}}" hint-placeholder-val="{{true}}">
                  <div style="white-space:pre-line;color:{{editorFg}};font-size:16px;line-height:28px">
                    <span>{{streamVisibleText}}</span><span class="ink-caret"></span>
                  </div>
                </sc-if>
              </sc-if>

              <!-- 04 审阅态：空行新稿卡片 vs 选区词级红删绿增 Diff -->
              <sc-if value="{{isStageReview}}" hint-placeholder-val="{{false}}">
                <sc-if value="{{isEmptyCtx}}" hint-placeholder-val="{{true}}">
                  <div style="display:flex;flex-direction:column;gap:6px">
                    <sc-for list="{{reviewChecklist}}" as="row" hint-placeholder-count="3">
                      <div style="display:flex;align-items:flex-start;gap:9px">
                        <span style="margin-top:6px;width:15px;height:15px;border-radius:4px;border:1.5px solid #547dd0;background:#ffffff;flex:none"></span>
                        <span><strong style="font-weight:560;color:{{textPri}}">{{row.head}}</strong>{{row.body}}</span>
                      </div>
                    </sc-for>
                  </div>
                </sc-if>
                <sc-if value="{{isSelCtx}}" hint-placeholder-val="{{false}}">
                  <div>
                    <span>灰度发布前需逐项核验 </span>
                    <span style="background:#fbe9e7;color:#b42318;text-decoration:line-through;padding:1px 6px;border-radius:4px">所有零散的环境变量、特性开关还有如果出问题怎么切回老版本的步骤</span>
                    <span> </span>
                    <span style="background:#e3f6ec;color:#087443;padding:1px 6px;border-radius:4px">{{selAddedSpan}}</span>
                    <span>，确保回滚路径清晰可执行。</span>
                  </div>
                </sc-if>
              </sc-if>

              <!-- 05 中断与异常挽留态 -->
              <sc-if value="{{isStageInterrupt}}" hint-placeholder-val="{{false}}">
                <div style="display:flex;flex-direction:column;gap:6px">
                  <div style="display:flex;align-items:center;gap:8px;color:#8a4e08;font-size:14px;font-weight:500">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#b86b11" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 8v4.5M12 16h.01"></path></svg>
                    <span>已手动暂停 · 已保留前 2 条草稿（原文未改动）</span>
                  </div>
                  <div style="color:{{editorFg}};white-space:pre-line">- [ ] 环境变量核对：确认新增密钥已在灰度集群注入
- [ ] 流量降级开关：验证特性开关可在 10 秒内秒级切回</div>
                </div>
              </sc-if>

            </div>
          </sc-if>

          <!-- 06 完成落纸态：干净融入正文 + 句尾轻量可撤销微章 -->
          <sc-if value="{{isStageDone}}" hint-placeholder-val="{{false}}">
            <div style="display:flex;flex-direction:column;gap:8px;padding:4px 0">
              <sc-if value="{{isEmptyCtx}}" hint-placeholder-val="{{true}}">
                <sc-for list="{{reviewChecklist}}" as="row" hint-placeholder-count="3">
                  <div style="display:flex;align-items:flex-start;gap:9px">
                    <span style="margin-top:6px;width:15px;height:15px;border-radius:4px;border:1.5px solid #526071;flex:none"></span>
                    <span><strong style="font-weight:560;color:{{textPri}}">{{row.head}}</strong>{{row.body}}</span>
                  </div>
                </sc-for>
              </sc-if>
              <sc-if value="{{isSelCtx}}" hint-placeholder-val="{{false}}">
