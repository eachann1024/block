<svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5L9.5 17L19 7.5" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</sc-if>
</button>
</div>
<span style="font-size:14px;line-height:20px;font-weight:560;color:{{textPrimary}};overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Claude</span>
</div>

<div class="agent-tile" onClick="{{focusDsh}}" style="background:{{c3Bg}};border:1px solid {{c3Border}};box-shadow:{{c3Ring}}">
<div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true" style="color:{{textPrimary}};flex:none">
