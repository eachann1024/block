<sc-if value="{{c3Enabled}}" hint-placeholder-val="{{false}}">
<svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12.5L9.5 17L19 7.5" stroke="#ffffff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</sc-if>
</button>
</div>
<span style="font-size:14px;line-height:20px;font-weight:560;color:{{textPrimary}};overflow:hidden;text-overflow:ellipsis;white-space:nowrap">dsh</span>
</div>

<div class="agent-tile" onClick="{{focusPi}}" style="background:{{c4Bg}};border:1px solid {{c4Border}};box-shadow:{{c4Ring}}">
<div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
<svg width="24" height="24" viewBox="0 0 4 4" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true" style="color:{{textPrimary}};flex:none">
