</svg>
<button type="button" aria-label="切换 Claude 启用状态" onClick="{{toggleClaude}}" style="width:20px;height:20px;padding:0;border-radius:6px;background:{{c2CheckBg}};border:1px solid {{c2CheckBorder}};display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex:none">
