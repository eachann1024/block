<script type="text/x-dc" data-dc-script data-props='{"theme":{"editor":"enum","options":["dark","light"],"default":"dark"},"$preview":{"width":1440,"height":920}}'>
class Component extends DCLogic {
  init() {
    this.state = {
      dark: (this.props.theme ?? 'dark') === 'dark',
      masterOn: true,
      focused: 'dsh',
      saved: { builtin: true, codex: true, claude: true, dsh: false, pi: false },
      pending: {},
      fullPerm: { codex: true, claude: true, dsh: false, pi: false }
    };
  }
  isEnabled(k) {
    const st = this.state;
    return Object.prototype.hasOwnProperty.call(st.pending, k) ? st.pending[k] : st.saved[k];
  }
  hasPending() {
    const st = this.state;
    return Object.keys(st.pending).some((k) => st.pending[k] !== st.saved[k]);
  }
  toggleKind(k, e) {
    if (e && e.stopPropagation) e.stopPropagation();
    const next = !this.isEnabled(k);
    const pending = Object.assign({}, this.state.pending, { [k]: next });
    if (pending[k] === this.state.saved[k]) delete pending[k];
    this.setState({ focused: k, pending });
  }
  renderVals() {
    const st = this.state;
    const dark = st.dark;
    const shellBg = dark ? '#343434' : '#f1f1f1';
    const sidebarBg = dark ? '#222222' : '#fafafa';
    const settingsBg = dark ? '#181818' : '#f8f8f8';
    const cardBg = dark ? '#222222' : '#ffffff';
    const textPrimary = dark ? '#ececec' : '#20242c';
    const textSecondary = dark ? '#b4b4b4' : '#526071';
    const accent = dark ? '#779de8' : '#547dd0';
    const iconFill = dark ? '#31456a' : '#c9d8f3';
    const selectedBg = dark ? '#222e46' : '#e5edfc';
    const borderCol = dark ? '#2e2e2e' : '#e4e6ea';
    const shellBorder = dark ? '#333333' : '#e6e6e6';
    const btnBorder = dark ? '#444444' : '#dcdcdc';
    const ring = `inset 0 0 0 1px ${accent}`;

    const names = { builtin: '内置 AI', codex: 'Codex', claude: 'Claude', dsh: 'dsh', pi: 'Pi' };
    const cardProps = (k) => {
      const foc = st.focused === k;
      const en = this.isEnabled(k);
      return {
        bg: foc ? selectedBg : shellBg,
        border: foc ? accent : btnBorder,
        ring: foc ? ring : 'none',
        en,
        checkBg: en ? accent : cardBg,
        checkBorder: en ? accent : btnBorder
      };
    };
    const c0 = cardProps('builtin');
    const c1 = cardProps('codex');
    const c2 = cardProps('claude');
    const c3 = cardProps('dsh');
    const c4 = cardProps('pi');
    const dirty = this.hasPending();
    const focSavedEn = st.saved[st.focused];
    const permOn = !!st.fullPerm[st.focused] && focSavedEn;

    return {
      shellBg, sidebarBg, settingsBg, cardBg, textPrimary, textSecondary,
      accent, iconFill, selectedBg, borderCol, shellBorder, btnBorder,
      themeLabel: dark ? '深色预览' : '浅色预览',
      isMasterOn: st.masterOn,
      masterLabel: st.masterOn ? '已开启' : '已关闭',
      masterBg: st.masterOn ? selectedBg : shellBg,
      masterBorder: st.masterOn ? accent : btnBorder,
      c0Bg: c0.bg, c0Border: c0.border, c0Ring: c0.ring, c0Enabled: c0.en, c0CheckBg: c0.checkBg, c0CheckBorder: c0.checkBorder,
      c1Bg: c1.bg, c1Border: c1.border, c1Ring: c1.ring, c1Enabled: c1.en, c1CheckBg: c1.checkBg, c1CheckBorder: c1.checkBorder,
      c2Bg: c2.bg, c2Border: c2.border, c2Ring: c2.ring, c2Enabled: c2.en, c2CheckBg: c2.checkBg, c2CheckBorder: c2.checkBorder,
      c3Bg: c3.bg, c3Border: c3.border, c3Ring: c3.ring, c3Enabled: c3.en, c3CheckBg: c3.checkBg, c3CheckBorder: c3.checkBorder,
      c4Bg: c4.bg, c4Border: c4.border, c4Ring: c4.ring, c4Enabled: c4.en, c4CheckBg: c4.checkBg, c4CheckBorder: c4.checkBorder,
      saveBtnBg: selectedBg,
      saveBtnBorder: accent,
      saveBtnCol: dirty ? textPrimary : textSecondary,
      saveBtnOpacity: dirty ? '1' : '0.5',
      focusedName: names[st.focused],
      showLockedBar: st.masterOn && !focSavedEn,
      showBuiltinConfig: st.masterOn && st.focused === 'builtin',
      showAgentConfig: st.masterOn && st.focused !== 'builtin',
      configOpacity: focSavedEn ? '1' : '0.45',
      fullPermOn: permOn,
      permCheckBg: permOn ? accent : cardBg,
      permCheckBorder: permOn ? accent : btnBorder,
      toggleTheme: () => this.setState({ dark: !st.dark }),
      toggleMaster: () => this.setState({ masterOn: !st.masterOn }),
      focusBuiltin: () => this.setState({ focused: 'builtin' }),
      focusCodex: () => this.setState({ focused: 'codex' }),
      focusClaude: () => this.setState({ focused: 'claude' }),
      focusDsh: () => this.setState({ focused: 'dsh' }),
      focusPi: () => this.setState({ focused: 'pi' }),
      toggleBuiltin: (e) => this.toggleKind('builtin', e),
      toggleCodex: (e) => this.toggleKind('codex', e),
      toggleClaude: (e) => this.toggleKind('claude', e),
      toggleDsh: (e) => this.toggleKind('dsh', e),
      togglePi: (e) => this.toggleKind('pi', e),
      saveBackends: () => {
        if (!dirty) return;
        this.setState({ saved: Object.assign({}, st.saved, st.pending), pending: {} });
      },
      enableFocused: () => this.toggleKind(st.focused),
      toggleFullPerm: () => {
        if (!focSavedEn) return;
        this.setState({ fullPerm: Object.assign({}, st.fullPerm, { [st.focused]: !st.fullPerm[st.focused] }) });
      }
    };
  }
}
</script>
