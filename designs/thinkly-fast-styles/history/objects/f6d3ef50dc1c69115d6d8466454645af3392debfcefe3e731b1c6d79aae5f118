</svg>
<button type="button" aria-label="切换 Pi 启用状态" onClick="{{togglePi}}" style="width:20px;height:20px;padding:0;border-radius:6px;background:{{c4CheckBg}};border:1px solid {{c4CheckBorder}};display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex:none">
<sc-if value="{{c4Enabled}}" hint-placeholder-val="{{false}}">
