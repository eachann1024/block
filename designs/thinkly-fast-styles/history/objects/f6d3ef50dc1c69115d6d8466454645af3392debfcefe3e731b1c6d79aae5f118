<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>Agent 卡片布局 A（推荐）· 单行五联紧凑方卡（96px 高 · 24px 图标 · 消除 Pi 换行拉伸 + 右下紧凑保存）</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..600&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap">
<style>
body{margin:0}
a{color:#779de8}a:hover{color:#547dd0}
button,input{font-family:inherit;font-size:14px;line-height:20px}
button:focus-visible,input:focus-visible{outline:2px solid #779de8;outline-offset:1px}
.mono{font-family:'JetBrains Mono',Menlo,ui-monospace,monospace;font-variant-numeric:tabular-nums}
.nav-row{width:100%;height:34px;padding:0 10px;border-radius:8px;display:flex;align-items:center;gap:8px;cursor:pointer;box-sizing:border-box;text-align:left;background:transparent}
.pcard{flex:1;min-width:0;padding:10px 12px;border-radius:8px;display:flex;align-items:center;gap:8px;cursor:pointer;box-sizing:border-box;text-align:left}
.tbtn{height:30px;padding:0 12px;border-radius:8px;display:inline-flex;align-items:center;gap:6px;cursor:pointer;box-sizing:border-box;white-space:nowrap;font-weight:460}
.abtn{height:32px;padding:0 14px;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;box-sizing:border-box;white-space:nowrap;font-weight:500;flex:none}
.agent-tile{flex:1;min-width:0;height:96px;padding:12px;border-radius:8px;display:flex;flex-direction:column;justify-content:space-between;box-sizing:border-box;cursor:pointer;position:relative;transition:border-color 140ms ease,background-color 140ms ease}
</style>
</helmet>

<div style="width:100%;min-height:920px;box-sizing:border-box;display:flex;flex-direction:column;background:{{shellBg}};color:{{textPrimary}};font-family:Inter,-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;font-size:14px;line-height:20px;overflow:hidden;-webkit-font-smoothing:antialiased">

<header style="height:40px;flex:none;display:flex;align-items:center;background:{{shellBg}};border-bottom:1px solid {{shellBorder}};box-sizing:border-box">
<div style="width:260px;flex:none;height:100%;padding:0 10px 0 16px;border-right:1px solid {{shellBorder}};display:flex;align-items:center;justify-content:space-between;box-sizing:border-box">
<div aria-hidden="true" style="display:flex;align-items:center;gap:8px;flex:none">
<span style="width:12px;height:12px;border-radius:6px;background:#ff5f57"></span>
<span style="width:12px;height:12px;border-radius:6px;background:#febc2e"></span>
<span style="width:12px;height:12px;border-radius:6px;background:#28c840"></span>
</div>
<span style="color:{{textSecondary}};font-weight:460">设置</span>
</div>

<div style="flex:1;min-width:0;height:100%;padding:0 16px;display:flex;align-items:center;justify-content:space-between;gap:12px;box-sizing:border-box">
<div style="display:flex;align-items:center;gap:6px;min-width:0">
<span style="color:{{textSecondary}}">设置</span>
<span style="color:{{textSecondary}}">/</span>
<span style="color:{{textPrimary}};font-weight:460">AI 助手 · 方案 A（单行五联紧凑方卡 96px）</span>
</div>

<div style="display:flex;align-items:center;gap:8px;flex:none">
<button type="button" class="tbtn" onClick="{{toggleTheme}}" style="height:26px;padding:0 10px;background:{{cardBg}};border:1px solid {{btnBorder}};color:{{textPrimary}}">{{themeLabel}}</button>
</div>
</div>
</header>

<div style="flex:1;min-height:0;display:flex">

<aside aria-label="设置分类导航" style="width:260px;flex:none;background:{{sidebarBg}};border-right:1px solid {{shellBorder}};display:flex;flex-direction:column;justify-content:space-between;padding:12px 10px;box-sizing:border-box">
<nav aria-label="设置分类" style="display:flex;flex-direction:column;gap:4px">
<button type="button" class="nav-row" style="background:{{selectedBg}};color:{{textPrimary}};border:1px solid {{accent}};font-weight:500">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none">
<path d="M12 3.5L14.2 9.3L20 11.5L14.2 13.7L12 19.5L9.8 13.7L4 11.5L9.8 9.3L12 3.5Z" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
<path d="M18.5 4V7M17 5.5H20" stroke="{{accent}}" stroke-width="1.6" stroke-linecap="round"></path>
</svg>
<span>AI 助手</span>
</button>

<button type="button" class="nav-row" style="color:{{textSecondary}};border:1px solid transparent;font-weight:460">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none">
<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
<circle cx="9" cy="7" r="2" fill="{{iconFill}}" stroke="{{accent}}" stroke-width="1.5"></circle>
<circle cx="15" cy="12" r="2" fill="{{iconFill}}" stroke="{{accent}}" stroke-width="1.5"></circle>
<circle cx="10" cy="17" r="2" fill="{{iconFill}}" stroke="{{accent}}" stroke-width="1.5"></circle>
</svg>
<span>通用与编辑</span>
</button>

<button type="button" class="nav-row" style="color:{{textSecondary}};border:1px solid transparent;font-weight:460">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none">
<rect x="3.5" y="4.5" width="17" height="12" rx="2" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5"></rect>
<path d="M8 20H16M12 16.5V20" stroke="{{accent}}" stroke-width="1.6" stroke-linecap="round"></path>
</svg>
<span>外观与字体</span>
</button>

<button type="button" class="nav-row" style="color:{{textSecondary}};border:1px solid transparent;font-weight:460">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none">
<rect x="3.25" y="5.75" width="17.5" height="12.5" rx="2" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5"></rect>
<path d="M7.5 10h2M11 10h2M14.5 10h2M7.5 14h9" stroke="{{accent}}" stroke-width="1.5" stroke-linecap="round"></path>
</svg>
<span>基础快捷键</span>
</button>
</nav>
</aside>

<main style="flex:1;min-width:0;background:{{settingsBg}};overflow-y:auto">
<div style="max-width:720px;margin:0 auto;padding:40px 28px 64px;display:flex;flex-direction:column;gap:24px;box-sizing:border-box">

<div style="display:flex;align-items:center;justify-content:space-between;gap:16px">
<h1 style="margin:0;font-size:24px;line-height:32px;font-weight:560;color:{{textPrimary}}">AI 助手</h1>
<button type="button" aria-label="关闭设置" style="width:28px;height:28px;border:0;border-radius:6px;background:transparent;color:{{textSecondary}};display:inline-flex;align-items:center;justify-content:center;cursor:pointer">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
</button>
</div>

<section aria-label="AI 与本机 Agent" style="background:{{cardBg}};border:1px solid {{borderCol}};border-radius:14px;padding:18px 20px;display:flex;flex-direction:column;gap:14px">
<div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
<span style="font-size:15px;line-height:22px;font-weight:560;color:{{textPrimary}}">AI 与本机 Agent</span>
<button type="button" class="tbtn" onClick="{{toggleMaster}}" style="background:{{masterBg}};border:1px solid {{masterBorder}};color:{{textPrimary}}">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
<path d="M12 3.5L14.2 9.3L20 11.5L14.2 13.7L12 19.5L9.8 13.7L4 11.5L9.8 9.3L12 3.5Z" fill="{{iconFill}}" stroke="{{accent}}" stroke-width="1.6" stroke-linejoin="round"></path>
<path d="M18.5 4V7M17 5.5H20" stroke="{{accent}}" stroke-width="1.6" stroke-linecap="round"></path>
</svg>
<span>{{masterLabel}}</span>
</button>
</div>

<sc-if value="{{isMasterOn}}" hint-placeholder-val="{{true}}">
<div style="display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px">

<div class="agent-tile" onClick="{{focusBuiltin}}" style="background:{{c0Bg}};border:1px solid {{c0Border}};box-shadow:{{c0Ring}}">
<div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
<svg width="24" height="24" viewBox="0 0 640 640" fill="currentColor" aria-hidden="true" style="color:{{textPrimary}};flex:none">
<path d="M367.4 65.9C364.6 67.5 356.1 74.4 348.4 81.2C340.8 88 328.9 98.3 322 104C315.1 109.8 305.5 118.4 300.5 123.1C288.6 134.5 278.3 142.3 277.6 140.4C244 155 206 171.1 192.5 179.5C161.4 192.9 128.5 223 116.5 240.5C100.6 262.3 84.4 300.7 81.5 318.8C67.3 346.3 32 386 13.1 419.8L0.3 488C13.4 589.9 42.1 621.3 80.1 634.3C97.1 640.2 91.9 640 254.1 640C336 640 403 639.7 403 639.2C400.1 610 393 597.4 388 592.2C415.9 604 405.3 580.1 399.4 573.1C388.4 516.6 394.4 481.1 400.3 471.5C446 466.3 487 449.7 511 417.1C533 376.9 535.4 370.2 530.8 350.5C503.3 317.7 492 268.8 494.4 260.7C488 227.9 465 206.3 444.4 191.2C416.8 166.5 381.4 141.1 385.5 106.5C387.7 88.5 385.3 70.5 380 65.7C376.2 62.3 373.8 62.3 367.4 65.9ZM336.5 158.1L326.6 196.5L359.4 194.1L300.3 288.3L323.8 214.1L291.3 217.6L345.7 120.4L336.5 158.1Z"></path>
