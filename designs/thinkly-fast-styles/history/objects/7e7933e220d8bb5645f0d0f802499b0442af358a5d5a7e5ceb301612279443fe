<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>更新图标动效 C · 双层气泡 + 图标显影 + 交叉波浪涂鸦线（含悬停双色 Duo 动效）</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<style>
body{margin:0}
button{font-family:inherit;cursor:pointer}

/* ===== 方案 C：1. 双波双色气泡先出 -> 2. 图标清晰显影 -> 3. 底部双色来回乱涂波浪线与角标乱抓线 ===== */
@keyframes puffC1{
  0%{transform:translate(0,0) scale(.18);opacity:0}
  5%{opacity:.95}
  26%{transform:translate(-66px,-38px) scale(1.06);opacity:0}
  100%{transform:translate(-66px,-38px) scale(1.06);opacity:0}
}
@keyframes puffC2{
  0%,2%{transform:translate(0,0) scale(.18);opacity:0}
  7%{opacity:.95}
  28%{transform:translate(-32px,-66px) scale(1.1);opacity:0}
  100%{transform:translate(-32px,-66px) scale(1.1);opacity:0}
}
@keyframes puffC3{
  0%,3%{transform:translate(0,0) scale(.18);opacity:0}
  8%{opacity:.95}
  27%{transform:translate(16px,-70px) scale(1);opacity:0}
  100%{transform:translate(16px,-70px) scale(1);opacity:0}
}
@keyframes puffC4{
  0%,1%{transform:translate(0,0) scale(.18);opacity:0}
  6%{opacity:.95}
  29%{transform:translate(62px,-42px) scale(1.08);opacity:0}
  100%{transform:translate(62px,-42px) scale(1.08);opacity:0}
}
@keyframes puffC5{
  0%,4%{transform:translate(0,0) scale(.18);opacity:0}
  9%{opacity:.95}
  30%{transform:translate(72px,10px) scale(.96);opacity:0}
  100%{transform:translate(72px,10px) scale(.96);opacity:0}
}
@keyframes puffC6{
  0%,2%{transform:translate(0,0) scale(.18);opacity:0}
  7%{opacity:.95}
  28%{transform:translate(-68px,22px) scale(1);opacity:0}
  100%{transform:translate(-68px,22px) scale(1);opacity:0}
}
@keyframes puffC7{
  0%,5%{transform:translate(0,0) scale(.18);opacity:0}
  10%{opacity:.95}
  31%{transform:translate(36px,46px) scale(.98);opacity:0}
  100%{transform:translate(36px,46px) scale(.98);opacity:0}
}

/* 第 2 步：气泡散开后图标显影 */
@keyframes iconRevealC{
  0%,18%{transform:scale(.15);opacity:0}
  27%{transform:scale(1.1);opacity:1}
  33%{transform:scale(.97);opacity:1}
  38%,90%{transform:scale(1);opacity:1}
  96%,100%{transform:scale(.2);opacity:0}
}

/* 第 3 步：图标下方与右上角快速来回乱涂的双色交叉波浪涂鸦线 */
@keyframes waveScratchC{
  0%,36%{stroke-dashoffset:640;opacity:0}
  39%{opacity:1}
  67%{stroke-dashoffset:0;opacity:1}
  84%{stroke-dashoffset:0;opacity:.92}
  95%,100%{stroke-dashoffset:-640;opacity:0}
}
@keyframes crownScratchC{
  0%,41%{stroke-dashoffset:420;opacity:0}
  44%{opacity:1}
  72%{stroke-dashoffset:0;opacity:1}
  86%{stroke-dashoffset:0;opacity:.88}
  96%,100%{stroke-dashoffset:-420;opacity:0}
}

/* 单次触发重播组 */
@keyframes puffOnceC1{0%{transform:translate(0,0) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(-66px,-38px) scale(1.06);opacity:0}}
@keyframes puffOnceC2{0%{transform:translate(0,0) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(-32px,-66px) scale(1.1);opacity:0}}
@keyframes puffOnceC3{0%{transform:translate(0,0) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(16px,-70px) scale(1);opacity:0}}
@keyframes puffOnceC4{0%{transform:translate(0,0) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(62px,-42px) scale(1.08);opacity:0}}
@keyframes puffOnceC5{0%{transform:translate(0,0) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(72px,10px) scale(.96);opacity:0}}
@keyframes puffOnceC6{0%{transform:translate(0,0) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(-68px,22px) scale(1);opacity:0}}
@keyframes puffOnceC7{0%{transform:translate(0,0) scale(.2);opacity:0}14%{opacity:.95}100%{transform:translate(36px,46px) scale(.98);opacity:0}}
@keyframes iconOnceC{
  0%,25%{transform:scale(.15);opacity:0}
  44%{transform:scale(1.1);opacity:1}
  56%{transform:scale(.97);opacity:1}
  66%,100%{transform:scale(1);opacity:1}
}
@keyframes waveOnceC{
  0%,50%{stroke-dashoffset:640;opacity:0}
  54%{opacity:1}
  90%,100%{stroke-dashoffset:0;opacity:1}
}
@keyframes crownOnceC{
  0%,56%{stroke-dashoffset:420;opacity:0}
  60%{opacity:1}
  94%,100%{stroke-dashoffset:0;opacity:1}
}

.stage-loop .p1{animation:puffC1 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p2{animation:puffC2 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p3{animation:puffC3 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p4{animation:puffC4 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p5{animation:puffC5 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p6{animation:puffC6 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .p7{animation:puffC7 var(--dur,3.4s) cubic-bezier(.215,.61,.355,1) infinite}
.stage-loop .u-icon{animation:iconRevealC var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}
.stage-loop .s-wave{stroke-dasharray:640;animation:waveScratchC var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}
.stage-loop .s-crown{stroke-dasharray:420;animation:crownScratchC var(--dur,3.4s) cubic-bezier(.22,1,.36,1) infinite}

.stage-once-a .p1,.stage-once-b .p1{animation:puffOnceC1 .88s cubic-bezier(.215,.61,.355,1) forwards}
.stage-once-a .p2,.stage-once-b .p2{animation:puffOnceC2 .94s cubic-bezier(.215,.61,.355,1) .03s forwards}
.stage-once-a .p3,.stage-once-b .p3{animation:puffOnceC3 .86s cubic-bezier(.215,.61,.355,1) .05s forwards}
.stage-once-a .p4,.stage-once-b .p4{animation:puffOnceC4 .98s cubic-bezier(.215,.61,.355,1) .02s forwards}
.stage-once-a .p5,.stage-once-b .p5{animation:puffOnceC5 .92s cubic-bezier(.215,.61,.355,1) .06s forwards}
.stage-once-a .p6,.stage-once-b .p6{animation:puffOnceC6 .96s cubic-bezier(.215,.61,.355,1) .04s forwards}
.stage-once-a .p7,.stage-once-b .p7{animation:puffOnceC7 .90s cubic-bezier(.215,.61,.355,1) .07s forwards}
.stage-once-a .u-icon,.stage-once-b .u-icon{animation:iconOnceC 1.4s cubic-bezier(.22,1,.36,1) forwards}
.stage-once-a .s-wave,.stage-once-b .s-wave{stroke-dasharray:640;animation:waveOnceC 1.75s cubic-bezier(.22,1,.36,1) forwards}
.stage-once-a .s-crown,.stage-once-b .s-crown{stroke-dasharray:420;animation:crownOnceC 1.88s cubic-bezier(.22,1,.36,1) forwards}

/* 单步定格模式 */
.stage-step1 .p1{transform:translate(-42px,-24px) scale(.88);opacity:.9}
.stage-step1 .p2{transform:translate(-20px,-42px) scale(.96);opacity:.92}
.stage-step1 .p3{transform:translate(10px,-46px) scale(.88);opacity:.9}
.stage-step1 .p4{transform:translate(40px,-28px) scale(.92);opacity:.9}
.stage-step1 .p5{transform:translate(46px,6px) scale(.84);opacity:.85}
.stage-step1 .p6{transform:translate(-44px,14px) scale(.86);opacity:.86}
.stage-step1 .p7{transform:translate(24px,30px) scale(.84);opacity:.86}
.stage-step1 .u-icon{transform:scale(0);opacity:0}
.stage-step1 .s-wave,.stage-step1 .s-crown{opacity:0}

.stage-step2 .p1,.stage-step2 .p2,.stage-step2 .p3,.stage-step2 .p4,.stage-step2 .p5,.stage-step2 .p6,.stage-step2 .p7{opacity:0}
.stage-step2 .u-icon{transform:scale(1);opacity:1}
.stage-step2 .s-wave,.stage-step2 .s-crown{opacity:0}

.stage-step3 .p1,.stage-step3 .p2,.stage-step3 .p3,.stage-step3 .p4,.stage-step3 .p5,.stage-step3 .p6,.stage-step3 .p7{opacity:0}
.stage-step3 .u-icon{transform:scale(1);opacity:1}
.stage-step3 .s-wave,.stage-step3 .s-crown{stroke-dasharray:none;stroke-dashoffset:0;opacity:1}

/* ===== 鼠标悬停 Duo 双色动画 ===== */
.duo-btn{
  background:#ffffff;
  border:2px solid #dcdcdc;
  color:#52514e;
  transition:background-color .22s cubic-bezier(.22,1,.36,1),border-color .22s cubic-bezier(.22,1,.36,1),box-shadow .22s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-fill-box{
  fill:#c9d8f3;
  opacity:0;
  transform:scale(.45);
  transform-origin:12px 12px;
  transition:opacity .24s cubic-bezier(.22,1,.36,1),transform .28s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-fill-wing{
  fill:#c9d8f3;
  opacity:0;
  transform:translateY(-2px) scale(.6);
  transform-origin:12px 12.5px;
  transition:opacity .22s cubic-bezier(.22,1,.36,1),transform .26s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-line{
  stroke:#52514e;
  transition:stroke .2s ease,transform .26s cubic-bezier(.22,1,.36,1);
}
.duo-btn .duo-accent{
  stroke:#52514e;
  transition:stroke .2s ease;
}
.duo-btn .duo-dot{
  background:#547dd0;
  transition:transform .24s cubic-bezier(.22,1,.36,1),background-color .2s ease,box-shadow .2s ease;
}

.duo-btn:hover,.force-duo .duo-btn{
  background:#eef3fc;
  border-color:#547dd0;
  box-shadow:0 10px 26px rgba(84,125,208,0.22);
}
.duo-btn:hover .duo-fill-box,.force-duo .duo-btn .duo-fill-box{
  opacity:1;
  transform:scale(1);
}
.duo-btn:hover .duo-fill-wing,.force-duo .duo-btn .duo-fill-wing{
  opacity:1;
  transform:translateY(1px) scale(1);
}
.duo-btn:hover .duo-line,.force-duo .duo-btn .duo-line{
  stroke:#1f1e1d;
  transform:translateY(1px);
}
.duo-btn:hover .duo-accent,.force-duo .duo-btn .duo-accent{
  stroke:#547dd0;
}
.duo-btn:hover .duo-dot,.force-duo .duo-btn .duo-dot{
  background:#2f5ec4;
  transform:scale(1.18);
  box-shadow:0 0 0 3px #c9d8f3;
}

.puff-fill{position:absolute;top:50%;left:50%;border-radius:50%;background:#c9d8f3;box-shadow:inset 0 0 0 1.5px #547dd0;pointer-events:none}
.puff-acc{position:absolute;top:50%;left:50%;border-radius:50%;background:rgba(84,125,208,0.26);box-shadow:inset 0 0 0 1.5px #20242c;pointer-events:none}
.ctrl-btn{height:32px;padding:0 12px;border-radius:8px;border:1px solid #d5dbe3;background:#ffffff;color:#20242c;font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:6px}
.ctrl-btn:hover{background:#eef3fc;border-color:#547dd0}
.ctrl-btn-active{height:32px;padding:0 12px;border-radius:8px;border:1px solid #476ec2;background:#e5edfc;color:#1d3f8a;font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:6px}
</style>
</helmet>

<div class="{{hoverWrapClass}}" style="width:840px;height:680px;box-sizing:border-box;padding:22px 26px;background:#f4f5f7;font-family:-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;color:#20242c;display:flex;flex-direction:column;gap:14px;{{durVar}}">

  <!-- 顶部标题与交互控制栏 -->
  <header style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">
    <h1 style="margin:0;font-size:18px;line-height:26px;font-weight:600;color:#20242c">方案 C · 双层气泡 + 图标显影 + 交叉波浪涂鸦线（悬停 Duo 双色）</h1>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
      <button type="button" class="ctrl-btn-active" onClick="{{triggerOnce}}">单次重播</button>
      <button type="button" class="{{loopBtnClass}}" onClick="{{setLoopMode}}">循环演示</button>
      <button type="button" class="{{duoBtnClass}}" onClick="{{toggleDuoHover}}">{{duoBtnLabel}}</button>
      <button type="button" class="{{slowBtnClass}}" onClick="{{toggleSlow}}">{{slowLabel}}</button>
    </div>
  </header>

  <!-- 三步拆解可交互切换条 -->
  <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px">
    <button type="button" onClick="{{showStep1}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step1Bd}};background:{{step1Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">1. 气泡动画先出来</span>
      <span style="font-size:14px;color:#526071">双层双色气泡簇率先向外扩散</span>
    </button>
    <button type="button" onClick="{{showStep2}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step2Bd}};background:{{step2Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">2. 显现图标（悬停变双色）</span>
      <span style="font-size:14px;color:#526071">常态单色，移入绽放圆角语义衬块与强调蓝</span>
    </button>
    <button type="button" onClick="{{showStep3}}" style="padding:9px 12px;border-radius:10px;border:1px solid {{step3Bd}};background:{{step3Bg}};text-align:left;display:flex;flex-direction:column;gap:3px">
      <span style="font-size:14px;font-weight:600;color:#1d3f8a">3. 接着乱糟糟线条动画</span>
      <span style="font-size:14px;color:#526071">底部双色来回乱涂波浪与角标抓线</span>
    </button>
  </div>

  <!-- 中央 3 倍放大交互特写舞台 -->
  <div class="{{stageClass}}" style="flex:1;min-height:0;border-radius:14px;background:#ffffff;border:1px solid #e4e6ea;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative;overflow:hidden">

    <div style="position:absolute;top:14px;left:16px;display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:10px;background:#f8f9fb;border:1px solid #e4e6ea">
      <div style="display:flex;align-items:center;gap:6px">
        <span style="width:14px;height:14px;border-radius:4px;border:1.5px solid #52514e;display:inline-block"></span>
        <span style="font-size:14px;color:#526071">常态：单色线稿</span>
      </div>
      <span style="font-size:14px;color:#9aa5b4">→</span>
      <div style="display:flex;align-items:center;gap:6px">
        <span style="width:14px;height:14px;border-radius:4px;background:#c9d8f3;border:1.5px solid #20242c;box-shadow:inset 0 -3px 0 #547dd0;display:inline-block"></span>
        <span style="font-size:14px;font-weight:500;color:#20242c">鼠标移上去：#c9d8f3 语义面 + #547dd0 双色动效</span>
      </div>
    </div>

    <div style="position:relative;width:240px;height:200px;display:flex;align-items:center;justify-content:center;margin-top:-10px">
      <!-- 第 1 步：7 颗 Duo 双色气泡 -->
      <div aria-hidden="true" style="position:absolute;inset:0;pointer-events:none">
        <span class="puff-fill p1" style="width:28px;height:28px;margin-left:-14px;margin-top:-14px"></span>
        <span class="puff-acc p2" style="width:42px;height:42px;margin-left:-21px;margin-top:-21px"></span>
        <span class="puff-fill p3" style="width:24px;height:24px;margin-left:-12px;margin-top:-12px"></span>
        <span class="puff-acc p4" style="width:36px;height:36px;margin-left:-18px;margin-top:-18px"></span>
        <span class="puff-fill p5" style="width:22px;height:22px;margin-left:-11px;margin-top:-11px"></span>
        <span class="puff-acc p6" style="width:32px;height:32px;margin-left:-16px;margin-top:-16px"></span>
        <span class="puff-fill p7" style="width:26px;height:26px;margin-left:-13px;margin-top:-13px"></span>
      </div>

      <!-- 第 3 步：双色底部来回乱涂交叉波浪涂鸦线 + 右上角星芒乱抓线 -->
      <svg width="240" height="210" viewBox="0 0 240 210" fill="none" aria-hidden="true" style="position:absolute;left:0;top:-5px;pointer-events:none;overflow:visible">
        <path class="s-wave" d="M 42 152 Q 86 138 196 148 L 52 162 Q 124 150 188 166" stroke="#c9d8f3" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round"></path>
        <path class="s-wave" d="M 42 152 Q 86 138 196 148 L 52 162 Q 124 150 188 166 L 64 174 Q 118 168 172 178" stroke="#547dd0" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
        <path class="s-crown" d="M 148 48 C 166 20, 206 32, 174 58 C 148 78, 214 54, 192 80 C 172 102, 216 86, 186 106 M 48 64 C 24 46, 66 28, 38 78 C 18 108, 56 88, 34 114" stroke="#20242c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>

      <!-- 第 2 步：支持鼠标悬停双色动画的更新图标本体 -->
      <button type="button" onClick="{{triggerOnce}}" class="u-icon duo-btn" style="width:78px;height:78px;border-radius:18px;display:flex;align-items:center;justify-content:center;position:relative;padding:0">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect class="duo-fill-box" x="4.5" y="4.5" width="15" height="15" rx="3.5"></rect>
          <path class="duo-fill-wing" d="M7.5 10.5L12 15L16.5 10.5Z"></path>
          <g class="duo-line" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4.5V15"></path>
            <path d="M7.5 10.5L12 15L16.5 10.5"></path>
          </g>
          <path class="duo-accent" d="M5.5 19.5H18.5" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
        <span class="duo-dot" aria-hidden="true" style="position:absolute;top:8px;right:8px;width:11px;height:11px;border-radius:6px"></span>
      </button>
    </div>

    <!-- 底部 1:1 真实侧栏底栏尺寸同步预览 -->
    <div style="position:absolute;bottom:14px;left:20px;right:20px;display:flex;align-items:center;justify-content:space-between;padding:10px 16px;background:#fafafa;border:1px solid #e4e6ea;border-radius:10px">
      <span style="font-size:14px;color:#526071">请把鼠标移到中央大图标或右侧 1:1 底栏图标上，体验 Duo 双色悬停动效</span>
      <div style="width:236px;padding:6px 8px;background:#ffffff;border:1px solid #e4e6ea;border-radius:8px;display:flex;align-items:center;gap:6px">
        <span style="flex:1;font-size:14px;font-weight:500;color:#20242c;padding-left:4px">本地笔记</span>
        <div style="position:relative;width:30px;height:30px;display:flex;align-items:center;justify-content:center">
          <svg width="60" height="54" viewBox="0 0 240 210" fill="none" aria-hidden="true" style="position:absolute;left:-15px;top:-12px;pointer-events:none">
            <path class="s-wave" d="M 42 152 Q 86 138 196 148 L 52 162" stroke="#c9d8f3" stroke-width="11" stroke-linecap="round"></path>
            <path class="s-wave" d="M 42 152 Q 86 138 196 148 L 52 162 Q 124 150 188 166" stroke="#547dd0" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
            <path class="s-crown" d="M 148 48 C 166 20, 206 32, 174 58" stroke="#20242c" stroke-width="4.5" stroke-linecap="round"></path>
          </svg>
          <button type="button" onClick="{{triggerOnce}}" class="u-icon duo-btn" style="width:30px;height:30px;border-radius:6px;border-width:1px;display:flex;align-items:center;justify-content:center;position:relative;padding:0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect class="duo-fill-box" x="4.5" y="4.5" width="15" height="15" rx="3.5"></rect>
              <path class="duo-fill-wing" d="M7.5 10.5L12 15L16.5 10.5Z"></path>
              <g class="duo-line" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 4.5V15"></path>
                <path d="M7.5 10.5L12 15L16.5 10.5"></path>
              </g>
              <path class="duo-accent" d="M5.5 19.5H18.5" stroke-width="1.65" stroke-linecap="round"></path>
            </svg>
            <span class="duo-dot" aria-hidden="true" style="position:absolute;top:3px;right:3px;width:5px;height:5px;border-radius:3px"></span>
          </button>
        </div>
        <div style="width:1px;height:16px;background:#e4e6ea"></div>
        <div style="width:30px;height:30px;display:flex;align-items:center;justify-content:center;color:#526071">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5H20M4 12H20M4 17.5H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
