<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>行内代码 Notion 风格 A · 经典暖灰底朱砂红字</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..600&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap">
<style>
body{margin:0}
a{color:#547dd0}a:hover{color:#3d63b0}
*{box-sizing:border-box}
.art{--bg:#f8f8f8;--card:#ffffff;--bd:#e4e6ea;--t1:#20242c;--t2:#526071;--ed:#1f1e1d;--acc:#547dd0;--sel:#cde2fb;--selt:#184f95;--shell:#f1f1f1;--on:#e5edfc;
  --cbg:rgba(135,131,120,0.15);--ct:#EB5757;--chov:rgba(135,131,120,0.22);--cedit:rgba(135,131,120,0.24);--tip:#20242c;--tipt:#ffffff;--sub:#f7f7f5;
  font-family:Inter,-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;color:var(--t1);background:var(--bg);font-size:14px;line-height:20px;-webkit-font-smoothing:antialiased}
.art.dark{--bg:#181818;--card:#222222;--bd:#2e2e2e;--t1:#ececec;--t2:#b4b4b4;--ed:#ececec;--acc:#779de8;--sel:#2d426b;--selt:#9dbcf5;--shell:#343434;--on:#343434;
  --cbg:rgba(255,255,255,0.094);--ct:#FF7369;--chov:rgba(255,255,255,0.14);--cedit:rgba(255,255,255,0.15);--tip:#ececec;--tipt:#181818;--sub:#1c1c1c}
.seg{display:inline-flex;gap:2px;padding:3px;border-radius:8px;background:var(--shell);border:1px solid var(--bd)}
.seg button{height:30px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:var(--t2);font:inherit;font-weight:460;cursor:pointer}
.seg button.on{background:var(--on);color:var(--t1);box-shadow:inset 0 0 0 1px var(--acc)}
.card{background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:18px 20px;display:flex;flex-direction:column;gap:14px;min-width:0}
.lab{font-size:15px;line-height:22px;font-weight:560}
.ed{font-size:16px;line-height:24px;color:var(--ed)}
.row{position:relative;white-space:nowrap;height:24px;line-height:24px}
.g{position:absolute;left:-8px;right:-8px;height:0;border-top:1px dashed var(--acc);opacity:.65}
.c{display:inline-block;vertical-align:middle;height:21px;line-height:21px;margin:0 3px;padding:0 5.5px;border-radius:4px;background:var(--cbg);color:var(--ct);font-family:'JetBrains Mono',SFMono-Regular,Menlo,Consolas,ui-monospace,monospace;font-size:13.6px;position:relative;white-space:nowrap}
.c.hov{background:var(--chov)}
.c.edit{background:var(--cedit)}
.c.all{background:var(--sel);color:var(--ct)}
.c.jl{margin-left:0;border-top-left-radius:0;border-bottom-left-radius:0}.c.jr{margin-right:0;border-top-right-radius:0;border-bottom-right-radius:0}
.c .s{height:21px;line-height:21px;color:var(--ct)}
.c .s.end{margin-right:-5.5px;padding-right:5.5px;border-radius:2px 4px 4px 2px}
.s{display:inline-block;vertical-align:middle;height:21px;line-height:21px;background:var(--sel);color:var(--selt);border-radius:2px}
.s.jr{padding-right:3px;border-top-right-radius:0;border-bottom-right-radius:0}
.s.jl{padding-left:3px;border-top-left-radius:0;border-bottom-left-radius:0}
.k{display:inline-block;vertical-align:middle;width:1.5px;height:18px;background:var(--acc);margin:0 -0.75px}
.tip{position:absolute;left:50%;bottom:calc(100% + 6px);transform:translateX(-50%);padding:4px 8px;border-radius:6px;background:var(--tip);color:var(--tipt);font-family:Inter,'PingFang SC',sans-serif;font-size:14px;line-height:20px;white-space:nowrap}
.h2{font-size:22px;line-height:29px;font-weight:600;color:var(--ed)}
.h2 .c{height:27px;line-height:27px;font-size:18.7px;padding:0 6.5px;border-radius:4px}
table{border-collapse:collapse;width:100%}
td{border:1px solid var(--bd);padding:6px 10px;height:37px}
.spec{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;color:var(--t2)}
.spec b{color:var(--t1);font-weight:500;font-family:'JetBrains Mono',monospace;font-size:13.5px}
</style>
</helmet>

<div class="{{rootCls}}" style="width:100%;min-height:1020px;display:flex;flex-direction:column">
  <header style="height:56px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:0 28px;border-bottom:1px solid var(--bd);background:var(--card)">
    <div style="display:flex;align-items:center;gap:14px">
      <span class="lab">Notion 风格 A（推荐）· 经典原版：无描边暖灰微透底 + #EB5757 朱砂红字 + 4px 圆角</span>
      <span style="color:var(--t2)">1:1 还原 Notion 原生行内代码比例（85% 字号 · 0.2em 0.4em 内距 · 0px 描边）</span>
    </div>
    <div class="seg">
      <button type="button" class="{{lightOn}}" onClick="{{setLight}}">浅色 Light</button>
      <button type="button" class="{{darkOn}}" onClick="{{setDark}}">深色 Dark</button>
    </div>
  </header>

  <main style="max-width:1280px;width:100%;margin:0 auto;padding:24px 28px 36px;display:flex;flex-direction:column;gap:16px">

    <!-- 编辑器真实混排通栏对比 -->
    <section class="card" style="padding:20px 24px">
      <div style="display:flex;align-items:center;justify-content:space-between">
        <span class="lab">标准版心（700px）真实笔记混排预览</span>
        <span style="color:var(--t2)">浅色底 rgba(135,131,120,0.15) 配 #EB5757 · 深色底 rgba(255,255,255,0.094) 配 #FF7369</span>
      </div>
      <div style="max-width:700px;width:100%;margin:0 auto;padding:16px 20px;border-radius:10px;background:var(--sub);border:1px solid var(--bd);display:flex;flex-direction:column;gap:10px" class="ed">
        <div style="display:flex;align-items:center;gap:10px">
          <span style="width:16px;height:16px;border-radius:4px;border:1.5px solid #8a8984;display:inline-block;flex:none"></span>
          <div>格式：邮箱----密码----邮箱<span class="c">client_id</span>----邮箱<span class="c">refresh_token</span></div>
        </div>
        <div style="padding-left:26px">
          当请求携带<span class="c">grant_type=refresh_token</span>时，校验<span class="c">src/editor/inline_code_chip.rs</span>中的<span class="c">code_text_color()</span>与圆角参数<span class="c">px(4.)</span>。
        </div>
      </div>
    </section>

    <!-- 12 宫格全状态矩阵 -->
    <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px">

      <section class="card">
        <span class="lab">常规 · 无描边暖灰柔底</span>
        <div class="ed">请求携带<span class="c">grant_type</span>时，比对<span class="c">client_id</span>与<span class="c">refresh_token</span>。</div>
      </section>

      <section class="card">
        <span class="lab">悬停 · 底色微深 + ⌘ 点击复制</span>
        <div class="ed" style="padding-top:30px">邮箱----<span class="c hov">client_id<span class="tip">⌘ 点击复制</span></span>----邮箱</div>
      </section>

      <section class="card">
        <span class="lab">编辑 · 光标在胶囊内（无外框，底色加深）</span>
        <div class="ed">邮箱----<span class="c edit">client<span class="k"></span>_id</span>----邮箱</div>
        <div class="ed">邮箱----<span class="c edit">client_id<span class="k"></span></span>----邮箱</div>
      </section>

      <section class="card">
        <span class="lab">编辑 · 光标在边界外（恢复常态底色）</span>
        <div class="ed">邮箱----<span class="c">client_id</span><span class="k"></span>----邮箱</div>
        <div class="ed">邮箱----<span class="k"></span><span class="c">client_id</span>----邮箱</div>
      </section>

      <section class="card">
        <span class="lab">部分选中 · 胶囊内满高填充</span>
        <div class="ed row"><span class="g" style="top:1.5px"></span><span class="g" style="top:22.5px"></span>比对<span class="c edit">refresh<span class="s">_token</span></span>的绑定</div>
      </section>

      <section class="card">
        <span class="lab">跨边界选中 · 选区带与胶囊等高无缝拼接</span>
        <div class="ed row"><span class="g" style="top:1.5px"></span><span class="g" style="top:22.5px"></span>比<span class="s jr">对</span><span class="c all jl">refresh_token</span>的绑定</div>
        <div class="ed row"><span class="g" style="top:1.5px"></span><span class="g" style="top:22.5px"></span>比对<span class="c jr">refresh<span class="s end">_token</span></span><span class="s jl">的绑</span>定</div>
      </section>

      <section class="card">
        <span class="lab">整段全选 · 保留朱砂红代码字色</span>
        <div class="ed row"><span class="g" style="top:1.5px"></span><span class="g" style="top:22.5px"></span><span class="s jr">比对</span><span class="c all jl jr">client_id</span><span class="s jl jr">与</span><span class="c all jl jr">refresh_token</span><span class="s jl">的绑定</span></div>
      </section>

      <section class="card">
        <span class="lab">双击选词 · 含下划线整词高亮</span>
        <div class="ed">邮箱----<span class="c all">refresh_token</span>----邮箱</div>
      </section>

      <section class="card">
        <span class="lab">折行 · 断口处 2px 微圆角</span>
        <div class="ed" style="width:250px">打开文件<span class="c" style="border-top-right-radius:2px;border-bottom-right-radius:2px;margin-right:0">src/editor/</span><br><span class="c" style="margin-left:0;border-top-left-radius:2px;border-bottom-left-radius:2px">inline_code.rs</span>查看实现</div>
      </section>

      <section class="card">
        <span class="lab">标题内 · 按字号等比缩放</span>
        <div class="h2">配置<span class="c">client_id</span>字段</div>
        <div class="h2">配置<span class="c all">client_id</span>字段</div>
      </section>

      <section class="card">
        <span class="lab">表格单元格内</span>
        <table class="ed">
          <tr><td>字段</td><td><span class="c" style="margin-left:0">client_id</span></td></tr>
          <tr><td>令牌</td><td><span class="c edit" style="margin-left:0">refresh<span class="s">_token</span></span></td></tr>
        </table>
      </section>

      <section class="card">
        <span class="lab">Notion 原版几何与色值</span>
        <div class="spec">
          <span>字号 / 圆角</span><b>85% (13.6px) · 4px</b>
          <span>浅色底 / 字</span><b>#878378 15% · #EB5757</b>
          <span>深色底 / 字</span><b>#FFFFFF 9.4% · #FF7369</b>
          <span>描边</span><b>0px 无描边（纯色块）</b>
          <span>内距 / 外距</span><b>5.5px / 3px</b>
          <span>胶囊高 / 选区高</span><b>21px = 选区带 21px</b>
        </div>
      </section>

    </div>
  </main>
</div>
</x-dc>

<script type="text/x-dc" data-dc-script data-props='{"$preview":{"width":1440,"height":1020}}'>
class Component extends DCLogic {
  constructor() { super(); this.state = { dark: false }; }
  setLight() { this.setState({ dark: false }); }
  setDark() { this.setState({ dark: true }); }
  renderVals() {
    const d = this.state.dark;
    return { rootCls: d ? 'art dark' : 'art', lightOn: d ? '' : 'on', darkOn: d ? 'on' : '' };
  }
}
</script>
</body>
</html>
