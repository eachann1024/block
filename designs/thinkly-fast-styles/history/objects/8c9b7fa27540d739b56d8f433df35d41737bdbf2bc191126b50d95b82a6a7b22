<helmet>
<style>
body{margin:0}
button{font-family:inherit;cursor:pointer}

/* ===== 方案 B（已选定）：1. 双色气泡向上喷涌 -> 2. 图标跳跃落位常驻 -> 3. 四角双色折返涂鸦乱线团画出后自动消隐 ===== */

/* 大舞台 3x 气泡（单次 A / 单次 B / 循环） */
@keyframes puffOnceA1{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(-58px,-54px) scale(1.06);opacity:0}}
@keyframes puffOnceA2{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(-22px,-76px) scale(1.12);opacity:0}}
@keyframes puffOnceA3{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(24px,-74px) scale(1.02);opacity:0}}
@keyframes puffOnceA4{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(64px,-46px) scale(1.08);opacity:0}}
@keyframes puffOnceA5{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(-70px,-10px) scale(.96);opacity:0}}
@keyframes puffOnceA6{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(72px,4px) scale(.98);opacity:0}}
@keyframes puffOnceA7{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(0px,-88px) scale(.92);opacity:0}}

@keyframes puffOnceB1{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(-58px,-54px) scale(1.06);opacity:0}}
@keyframes puffOnceB2{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(-22px,-76px) scale(1.12);opacity:0}}
@keyframes puffOnceB3{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(24px,-74px) scale(1.02);opacity:0}}
@keyframes puffOnceB4{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(64px,-46px) scale(1.08);opacity:0}}
@keyframes puffOnceB5{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(-70px,-10px) scale(.96);opacity:0}}
@keyframes puffOnceB6{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(72px,4px) scale(.98);opacity:0}}
@keyframes puffOnceB7{0%{transform:translate(0,12px) scale(.18);opacity:0}15%{opacity:.96}100%{transform:translate(0px,-88px) scale(.92);opacity:0}}

/* 1:1 底栏真实尺寸气泡（按比例缩小位移，让底栏也清晰冒出 7 颗双色气泡！） */
@keyframes miniPuffA1{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(-22px,-22px) scale(1);opacity:0}}
@keyframes miniPuffA2{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(-9px,-30px) scale(1.05);opacity:0}}
@keyframes miniPuffA3{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(10px,-29px) scale(1);opacity:0}}
@keyframes miniPuffA4{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(25px,-18px) scale(1.04);opacity:0}}
@keyframes miniPuffA5{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(-27px,-4px) scale(.95);opacity:0}}
@keyframes miniPuffA6{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(28px,2px) scale(.95);opacity:0}}
@keyframes miniPuffA7{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(0px,-34px) scale(.92);opacity:0}}

@keyframes miniPuffB1{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(-22px,-22px) scale(1);opacity:0}}
@keyframes miniPuffB2{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(-9px,-30px) scale(1.05);opacity:0}}
@keyframes miniPuffB3{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(10px,-29px) scale(1);opacity:0}}
@keyframes miniPuffB4{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(25px,-18px) scale(1.04);opacity:0}}
@keyframes miniPuffB5{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(-27px,-4px) scale(.95);opacity:0}}
@keyframes miniPuffB6{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(28px,2px) scale(.95);opacity:0}}
@keyframes miniPuffB7{0%{transform:translate(0,5px) scale(.2);opacity:0}15%{opacity:.96}100%{transform:translate(0px,-34px) scale(.92);opacity:0}}

/* 第 2 步：气泡先出来后，图标跳跃落位并一直常驻显示 */
@keyframes iconOnceA{
  0%,22%{transform:translateY(16px) scale(0);opacity:0}
  42%{transform:translateY(-6px) scale(1.12);opacity:1}
  54%{transform:translateY(1.5px) scale(.97);opacity:1}
  64%,100%{transform:translateY(0) scale(1);opacity:1}
}
@keyframes iconOnceB{
  0%,22%{transform:translateY(16px) scale(0);opacity:0}
  42%{transform:translateY(-6px) scale(1.12);opacity:1}
  54%{transform:translateY(1.5px) scale(.97);opacity:1}
  64%,100%{transform:translateY(0) scale(1);opacity:1}
}

/* 第 3 步：图标出来后，折返涂鸦乱线团高速画出 -> 随后自动隐藏，后续不再显示（100% 处 opacity:0）！ */
@keyframes tangleOnceA{
  0%,36%{stroke-dashoffset:520;opacity:0}
  40%{opacity:1}
  68%{stroke-dashoffset:0;opacity:1}
  80%{stroke-dashoffset:0;opacity:.92}
  98%,100%{stroke-dashoffset:-520;opacity:0}
}
@keyframes tangleOnceB{
  0%,36%{stroke-dashoffset:520;opacity:0}
  40%{opacity:1}
  68%{stroke-dashoffset:0;opacity:1}
  80%{stroke-dashoffset:0;opacity:.92}
  98%,100%{stroke-dashoffset:-520;opacity:0}
}
@keyframes zigOnceA{
  0%,40%{stroke-dashoffset:320;opacity:0}
  44%{opacity:1}
  72%{stroke-dashoffset:0;opacity:1}
  82%{stroke-dashoffset:0;opacity:.88}
  99%,100%{stroke-dashoffset:-320;opacity:0}
}
@keyframes zigOnceB{
  0%,40%{stroke-dashoffset:320;opacity:0}
  44%{opacity:1}
  72%{stroke-dashoffset:0;opacity:1}
  82%{stroke-dashoffset:0;opacity:.88}
  99%,100%{stroke-dashoffset:-320;opacity:0}
}

/* 循环演示模式：同样在画完线条后立刻隐藏线条（62%~94% 仅展示干净图标，无残留线条） */
@keyframes puffLoop1{0%{transform:translate(0,12px) scale(.18);opacity:0}5%{opacity:.96}22%{transform:translate(-58px,-54px) scale(1.06);opacity:0}100%{transform:translate(-58px,-54px) scale(1.06);opacity:0}}
@keyframes puffLoop2{0%,1.5%{transform:translate(0,12px) scale(.18);opacity:0}6%{opacity:.96}24%{transform:translate(-22px,-76px) scale(1.12);opacity:0}100%{transform:translate(-22px,-76px) scale(1.12);opacity:0}}
@keyframes puffLoop3{0%,2.5%{transform:translate(0,12px) scale(.18);opacity:0}7%{opacity:.96}23%{transform:translate(24px,-74px) scale(1.02);opacity:0}100%{transform:translate(24px,-74px) scale(1.02);opacity:0}}
@keyframes puffLoop4{0%,1%{transform:translate(0,12px) scale(.18);opacity:0}5.5%{opacity:.96}25%{transform:translate(64px,-46px) scale(1.08);opacity:0}100%{transform:translate(64px,-46px) scale(1.08);opacity:0}}
@keyframes puffLoop5{0%,3%{transform:translate(0,12px) scale(.18);opacity:0}7.5%{opacity:.96}25%{transform:translate(-70px,-10px) scale(.96);opacity:0}100%{transform:translate(-70px,-10px) scale(.96);opacity:0}}
@keyframes puffLoop6{0%,2%{transform:translate(0,12px) scale(.18);opacity:0}6.5%{opacity:.96}24%{transform:translate(72px,4px) scale(.98);opacity:0}100%{transform:translate(72px,4px) scale(.98);opacity:0}}
@keyframes puffLoop7{0%,3.5%{transform:translate(0,12px) scale(.18);opacity:0}8%{opacity:.96}26%{transform:translate(0px,-88px) scale(.92);opacity:0}100%{transform:translate(0px,-88px) scale(.92);opacity:0}}

@keyframes miniLoop1{0%{transform:translate(0,5px) scale(.2);opacity:0}5%{opacity:.96}22%{transform:translate(-22px,-22px) scale(1);opacity:0}100%{transform:translate(-22px,-22px) scale(1);opacity:0}}
@keyframes miniLoop2{0%,1.5%{transform:translate(0,5px) scale(.2);opacity:0}6%{opacity:.96}24%{transform:translate(-9px,-30px) scale(1.05);opacity:0}100%{transform:translate(-9px,-30px) scale(1.05);opacity:0}}
@keyframes miniLoop3{0%,2.5%{transform:translate(0,5px) scale(.2);opacity:0}7%{opacity:.96}23%{transform:translate(10px,-29px) scale(1);opacity:0}100%{transform:translate(10px,-29px) scale(1);opacity:0}}
@keyframes miniLoop4{0%,1%{transform:translate(0,5px) scale(.2);opacity:0}5.5%{opacity:.96}25%{transform:translate(25px,-18px) scale(1.04);opacity:0}100%{transform:translate(25px,-18px) scale(1.04);opacity:0}}
@keyframes miniLoop5{0%,3%{transform:translate(0,5px) scale(.2);opacity:0}7.5%{opacity:.96}25%{transform:translate(-27px,-4px) scale(.95);opacity:0}100%{transform:translate(-27px,-4px) scale(.95);opacity:0}}
@keyframes miniLoop6{0%,2%{transform:translate(0,5px) scale(.2);opacity:0}6.5%{opacity:.96}24%{transform:translate(28px,2px) scale(.95);opacity:0}100%{transform:translate(28px,2px) scale(.95);opacity:0}}
@keyframes miniLoop7{0%,3.5%{transform:translate(0,5px) scale(.2);opacity:0}8%{opacity:.96}26%{transform:translate(0px,-34px) scale(.92);opacity:0}100%{transform:translate(0px,-34px) scale(.92);opacity:0}}

@keyframes iconLoopB{
  0%,14%{transform:translateY(16px) scale(0);opacity:0}
  23%{transform:translateY(-6px) scale(1.12);opacity:1}
  28%{transform:translateY(1.5px) scale(.97);opacity:1}
  33%,92%{transform:translateY(0) scale(1);opacity:1}
  97%,100%{transform:translateY(8px) scale(0);opacity:0}
}
@keyframes tangleLoopB{
  0%,28%{stroke-dashoffset:520;opacity:0}
  31%{opacity:1}
  48%{stroke-dashoffset:0;opacity:1}
  55%{stroke-dashoffset:0;opacity:.9}
  64%,100%{stroke-dashoffset:-520;opacity:0}
}
@keyframes zigLoopB{
  0%,31%{stroke-dashoffset:320;opacity:0}
  34%{opacity:1}
  51%{stroke-dashoffset:0;opacity:1}
  57%{stroke-dashoffset:0;opacity:.85}
  66%,100%{stroke-dashoffset:-320;opacity:0}
}

