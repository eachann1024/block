<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>标注与斜杠 AI 方案 A（推荐）· 左侧语义图标弹层切换 + 360px 无头紧凑双层 AI 浮条</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<style>
body{margin:0;font-family:-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;color:#20242c;background:#f1f1f1;-webkit-font-smoothing:antialiased}
a{color:#3d63b0}a:hover{color:#2c4c8c}
button,input{font-family:inherit;font-size:14px;line-height:20px}
*{box-sizing:border-box}
::selection{background:#cde2fb;color:#184f95}
.seg-btn{height:30px;padding:4px 12px;border:0;border-radius:6px;background:transparent;color:#526071;font-size:14px;font-weight:460;cursor:pointer}
.seg-btn:hover{color:#20242c}
.icon-trig{width:28px;height:28px;border:1px solid transparent;border-radius:6px;background:transparent;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;padding:4px;flex:none}
.icon-trig:hover{background:rgba(255,255,255,0.75);border-color:#dcdcdc}
.act-chip{height:28px;padding:4px 10px;border:1px solid #dcdcdc;border-radius:6px;background:#ffffff;color:#526071;font-size:14px;display:inline-flex;align-items:center;gap:4px;cursor:pointer}
.act-chip:hover{background:#eef3fc;color:#20242c;border-color:#547dd0}
.menu-item{width:100%;height:32px;padding:6px 10px;border:0;border-radius:6px;background:transparent;color:#20242c;display:flex;align-items:center;gap:8px;font-size:14px;text-align:left;cursor:pointer}
.menu-item:hover{background:#eef3fc}
.ai-chip{height:28px;padding:4px 10px;border:0;border-radius:6px;background:transparent;color:#20242c;font-size:14px;font-weight:460;display:inline-flex;align-items:center;gap:5px;cursor:pointer}
.ai-chip:hover{background:#eef3fc}
.ai-primary{height:28px;padding:4px 10px;border:1px solid #547dd0;border-radius:6px;background:#e5edfc;box-shadow:inset 0 0 0 1px #547dd0;color:#20242c;font-size:14px;font-weight:500;display:inline-flex;align-items:center;gap:5px;cursor:pointer}
</style>
</helmet>

<div style="width:100%;min-height:960px;display:flex;flex-direction:column;background:#ffffff;color:#20242c;font-size:14px;line-height:20px">

  <!-- 顶部演示切换栏 -->
  <div style="min-height:48px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:8px 20px;background:#fafafa;border-bottom:1px solid #e6e6e6">
    <div style="display:flex;align-items:center;gap:12px">
      <span style="font-weight:560;color:#20242c">方案 A（推荐）· 左侧语义图标点击弹五态菜单 + 360px 紧凑无头 AI 浮条</span>
      <span style="color:#526071">点击标注块左侧图标切换类型，切换右侧状态预览紧凑斜杠 AI</span>
    </div>
    <div style="display:inline-flex;align-items:center;gap:2px;padding:3px;border-radius:8px;background:#f1f1f1;border:1px solid #dcdcdc">
      <button type="button" class="seg-btn" onClick="{{setAiInput}}" style="background:{{btnInputBg}};color:{{btnInputCol}};box-shadow:{{btnInputRing}}">AI 输入态</button>
      <button type="button" class="seg-btn" onClick="{{setAiThinking}}" style="background:{{btnThinkBg}};color:{{btnThinkCol}};box-shadow:{{btnThinkRing}}">AI 生成中</button>
      <button type="button" class="seg-btn" onClick="{{setAiReview}}" style="background:{{btnReviewBg}};color:{{btnReviewCol}};box-shadow:{{btnReviewRing}}">AI 审阅态</button>
    </div>
  </div>

  <!-- 模拟主窗口顶栏 -->
  <header style="min-height:44px;flex:none;display:flex;align-items:center;background:#f1f1f1;border-bottom:1px solid #e6e6e6">
    <div style="width:260px;flex:none;display:flex;align-items:center;justify-content:space-between;padding:8px 12px 8px 14px;border-right:1px solid #e6e6e6">
      <div aria-hidden="true" style="display:flex;align-items:center;gap:8px">
        <span style="width:12px;height:12px;border-radius:6px;background:#ff5f57;display:inline-block"></span>
        <span style="width:12px;height:12px;border-radius:6px;background:#febc2e;display:inline-block"></span>
        <span style="width:12px;height:12px;border-radius:6px;background:#28c840;display:inline-block"></span>
      </div>
      <span style="color:#526071;font-weight:500">工作区笔记</span>
    </div>
    <div style="flex:1;display:flex;align-items:center;justify-content:space-between;padding:8px 16px">
      <div style="padding:4px 12px;border-radius:6px;background:#ffffff;border:1px solid #e4e6ea;display:inline-flex;align-items:center;gap:8px;color:#20242c;font-weight:500">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.5 2.5h6l3 3v8h-9v-11z" fill="#c9d8f3" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path><path d="M5.5 8h5M5.5 10.5h3.5" stroke="#547dd0" stroke-width="1.4" stroke-linecap="round"></path></svg>
        <span>架构设计与发布检查清单</span>
      </div>
      <span style="color:#526071">标准版心 672px</span>
    </div>
  </header>

  <!-- 主工作区 -->
  <div style="flex:1;min-height:0;display:flex">
    <!-- 左侧栏 -->
    <aside style="width:260px;flex:none;background:#fafafa;border-right:1px solid #e6e6e6;padding:12px 10px;display:flex;flex-direction:column;gap:4px">
      <div style="padding:6px 10px;border-radius:8px;background:#e5edfc;box-shadow:inset 0 0 0 1px #547dd0;display:flex;align-items:center;justify-content:space-between;color:#20242c;font-weight:500">
        <span>架构设计与发布检查清单</span>
      </div>
      <div style="padding:6px 10px;border-radius:8px;display:flex;align-items:center;color:#526071">接口幂等与重试约定</div>
      <div style="padding:6px 10px;border-radius:8px;display:flex;align-items:center;color:#526071">本地存储迁移方案</div>
    </aside>

    <!-- 正文编辑区 -->
    <main style="flex:1;min-width:0;background:#ffffff;padding:36px 48px;display:flex;justify-content:center;overflow-y:auto">
      <article style="width:100%;max-width:672px;display:flex;flex-direction:column;gap:16px;font-size:16px;line-height:28px;color:#1f1e1d">

        <h1 style="margin:0;font-size:28px;line-height:36px;font-weight:600;color:#20242c">架构设计与发布检查清单</h1>

        <!-- 交互式标注块 1（主交互焦点：可点击图标弹五态菜单 + 右上角悬停动作） -->
        <div style="position:relative;border-radius:8px;background:{{c1Bg}};border:1px solid {{c1Border}};padding:12px 16px 12px 46px">
          <button type="button" class="icon-trig" onClick="{{toggleCalloutMenu}}" aria-label="切换标注类型" style="position:absolute;left:10px;top:11px">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" fill="{{c1IconFill}}" stroke="{{c1Accent}}" stroke-width="1.6"></rect>
              <path d="M12 8v4.5M12 16h.01" stroke="{{c1Accent}}" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </button>

          <!-- 右上角轻量悬停操作条 -->
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:4px">
            <button type="button" onClick="{{toggleCalloutMenu}}" style="border:0;background:transparent;padding:0;color:{{c1Text}};font-size:14px;font-weight:560;display:inline-flex;align-items:center;gap:4px;cursor:pointer">
              <span>{{c1Label}}</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
            </button>
            <div style="display:inline-flex;align-items:center;gap:6px">
              <button type="button" class="act-chip" onClick="{{copyCallout}}">
                <span>{{copyLabel}}</span>
              </button>
              <button type="button" class="act-chip" onClick="{{cycleCallout}}">
                <span>切换类型</span>
              </button>
            </div>
          </div>

          <div style="color:#1f1e1d;font-size:16px;line-height:26px">{{c1Body}}</div>

          <!-- 点击左侧图标或类型名弹出的五态语义选择菜单 -->
          <sc-if value="{{calloutMenuOpen}}" hint-placeholder-val="{{true}}">
            <div role="menu" aria-label="标注类型菜单" style="position:absolute;left:10px;top:42px;z-index:20;width:196px;padding:5px;background:#ffffff;border:1px solid #e4e6ea;border-radius:10px;box-shadow:0 10px 28px rgba(32,36,44,0.12);display:flex;flex-direction:column;gap:2px">
              <sc-for list="{{calloutTypes}}" as="item" hint-placeholder-count="5">
                <button type="button" class="menu-item" onClick="{{item.pick}}" style="background:{{item.bg}};box-shadow:{{item.ring}};font-weight:{{item.weight}}">
                  <span style="width:10px;height:10px;border-radius:5px;background:{{item.dot}};border:1px solid {{item.border}};flex:none"></span>
                  <span style="flex:1">{{item.name}}</span>
                  <span style="color:#526071;font-family:'JetBrains Mono',monospace;font-size:14px">{{item.tag}}</span>
                </button>
              </sc-for>
              <div style="height:1px;background:#e4e6ea;margin:3px 4px"></div>
              <button type="button" class="menu-item" onClick="{{toggleCalloutMenu}}" style="color:#526071">
                <span>转为普通正文</span>
              </button>
            </div>
          </sc-if>
        </div>

        <!-- 第二条标注示例（展示警告态） -->
        <div style="position:relative;border-radius:8px;background:#fdf5e8;border:1px solid #edd4a8;padding:12px 16px 12px 46px">
          <span style="position:absolute;left:14px;top:14px;display:inline-flex">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 4L3.5 19h17L12 4z" fill="#f7e2be" stroke="#b86b11" stroke-width="1.6" stroke-linejoin="round"></path>
              <path d="M12 10v4M12 16.5h.01" stroke="#b86b11" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </span>
          <div style="color:#1f1e1d;font-size:16px;line-height:26px">灰度期间请保持旧版快照可读，待全量验证通过后再清理冗余索引。</div>
        </div>

        <!-- 下半区：触发斜杠 AI 写作后的目标段落 + 360px 紧凑无头 AI 浮条 -->
        <div style="margin-top:8px;position:relative">
          <div style="padding:10px 14px;border-radius:8px;background:#eef3fc;box-shadow:inset 0 0 0 1px #547dd0;color:#1f1e1d">
            <sc-if value="{{isReview}}" hint-placeholder-val="{{false}}">
              <span>发布前需核对 <span style="background:#fbe9e7;color:#b42318;text-decoration:line-through;padding:2px 6px;border-radius:4px">所有零散配置项</span> <span style="background:#e3f6ec;color:#087443;padding:2px 6px;border-radius:4px">核心环境变量与回滚开关</span>，确保无遗漏。</span>
            </sc-if>
            <sc-if value="{{notReview}}" hint-placeholder-val="{{true}}">
              <span>发布前需核对所有零散配置项，确保数据库迁移脚本与回滚开关均已就绪。</span>
            </sc-if>
          </div>

          <!-- 360px 紧凑无头斜杠 AI 浮条（从原 460px 大卡片精简为 360px 紧凑双层浮条） -->
          <div role="dialog" aria-label="AI 写作" style="margin-top:8px;width:360px;padding:10px;border-radius:10px;background:#ffffff;border:1px solid #e4e6ea;box-shadow:0 10px 28px rgba(32,36,44,0.12);display:flex;flex-direction:column;gap:8px;position:relative">

            <!-- 第一层：34px 紧凑输入舱（或生成中单行脉冲条） -->
            <sc-if value="{{isThinking}}" hint-placeholder-val="{{false}}">
              <div style="padding:8px 12px;border-radius:8px;background:#f8f8f8;border:1px solid #e4e6ea;display:flex;align-items:center;gap:8px">
                <span style="width:8px;height:8px;border-radius:4px;background:#547dd0;flex:none"></span>
                <span style="flex:1;color:#526071;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">正在精简并提炼关键检查项…</span>
                <button type="button" class="ai-chip" onClick="{{setAiInput}}" style="padding:4px 8px;color:#526071">停止</button>
              </div>
            </sc-if>

            <sc-if value="{{notThinking}}" hint-placeholder-val="{{true}}">
              <div style="padding:6px 8px 6px 10px;border-radius:8px;background:#f8f8f8;border:1px solid #dcdcdc;display:flex;align-items:center;gap:8px">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none">
                  <path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2L12 3z" fill="#c9d8f3" stroke="#547dd0" stroke-width="1.6" stroke-linejoin="round"></path>
                </svg>
                <label style="flex:1;min-width:0;display:flex;align-items:center">
                  <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">AI 指令输入</span>
                  <input value="{{aiPromptVal}}" placeholder="{{aiPlaceholder}}" readonly="readonly" style="width:100%;border:0;outline:0;background:transparent;color:#20242c;font-size:14px">
                </label>
                <button type="button" onClick="{{setAiReview}}" aria-label="发送指令" style="width:24px;height:24px;border:0;border-radius:6px;background:#3d63b0;color:#ffffff;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;flex:none">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5"></path></svg>
                </button>
              </div>
            </sc-if>

            <!-- 第二层：28px 轻量预设与审阅动作行（无边框轻按钮 + Ocean Paper 选中态） -->
            <sc-if value="{{isInput}}" hint-placeholder-val="{{true}}">
              <div style="display:flex;align-items:center;gap:4px">
                <button type="button" class="ai-chip" onClick="{{setAiReview}}">润色</button>
                <button type="button" class="ai-chip" onClick="{{setAiReview}}">精简</button>
                <button type="button" class="ai-chip" onClick="{{toggleTransMenu}}" style="background:{{transBtnBg}};box-shadow:{{transBtnRing}}">
                  <span>翻译</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#526071" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                </button>
                <button type="button" class="ai-chip" onClick="{{toggleMoreMenu}}" style="background:{{moreBtnBg}};box-shadow:{{moreBtnRing}}">
                  <span>更多</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#526071" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                </button>
                <span style="flex:1"></span>
                <button type="button" class="ai-chip" aria-label="AI 设置" style="width:28px;padding:4px;justify-content:center;color:#526071">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M2 14h4M10 8h4M18 16h4"></path></svg>
                </button>
              </div>
            </sc-if>

            <sc-if value="{{isReview}}" hint-placeholder-val="{{false}}">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:6px">
                <div style="display:inline-flex;align-items:center;gap:6px">
                  <button type="button" class="ai-primary" onClick="{{setAiInput}}">应用修改</button>
                  <button type="button" class="ai-chip" onClick="{{setAiInput}}">放弃</button>
                  <button type="button" class="ai-chip" onClick="{{setAiThinking}}">重试</button>
                </div>
                <div style="display:inline-flex;align-items:center;gap:6px;font-size:14px">
                  <span style="padding:2px 6px;border-radius:4px;background:#fbe9e7;color:#b42318;text-decoration:line-through">删除</span>
                  <span style="padding:2px 6px;border-radius:4px;background:#e3f6ec;color:#087443">新增</span>
                </div>
              </div>
            </sc-if>

            <!-- 子菜单浮层 -->
            <sc-if value="{{hasSubmenu}}" hint-placeholder-val="{{false}}">
              <div role="menu" aria-label="更多预设指令" style="position:absolute;left:108px;top:76px;z-index:20;width:168px;padding:5px;background:#ffffff;border:1px solid #e4e6ea;border-radius:10px;box-shadow:0 10px 28px rgba(32,36,44,0.12);display:flex;flex-direction:column;gap:2px">
                <sc-for list="{{submenuItems}}" as="sub" hint-placeholder-count="2">
                  <button type="button" class="menu-item" onClick="{{setAiReview}}">{{sub.label}}</button>
                </sc-for>
              </div>
            </sc-if>

          </div>
        </div>

      </article>
    </main>
  </div>
</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"$preview":{"width":1440,"height":960}}'>
class Component extends DCLogic {
  constructor(p) {
    super(p);
    this.state = {
      calloutIdx: 0,
      calloutMenuOpen: true,
      copied: false,
      aiState: 'input',
      subMenu: 'none'
    };
  }
  renderVals() {
    const types = [
      { name: '提示', tag: 'NOTE', bg: '#eef3fc', border: '#c9d8f3', accent: '#547dd0', iconFill: '#dce7fa', text: '#2c4c8c', body: '默认采用 1px 语义细描边与柔蓝纸面底，点击左上角图标可即时切换五种标注语义或还原为正文。' },
      { name: '技巧', tag: 'TIP', bg: '#edf7f2', border: '#bce3cf', accent: '#1f8a5b', iconFill: '#d3efe1', text: '#166541', body: '技巧标注用于记录高价值的快捷键或工作流经验，保持清爽的鼠尾草绿语义细框。' },
      { name: '重要', tag: 'IMPORTANT', bg: '#f3f0fb', border: '#d6ccf2', accent: '#6e56cf', iconFill: '#e4ddf8', text: '#4c389e', body: '重要标注用于标示架构核心约束与关键前置条件，与普通引用块清晰区分。' },
      { name: '警告', tag: 'WARNING', bg: '#fdf5e8', border: '#edd4a8', accent: '#b86b11', iconFill: '#f7e2be', text: '#8a4e08', body: '警告标注用于提示潜在的兼容性变更与参数边界，采用温和琥珀纸面色。' },
      { name: '注意', tag: 'CAUTION', bg: '#fceeee', border: '#f1c4c4', accent: '#c93b3b', iconFill: '#f8dada', text: '#962727', body: '注意标注用于不可逆删除或线上高风险操作提醒，醒目但不刺眼。' }
    ];
    const calloutIdx = this.state.calloutIdx ?? 0;
    const calloutMenuOpen = Boolean(this.state.calloutMenuOpen);
    const copied = Boolean(this.state.copied);
    const aiState = this.state.aiState ?? 'input';
    const subMenu = this.state.subMenu ?? 'none';
    const cur = types[calloutIdx] || types[0];
    const calloutTypes = types.map((t, idx) => ({
      name: t.name,
      tag: t.tag,
      dot: t.bg,
      border: t.accent,
      bg: idx === calloutIdx ? '#e5edfc' : 'transparent',
      ring: idx === calloutIdx ? 'inset 0 0 0 1px #547dd0' : 'none',
      weight: idx === calloutIdx ? '500' : '400',
      pick: () => this.setState({ calloutIdx: idx, calloutMenuOpen: false })
    }));
    const isInput = aiState === 'input';
    const isThinking = aiState === 'thinking';
    const isReview = aiState === 'review';
    const submenuItems = subMenu === 'trans'
      ? [{ label: '翻译成英文' }, { label: '翻译成中文' }]
      : [{ label: '整理为列表' }, { label: '转为待办清单' }, { label: '口语化表达' }];
    return {
      c1Bg: cur.bg,
      c1Border: cur.border,
      c1Accent: cur.accent,
      c1IconFill: cur.iconFill,
      c1Text: cur.text,
      c1Label: cur.name,
      c1Body: cur.body,
      calloutMenuOpen,
      calloutTypes,
      copyLabel: copied ? '已复制' : '复制',
      toggleCalloutMenu: () => this.setState({ calloutMenuOpen: !this.state.calloutMenuOpen }),
      cycleCallout: () => this.setState({ calloutIdx: ((this.state.calloutIdx ?? 0) + 1) % types.length }),
      copyCallout: () => this.setState({ copied: true }),
      isInput,
      isThinking,
      isReview,
      notThinking: !isThinking,
      notReview: !isReview,
      aiPromptVal: isReview ? '' : '提炼为更紧凑的检查项',
      aiPlaceholder: isReview ? '继续输入修改要求…' : '告诉 AI 写什么或如何改写…',
      btnInputBg: isInput ? '#e5edfc' : 'transparent',
      btnInputCol: isInput ? '#20242c' : '#526071',
      btnInputRing: isInput ? 'inset 0 0 0 1px #547dd0' : 'none',
      btnThinkBg: isThinking ? '#e5edfc' : 'transparent',
      btnThinkCol: isThinking ? '#20242c' : '#526071',
      btnThinkRing: isThinking ? 'inset 0 0 0 1px #547dd0' : 'none',
      btnReviewBg: isReview ? '#e5edfc' : 'transparent',
      btnReviewCol: isReview ? '#20242c' : '#526071',
      btnReviewRing: isReview ? 'inset 0 0 0 1px #547dd0' : 'none',
      setAiInput: () => this.setState({ aiState: 'input', subMenu: 'none' }),
      setAiThinking: () => this.setState({ aiState: 'thinking', subMenu: 'none' }),
      setAiReview: () => this.setState({ aiState: 'review', subMenu: 'none' }),
      transBtnBg: subMenu === 'trans' ? '#e5edfc' : 'transparent',
      transBtnRing: subMenu === 'trans' ? 'inset 0 0 0 1px #547dd0' : 'none',
      moreBtnBg: subMenu === 'more' ? '#e5edfc' : 'transparent',
      moreBtnRing: subMenu === 'more' ? 'inset 0 0 0 1px #547dd0' : 'none',
      toggleTransMenu: () => this.setState({ subMenu: this.state.subMenu === 'trans' ? 'none' : 'trans' }),
      toggleMoreMenu: () => this.setState({ subMenu: this.state.subMenu === 'more' ? 'none' : 'more' }),
      hasSubmenu: isInput && subMenu !== 'none',
      submenuItems
    };
  }
}
</script>
</body>
</html>
