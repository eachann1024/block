<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>版本更新 B · 顶栏右上角更新图标 + 锚定式下拉更新面板</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..600&amp;family=JetBrains+Mono:wght@400..500&amp;display=swap">
<style>
body{margin:0}
a{color:#2f5ec4}a:hover{color:#1f4494}
button{font-family:inherit}
.ib{width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:6px;background:transparent;color:#3d4856;padding:0;cursor:pointer;flex:none}
.ib:hover{background:#eef3fc;color:#20242c}
.ib-update{width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #9fb8ea;border-radius:6px;background:#e5edfc;color:#23468c;padding:0;cursor:pointer;flex:none;position:relative;box-sizing:border-box}
.ib-update:hover{background:#d5e3fc;border-color:#547dd0}
.top-act{width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #dcdcdc;border-radius:8px;background:#ffffff;color:#20242c;padding:0;cursor:pointer;flex:none;box-sizing:border-box}
.top-act:hover{background:#eef3fc;border-color:#547dd0}
.row{font:inherit;font-size:14px;line-height:20px;font-weight:400;width:100%;height:32px;display:flex;align-items:center;gap:8px;padding:0 10px;border:0;border-radius:6px;background:transparent;color:#20242c;text-align:left;cursor:pointer;box-sizing:border-box}
.row:hover{background:#eef3fc}
.row-active{font:inherit;font-size:14px;line-height:20px;font-weight:500;width:100%;height:32px;display:flex;align-items:center;gap:8px;padding:0 10px;border:0;border-radius:6px;background:#e5edfc;color:#20242c;box-shadow:inset 0 0 0 1px #547dd0;text-align:left;cursor:pointer;box-sizing:border-box}
.vault-ghost{font:inherit;font-size:14px;line-height:20px;font-weight:500;flex:1;min-width:0;height:30px;padding:0 8px;border-radius:6px;background:transparent;color:#20242c;border:0;display:inline-flex;align-items:center;gap:7px;cursor:pointer;box-sizing:border-box;text-align:left}
.vault-ghost:hover{background:#eef3fc}
.dock-btn{width:30px;height:30px;flex:none;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:6px;background:transparent;color:#3d4856;padding:0;cursor:pointer;box-sizing:border-box}
.dock-btn:hover{background:#eef3fc;color:#20242c}
.btn-secondary{height:34px;padding:0 16px;border-radius:8px;border:1px solid #dcdcdc;background:#ffffff;color:#20242c;font-size:14px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.btn-secondary:hover{background:#f5f6f8}
.btn-primary{height:34px;padding:0 18px;border-radius:8px;border:1px solid #3d63b8;background:#476ec2;color:#ffffff;font-size:14px;font-weight:500;cursor:pointer;display:inline-flex;align-items:center;justify-content:center}
.btn-primary:hover{background:#3b5fb0}
</style>
</helmet>

<div style="width:100%;min-height:900px;position:relative;box-sizing:border-box;display:flex;flex-direction:column;background:#f1f1f1;font-family:Inter,-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;color:#20242c;font-size:14px;line-height:20px;overflow:hidden">

  <header style="height:40px;flex:none;display:flex;align-items:center;border-bottom:1px solid #e6e6e6;box-sizing:border-box;background:#f1f1f1">
    <div style="width:260px;flex:none;height:100%;box-sizing:border-box;display:flex;align-items:center;gap:4px;padding:0 10px 0 16px;border-right:1px solid #e6e6e6">
      <div aria-hidden="true" style="display:flex;gap:8px;flex:none;margin-right:auto">
        <span style="width:12px;height:12px;border-radius:6px;background:#ff5f57"></span>
        <span style="width:12px;height:12px;border-radius:6px;background:#febc2e"></span>
        <span style="width:12px;height:12px;border-radius:6px;background:#28c840"></span>
      </div>
      <button type="button" class="ib" aria-label="{{s.sidebarToggleAria}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.75 4.75H9.25V19.25H5.75A2 2 0 0 1 3.75 17.25V6.75A2 2 0 0 1 5.75 4.75Z" fill="#c9d8f3"></path><rect x="3.75" y="4.75" width="16.5" height="14.5" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M9.25 4.75V19.25" stroke="currentColor" stroke-width="1.5"></path></svg>
      </button>
    </div>

    <nav aria-label="{{s.openTabsAria}}" style="flex:1;min-width:0;height:100%;display:flex;align-items:center;gap:6px;padding:0 12px">
      <button type="button" style="font:inherit;font-size:14px;font-weight:500;height:28px;display:inline-flex;align-items:center;gap:6px;padding:0 10px;border:0;border-radius:6px;background:#e5edfc;color:#20242c;box-shadow:inset 0 0 0 1px #547dd0;cursor:pointer">
        <span>{{s.activeDocTitle}}</span>
      </button>
    </nav>

    <div style="display:flex;align-items:center;gap:6px;padding:0 12px;height:100%">
      <button type="button" class="ib-update" onClick="{{togglePopover}}" aria-label="{{s.updateIconAria}}" title="{{s.updateIconAria}}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M12 8V15.25M12 15.25L8.75 12M12 15.25L15.25 12" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span aria-hidden="true" style="position:absolute;top:2px;right:2px;width:6px;height:6px;border-radius:3px;background:#2f5ec4"></span>
      </button>
      <button type="button" class="ib" aria-label="{{s.moreAria}}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="5.75" cy="12" r="1.5" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></circle><circle cx="12" cy="12" r="1.5" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></circle><circle cx="18.25" cy="12" r="1.5" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></circle></svg>
      </button>
    </div>
  </header>

  <div style="flex:1;min-height:0;display:flex;flex-wrap:wrap">
    <aside aria-label="{{s.sidebarAria}}" style="width:260px;flex:none;background:#fafafa;border-right:1px solid #e6e6e6;box-sizing:border-box;display:flex;flex-direction:column;min-height:0">
      <div style="padding:10px 10px 8px;display:flex;align-items:center;gap:6px">
        <button type="button" style="font:inherit;font-size:14px;flex:1;min-width:0;height:32px;padding:0 9px;border-radius:8px;background:#ffffff;color:#526071;border:1px solid #dcdcdc;display:flex;align-items:center;gap:6px;cursor:pointer;box-sizing:border-box">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></circle><path d="M15.25 15.25L20 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
          <span style="flex:1;text-align:left">{{s.searchLabel}}</span>
          <span style="font-family:'JetBrains Mono',monospace;font-size:14px;color:#526071">⇧⌘K</span>
        </button>
        <button type="button" class="top-act" aria-label="{{s.newNoteAria}}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4.75" y="4.75" width="14.5" height="14.5" rx="3" fill="#c9d8f3"></rect><path d="M12 7.5V16.5M7.5 12H16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
        </button>
      </div>

      <div style="flex:1;min-height:0;overflow:auto;padding:0 8px 12px;display:flex;flex-direction:column;gap:2px">
        <button type="button" class="row-active">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.75 3.75H13.5L18.75 9V18.5A1.75 1.75 0 0 1 17 20.25H6.75A1.75 1.75 0 0 1 5 18.5V5.5A1.75 1.75 0 0 1 6.75 3.75Z" fill="#c9d8f3" stroke="#547dd0" stroke-width="1.5"></path></svg>
          <span>{{s.activeDocTitle}}</span>
        </button>
        <button type="button" class="row">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.75 3.75H13.5L18.75 9V18.5A1.75 1.75 0 0 1 17 20.25H6.75A1.75 1.75 0 0 1 5 18.5V5.5A1.75 1.75 0 0 1 6.75 3.75Z" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></path></svg>
          <span>{{s.doc2Title}}</span>
        </button>
      </div>

      <div style="padding:6px 8px;border-top:1px solid #e4e6ea;display:flex;align-items:center;gap:4px;background:#fafafa">
        <button type="button" class="vault-ghost" aria-label="{{s.vaultAria}}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.75 18.75V7.5A2.25 2.25 0 0 1 6 5.25H9L12 8.25H18A2.25 2.25 0 0 1 20.25 10.5V18.75Z" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
          <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{s.vaultName}}</span>
        </button>
        <div aria-hidden="true" style="width:1px;height:16px;background:#e4e6ea"></div>
        <button type="button" class="dock-btn" aria-label="{{s.settingsAria}}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5H20M4 12H20M4 17.5H20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><circle cx="9" cy="6.5" r="2.25" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></circle><circle cx="15" cy="12" r="2.25" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></circle><circle cx="10" cy="17.5" r="2.25" fill="#c9d8f3" stroke="currentColor" stroke-width="1.5"></circle></svg>
        </button>
      </div>
    </aside>

    <main style="flex:999 1 560px;min-width:0;background:#ffffff;display:flex;flex-direction:column;overflow:auto">
      <div style="box-sizing:border-box;width:100%;max-width:780px;margin:0 auto;padding:48px 40px;display:flex;flex-direction:column;gap:16px">
        <h1 style="margin:0;font-size:26px;line-height:34px;font-weight:600;color:#20242c">{{s.activeDocTitle}}</h1>
        <p style="margin:0;font-size:16px;line-height:26px;color:#20242c">{{s.editorParagraph1}}</p>
        <p style="margin:0;font-size:16px;line-height:26px;color:#526071">{{s.editorParagraph2}}</p>
      </div>
    </main>
  </div>

  <sc-if value="{{isPopoverOpen}}" hint-placeholder-val="{{true}}">
    <div role="dialog" aria-label="{{s.dialogAria}}" style="position:absolute;top:46px;right:14px;z-index:20;width:520px;max-height:740px;background:#ffffff;border:1px solid #d5dbe3;border-radius:12px;box-shadow:0 16px 40px rgba(24,28,35,0.16);display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box">

      <div style="flex:1;min-height:0;overflow:auto;padding:24px 26px 20px;display:flex;flex-direction:column;gap:22px">
        <section style="display:flex;flex-direction:column;gap:10px;padding-bottom:18px;border-bottom:1px solid #eceef2">
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px">
            <h2 style="margin:0;font-size:17px;line-height:24px;font-weight:600;color:#20242c;font-variant-numeric:tabular-nums">2026-11-05</h2>
            <span style="font-family:'JetBrains Mono',monospace;font-size:14px;line-height:20px;color:#526071;font-variant-numeric:tabular-nums">v0.1.0</span>
          </div>
          <div style="font-size:15px;line-height:23px;font-weight:600;color:#20242c">{{s.d1_hi}}</div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <div style="font-size:14px;line-height:21px;font-weight:600;color:#20242c">{{s.feat}}</div>
            <div style="font-size:14px;line-height:21px;color:#20242c">{{s.d1_f1}}</div>
            <div style="font-size:14px;line-height:21px;color:#20242c">{{s.d1_f2}}</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <div style="font-size:14px;line-height:21px;font-weight:600;color:#20242c">{{s.fix}}</div>
            <div style="font-size:14px;line-height:21px;color:#20242c">{{s.d1_b1}}</div>
            <div style="font-size:14px;line-height:21px;color:#20242c">{{s.d1_b2}}</div>
          </div>
        </section>

        <section style="display:flex;flex-direction:column;gap:10px">
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px">
            <h2 style="margin:0;font-size:17px;line-height:24px;font-weight:600;color:#20242c;font-variant-numeric:tabular-nums">2026-11-04</h2>
            <span style="font-family:'JetBrains Mono',monospace;font-size:14px;line-height:20px;color:#526071;font-variant-numeric:tabular-nums">v0.0.9</span>
          </div>
          <div style="font-size:15px;line-height:23px;font-weight:600;color:#20242c">{{s.d2_hi}}</div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <div style="font-size:14px;line-height:21px;font-weight:600;color:#20242c">{{s.feat}}</div>
            <div style="font-size:14px;line-height:21px;color:#20242c">{{s.d2_f1}}</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px">
            <div style="font-size:14px;line-height:21px;font-weight:600;color:#20242c">{{s.fix}}</div>
            <div style="font-size:14px;line-height:21px;color:#20242c">{{s.d2_b1}}</div>
          </div>
        </section>
      </div>

      <div style="padding:14px 22px;border-top:1px solid #e4e6ea;background:#fafafa;display:flex;flex-direction:column;gap:12px">
        <div style="display:flex;flex-direction:column;gap:6px">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
            <span style="font-size:14px;line-height:20px;color:#20242c;font-weight:500">{{s.progressText}}</span>
            <span style="font-family:'JetBrains Mono',monospace;font-size:14px;line-height:20px;color:#23468c;font-variant-numeric:tabular-nums">68%</span>
          </div>
          <div role="progressbar" aria-label="{{s.progressAria}}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="68" style="height:6px;border-radius:3px;background:#e4e6ea;overflow:hidden">
            <div style="width:68%;height:100%;background:#476ec2;border-radius:3px"></div>
          </div>
        </div>

        <div style="display:flex;align-items:center;justify-content:flex-end;gap:10px">
          <button type="button" class="btn-secondary" onClick="{{closePopover}}">{{s.laterLabel}}</button>
          <button type="button" class="btn-primary" onClick="{{confirmUpdate}}">{{s.updateLabel}}</button>
        </div>
      </div>

    </div>
  </sc-if>

</div>
</x-dc>
<script type="text/x-dc" data-dc-script data-props='{"lang":{"editor":"enum","default":"zh","options":[{"value":"zh","label":"中文（跟随客户端语言）"},{"value":"en","label":"English (Follow Client Locale)"}]},"popoverOpen":{"editor":"boolean","default":true,"label":"点击顶栏更新图标展开面板"},"phase":{"editor":"enum","default":"idle","options":[{"value":"idle","label":"待确认（点击「更新」开始增量更新）"},{"value":"updating","label":"增量更新中（下载差分包并调用系统替换）"}]},"$preview":{"width":1440,"height":900}}'>
class Component extends DCLogic {
  constructor(p) {
    super(p);
    this.state = { open: null, phase: null };
  }
  togglePopover() {
    const cur = this.state.open === null ? (this.props.popoverOpen !== false) : this.state.open;
    this.setState({ open: !cur, phase: 'idle' });
  }
  closePopover() {
    this.setState({ open: false, phase: 'idle' });
  }
  confirmUpdate() {
    this.setState({ open: true, phase: 'updating' });
  }
  renderVals() {
    const isEn = this.props.lang === 'en';
    const isPopoverOpen = this.state.open === null ? (this.props.popoverOpen !== false) : this.state.open;
    const curPhase = this.state.phase === null ? (this.props.phase || 'idle') : this.state.phase;
    const isUpdating = curPhase === 'updating';

    const s = isEn ? {
      sidebarToggleAria: 'Collapse sidebar',
      openTabsAria: 'Open tabs',
      sidebarAria: 'Notes list',
      activeDocTitle: 'Product Architecture Notes',
      doc2Title: 'Release Checklist',
      searchLabel: 'Search',
      newNoteAria: 'New note',
      vaultAria: 'Switch notebook',
      vaultName: 'Workspace',
      updateIconAria: 'Update available (v0.1.0)',
      moreAria: 'More actions',
      settingsAria: 'Settings',
      editorParagraph1: 'Option B places the update indicator button in the top-right titlebar next to the page menu.',
      editorParagraph2: 'Clicking the top-right update icon opens an anchored popover with the daily changelog, incremental progress bar, and Not Now / Update actions.',
      dialogAria: 'Update changelog',
      feat: '✨ New',
      fix: '🐛 Fixes',
      d1_hi: '🌈 Highlights: Persistent editor zoom across restarts, top insertion above leading code/table blocks, and automatic theme switching.',
      d1_f1: '• Remember editor content zoom level across restarts and insert a paragraph above a leading code block or table.',
      d1_f2: '• Automatically follow system light and dark appearance changes.',
      d1_b1: '• Fixed quick-note window failing to activate the main window and caret staying visible in inactive windows.',
      d1_b2: '• Fixed text selection overflowing inline code chips and crash when switching appearance.',
      d2_hi: '🌈 Highlights: Batch send for review annotations, redesigned image export themes, and drag-to-resize table columns.',
      d2_f1: '• Send multiple review annotations in one batch and drag table column borders to resize width.',
      d2_b1: '• Fixed floating toolbars and table handles showing through open menus and dialogs.',
      laterLabel: 'Not Now',
      updateLabel: isUpdating ? 'Updating…' : 'Update',
      progressAria: 'Incremental update progress',
      progressText: 'Incremental update v0.1.0 (2.9 MB / 4.2 MB)'
    } : {
      sidebarToggleAria: '收起左侧栏',
      openTabsAria: '已打开标签页',
      sidebarAria: '笔记列表',
      activeDocTitle: '产品架构笔记',
      doc2Title: '发版检查清单',
      searchLabel: '搜索',
      newNoteAria: '新建笔记',
      vaultAria: '切换工作区文件夹',
      vaultName: '本地笔记',
      updateIconAria: '有可用更新（v0.1.0）',
      moreAria: '页面更多操作',
      settingsAria: '打开设置',
      editorParagraph1: '方案 B 将更新图标置于顶栏右上角（更多操作按钮左侧），收起左侧栏时同样可见。',
      editorParagraph2: '点击右上角更新图标展开锚定式更新日志面板，底部包含增量更新进度条与「先不更新」「更新」按钮。',
      dialogAria: '更新内容确认',
      feat: '✨ 新功能',
      fix: '🐛 修复',
      d1_hi: '🌈 本次更新重点：编辑区缩放比例重启后持久保留，首段为表格或代码块时支持在顶部插入新段落，深浅色自动跟随系统切换。',
      d1_f1: '• 自动记住笔记正文的缩放比例，首段为代码块或表格时支持直接在顶部插入新段落。',
      d1_f2: '• 系统切换浅色或深色外观时，应用界面自动同步切换。',
      d1_b1: '• 修复速记小窗唤起主窗口失败，以及后台非活动窗口光标仍闪烁的问题。',
      d1_b2: '• 修复行内代码划选背景高度越界及切换外观时的闪退问题。',
      d2_hi: '🌈 本次更新重点：支持批量发送多条批注审阅意见，焕新导出长图配色主题，支持直接拖拽调整表格列宽。',
      d2_f1: '• 支持批量发送批注审阅意见，拖动表格列边线即可调整列宽、双击恢复默认。',
      d2_b1: '• 修复打开菜单或弹窗时，底部浮动工具栏与表格把手穿透显示的问题。',
      laterLabel: '先不更新',
      updateLabel: isUpdating ? '正在更新…' : '更新',
      progressAria: '增量更新进度',
      progressText: '正在增量更新 v0.1.0（GitHub 加速回退 + SHA-256 校验 · 2.9 MB / 4.2 MB）'
    };

    return {
      isPopoverOpen,
      s
    };
  }
}
</script>
</body>
</html>
