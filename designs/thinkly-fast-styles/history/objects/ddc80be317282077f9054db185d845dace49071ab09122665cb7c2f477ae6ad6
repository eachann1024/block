<script type="text/x-dc" data-dc-script data-props='{"theme":{"editor":"enum","options":["dark","light"],"default":"dark"},"$preview":{"width":1280,"height":960}}'>
class Component extends DCLogic {
  constructor(p) {
    super(p);
    this.state = {
      darkOverride: null,
      assetsHidden: false,
      advancedOpen: false,
      ex1: false,
      ex2: false,
      ex3: true
    };
  }

  renderVals() {
    const st = this.state || {};
    const props = this.props || {};
    const mode = st.darkOverride ?? (props.theme ?? 'dark');
    const dark = mode === 'dark';

    const shellBg = dark ? '#343434' : '#f1f1f1';
    const sidebarBg = dark ? '#222222' : '#fafafa';
    const settingsBg = dark ? '#181818' : '#f8f8f8';
    const cardBg = dark ? '#222222' : '#ffffff';
    const textPrimary = dark ? '#ececec' : '#20242c';
    const textSecondary = dark ? '#b4b4b4' : '#526071';
    const accent = dark ? '#779de8' : '#547dd0';
    const iconFill = dark ? '#31456a' : '#c9d8f3';
    const selectedBg = dark ? '#25354f' : '#e5edfc';
    const borderCol = dark ? '#2e2e2e' : '#e4e6ea';
    const sidebarBorder = dark ? '#333333' : '#e6e6e6';
    const btnBorder = dark ? '#444444' : '#dcdcdc';
    const activeRing = 'inset 0 0 0 1px ' + accent;

    const seg = (active) => ({
      bg: active ? selectedBg : 'transparent',
      col: active ? textPrimary : textSecondary,
      ring: active ? activeRing : 'none'
    });

    const isAssetsHidden = st.assetsHidden ?? false;
    const aHide = seg(isAssetsHidden);
    const aShow = seg(!isAssetsHidden);

    const ex1 = st.ex1 ?? false;
    const ex2 = st.ex2 ?? false;
    const ex3 = st.ex3 ?? true;

    return {
      shellBg, sidebarBg, settingsBg, cardBg, textPrimary, textSecondary,
      accent, iconFill, selectedBg, borderCol, sidebarBorder, btnBorder, activeRing,
      assetsRowBg: isAssetsHidden ? shellBg : cardBg,
      assetsHideBg: aHide.bg, assetsHideCol: aHide.col, assetsHideRing: aHide.ring,
      assetsShowBg: aShow.bg, assetsShowCol: aShow.col, assetsShowRing: aShow.ring,

      ex1, ex2, ex3,
      row1Bg: ex1 ? shellBg : cardBg,
      row2Bg: ex2 ? shellBg : cardBg,
      row3Bg: ex3 ? shellBg : cardBg,
      pill1Bg: ex1 ? selectedBg : shellBg,
      pill2Bg: ex2 ? selectedBg : shellBg,
      pill3Bg: ex3 ? selectedBg : shellBg,
      pill1Border: ex1 ? accent : borderCol,
      pill2Border: ex2 ? accent : borderCol,
      pill3Border: ex3 ? accent : borderCol,
      pill1Col: ex1 ? textPrimary : textSecondary,
      pill2Col: ex2 ? textPrimary : textSecondary,
      pill3Col: ex3 ? textPrimary : textSecondary,
      chk1Bg: ex1 ? cardBg : cardBg,
      chk2Bg: ex2 ? cardBg : cardBg,
      chk3Bg: ex3 ? cardBg : cardBg,
      chk1Border: ex1 ? accent : btnBorder,
      chk2Border: ex2 ? accent : btnBorder,
      chk3Border: ex3 ? accent : btnBorder,
      folder1IconCol: ex1 ? textSecondary : textPrimary,
      folder2IconCol: ex2 ? textSecondary : textPrimary,
      folder3IconCol: ex3 ? textSecondary : textPrimary,
      folder1IconFill: ex1 ? 'transparent' : iconFill,
      folder2IconFill: ex2 ? 'transparent' : iconFill,
      folder3IconFill: ex3 ? 'transparent' : iconFill,

      toggleDarkPreview: () => this.setState({ darkOverride: dark ? 'light' : 'dark' }),
      setAssetsHidden: () => this.setState({ assetsHidden: true }),
      setAssetsShown: () => this.setState({ assetsHidden: false }),
      toggleAdvanced: () => this.setState({ advancedOpen: !st.advancedOpen }),
      toggleFolder1: () => this.setState({ ex1: !ex1 }),
      toggleFolder2: () => this.setState({ ex2: !ex2 }),
      toggleFolder3: () => this.setState({ ex3: !ex3 })
    };
  }
}
</script>
</body>
