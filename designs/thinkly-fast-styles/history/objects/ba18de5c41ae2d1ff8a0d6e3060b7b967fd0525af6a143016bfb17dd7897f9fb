<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>文件查看与编辑 · 方案 A 顶栏直达</title>
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..600&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap">
<style>
body{margin:0;font-family:Inter,-apple-system,'PingFang SC','Microsoft YaHei',system-ui,sans-serif;-webkit-font-smoothing:antialiased}
a{color:#547dd0;text-decoration:none}a:hover{color:#3d63b0}
button,input,select,textarea{font-family:inherit;font-size:14px}
*{box-sizing:border-box}
::selection{background:#cde2fb;color:#184f95}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid #547dd0;outline-offset:1px}
.mono{font-family:'JetBrains Mono',Menlo,Monaco,ui-monospace,monospace;font-feature-settings:"liga" 0;font-variant-numeric:tabular-nums}
.ib{width:28px;height:28px;display:inline-flex;align-items:center;justify-content:center;border:0;border-radius:6px;background:transparent;padding:0;cursor:pointer;flex:none}
.btn{height:30px;padding:0 10px;border-radius:8px;display:inline-flex;align-items:center;gap:6px;cursor:pointer;font-weight:460;white-space:nowrap}
</style>
</helmet>

<div style="width:100%;min-height:900px;display:flex;flex-direction:column;background:{{shellBg}};color:{{fg}};font-size:14px;line-height:20px">

<header style="height:40px;flex:none;display:flex;align-items:center;border-bottom:1px solid {{sideBorder}};background:{{shellBg}}">
<div style="width:260px;flex:none;height:100%;display:flex;align-items:center;gap:4px;padding:0 10px 0 16px;border-right:1px solid {{sideBorder}}">
<div aria-hidden="true" style="display:flex;gap:8px;margin-right:auto"><span style="width:12px;height:12px;border-radius:6px;background:#ff5f57"></span><span style="width:12px;height:12px;border-radius:6px;background:#febc2e"></span><span style="width:12px;height:12px;border-radius:6px;background:#28c840"></span></div>
<button type="button" class="ib" onClick="{{toggleSidebar}}" aria-label="收起或展开左侧栏" style="color:{{subFg}}">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3.75 4.75H9.25V19.25H5.75A2 2 0 0 1 3.75 17.25V6.75A2 2 0 0 1 5.75 4.75Z" fill="{{iconFill}}"></path><rect x="3.75" y="4.75" width="16.5" height="14.5" rx="2" stroke="currentColor" stroke-width="1.5"></rect><path d="M9.25 4.75V19.25" stroke="currentColor" stroke-width="1.5"></path><path d="M15.75 9.75L13.25 12L15.75 14.25" stroke="{{accent}}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
</button>
</div>
<nav aria-label="已打开标签页" style="flex:1;min-width:0;height:100%;display:flex;align-items:center;gap:6px;padding:0 12px;overflow:hidden">
<button type="button" style="height:28px;display:inline-flex;align-items:center;gap:6px;padding:0 10px;border:0;border-radius:6px;background:{{selBg}};color:{{fg}};box-shadow:inset 0 0 0 1px {{accent}};font-weight:500;cursor:pointer">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.75 3.75H13.5V8.25A1 1 0 0 0 14.5 9.25H18.75V18.5A1.75 1.75 0 0 1 17 20.25H6.75A1.75 1.75 0 0 1 5 18.5V5.5A1.75 1.75 0 0 1 6.75 3.75Z" fill="{{iconFill}}"></path><path d="M6.75 3.75H13.5L18.75 9V18.5A1.75 1.75 0 0 1 17 20.25H6.75A1.75 1.75 0 0 1 5 18.5V5.5A1.75 1.75 0 0 1 6.75 3.75ZM13.5 3.75V8A1 1 0 0 0 14.5 9H18.75" stroke="{{accent}}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
<span class="mono">{{activeName}}</span>
</button>
<span style="color:{{subFg}}">{{saveLabel}}</span>
</nav>
<div style="display:flex;align-items:center;gap:8px;padding:0 14px;color:{{subFg}}">
<span class="mono">{{activePath}}</span>
</div>
</header>

<div style="flex:1;min-height:0;display:flex;flex-wrap:wrap">
<sc-if value="{{sidebarOpen}}" hint-placeholder-val="{{true}}">
<aside aria-label="文件列表" style="width:260px;flex:none;background:{{sideBg}};border-right:1px solid {{sideBorder}};display:flex;flex-direction:column;min-height:0">
<div style="padding:10px 10px 8px;display:flex;align-items:center;gap:6px">
<label style="flex:1;min-width:0;height:32px;padding:0 9px;border-radius:8px;background:{{paperBg}};border:1px solid {{btnBorder}};display:flex;align-items:center;gap:6px">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="color:{{subFg}};flex:none"><circle cx="10.5" cy="10.5" r="6.5" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5"></circle><path d="M15.25 15.25L20 20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
<input type="text" value="{{query}}" onInput="{{onQueryInput}}" placeholder="筛选文件名或后缀…" aria-label="筛选文件名" style="flex:1;min-width:0;border:0;outline:0;background:transparent;color:{{fg}};padding:0" />
<sc-if value="{{hasQuery}}" hint-placeholder-val="{{false}}">
<button type="button" onClick="{{clearQuery}}" aria-label="清空筛选" style="border:0;background:transparent;color:{{subFg}};padding:0;cursor:pointer">×</button>
</sc-if>
</label>
</div>

<div style="flex:1;min-height:0;overflow:auto;padding:0 8px 12px;display:flex;flex-direction:column;gap:2px">
<sc-for list="{{filteredFiles}}" as="f" hint-placeholder-count="9">
<button type="button" onClick="{{f.pick}}" style="width:100%;height:32px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 10px;border:0;border-radius:6px;background:{{f.rowBg}};color:{{fg}};box-shadow:{{f.rowRing}};font-weight:{{f.rowWeight}};text-align:left;cursor:pointer">
<span style="display:flex;align-items:center;gap:7px;min-width:0;flex:1">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex:none;color:{{f.iconCol}}"><path d="M6.75 3.75H13.5V8.25A1 1 0 0 0 14.5 9.25H18.75V18.5A1.75 1.75 0 0 1 17 20.25H6.75A1.75 1.75 0 0 1 5 18.5V5.5A1.75 1.75 0 0 1 6.75 3.75Z" fill="{{iconFill}}"></path><path d="M6.75 3.75H13.5L18.75 9V18.5A1.75 1.75 0 0 1 17 20.25H6.75A1.75 1.75 0 0 1 5 18.5V5.5A1.75 1.75 0 0 1 6.75 3.75Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path></svg>
<span class="mono" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{f.name}}</span>
</span>
<span style="color:{{subFg}};flex:none">{{f.badge}}</span>
</button>
</sc-for>
<sc-if value="{{noMatch}}" hint-placeholder-val="{{false}}">
<div style="padding:18px 10px;display:flex;flex-direction:column;gap:8px;color:{{subFg}}">
<span>未找到匹配的文件</span>
<button type="button" class="btn" onClick="{{clearQuery}}" style="align-self:flex-start;background:{{paperBg}};color:{{fg}};border:1px solid {{btnBorder}}">清空筛选条件</button>
</div>
</sc-if>
</div>

<div style="padding:8px 10px;border-top:1px solid {{sideBorder}};display:flex;align-items:center;justify-content:space-between;color:{{subFg}}">
<span>workspace-demo</span>
<span class="mono">9 项</span>
</div>
</aside>
</sc-if>

<main style="flex:999 1 560px;min-width:0;background:{{paperBg}};display:flex;flex-direction:column;min-height:0">

<div role="toolbar" aria-label="当前文件操作栏" style="min-height:46px;padding:6px 24px;border-bottom:1px solid {{borderCol}};background:{{sideBg}};display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px">
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
<span class="mono" style="font-weight:560;color:{{fg}}">{{activeName}}</span>
<span style="color:{{subFg}}">{{activeSummary}}</span>
<sc-if value="{{isDirty}}" hint-placeholder-val="{{false}}">
<span style="padding:2px 8px;border-radius:6px;background:{{selBg}};color:{{fg}};box-shadow:inset 0 0 0 1px {{accent}}">已修改 · {{saveLabel}}</span>
</sc-if>
</div>

<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
<sc-if value="{{isTextView}}" hint-placeholder-val="{{true}}">
<label style="display:inline-flex;align-items:center;gap:6px;color:{{subFg}}">
<span>语法</span>
<select value="{{activeLang}}" onChange="{{onLangChange}}" aria-label="语法高亮模式" style="height:30px;padding:0 8px;border-radius:8px;border:1px solid {{btnBorder}};background:{{paperBg}};color:{{fg}}">
<option value="html">HTML</option>
<option value="json">JSON</option>
<option value="plain">纯文本 (Plain)</option>
</select>
</label>
<button type="button" class="btn" onClick="{{toggleWrap}}" style="background:{{wrapBtnBg}};color:{{fg}};border:1px solid {{btnBorder}};box-shadow:{{wrapBtnRing}}">{{wrapLabel}}</button>
</sc-if>

<sc-if value="{{isHtmlFile}}" hint-placeholder-val="{{true}}">
<button type="button" class="btn" onClick="{{openInBrowser}}" style="background:{{selBg}};color:{{fg}};border:1px solid {{accent}}">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.5"></circle><path d="M10 8.5H15.5V14M15.25 8.75L8.75 15.25" stroke="{{accent}}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
<span>在默认浏览器中打开</span>
</button>
</sc-if>

<sc-if value="{{isImageView}}" hint-placeholder-val="{{false}}">
<div style="display:inline-flex;align-items:center;gap:2px;padding:3px;border-radius:8px;background:{{shellBg}};border:1px solid {{borderCol}}">
<button type="button" onClick="{{zoomOut}}" aria-label="缩小图片" style="height:26px;padding:0 8px;border:0;border-radius:6px;background:transparent;color:{{fg}};cursor:pointer">−</button>
<button type="button" onClick="{{zoomFit}}" style="height:26px;padding:0 8px;border:0;border-radius:6px;background:{{fitBtnBg}};color:{{fg}};box-shadow:{{fitBtnRing}};cursor:pointer">适应</button>
<button type="button" onClick="{{zoom100}}" style="height:26px;padding:0 8px;border:0;border-radius:6px;background:{{oneBtnBg}};color:{{fg}};box-shadow:{{oneBtnRing}};cursor:pointer">100%</button>
<button type="button" onClick="{{zoomIn}}" aria-label="放大图片" style="height:26px;padding:0 8px;border:0;border-radius:6px;background:transparent;color:{{fg}};cursor:pointer">+</button>
</div>
<span class="mono" style="color:{{subFg}}">{{zoomText}}</span>
</sc-if>

<button type="button" class="btn" onClick="{{openSystemDefault}}" style="background:{{paperBg}};color:{{fg}};border:1px solid {{btnBorder}}">使用系统默认应用打开</button>
<button type="button" class="btn" onClick="{{revealInFinder}}" style="background:{{paperBg}};color:{{subFg}};border:1px solid {{btnBorder}}">在访达中显示</button>
</div>
</div>

<sc-if value="{{hasToast}}" hint-placeholder-val="{{false}}">
<div role="status" style="padding:8px 24px;background:{{selBg}};border-bottom:1px solid {{borderCol}};display:flex;align-items:center;justify-content:space-between;gap:12px">
<span>{{toastMsg}}</span>
<button type="button" onClick="{{dismissToast}}" style="border:0;background:transparent;color:{{fg}};font-weight:500;cursor:pointer">知道了</button>
</div>
</sc-if>

<div style="flex:1;min-height:0;overflow:auto;padding:28px 24px 56px">
<div style="width:100%;max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:16px">

<sc-if value="{{isLargeLog}}" hint-placeholder-val="{{false}}">
<div style="padding:12px 14px;border-radius:8px;background:{{codeBg}};border:1px solid {{borderCol}};display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px">
<span>大文件只读模式（示例 48.6 MB）：为保持应用流畅与低内存占用，当前仅加载尾部日志片段。</span>
<button type="button" class="btn" onClick="{{openSystemDefault}}" style="background:{{paperBg}};color:{{fg}};border:1px solid {{btnBorder}}">用外部工具打开完整文件</button>
</div>
</sc-if>

<sc-if value="{{isEncodingLocked}}" hint-placeholder-val="{{false}}">
<div style="padding:12px 14px;border-radius:8px;background:{{codeBg}};border:1px solid {{borderCol}};display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px">
<span>检测到非 UTF-8 字节序列：当前处于只读保护状态，避免自动保存破坏原始字节。</span>
<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
<label style="display:inline-flex;align-items:center;gap:6px">
<span>编码预览</span>
<select value="{{legacyEncoding}}" onChange="{{onEncodingChange}}" aria-label="选择字符编码" style="height:30px;padding:0 8px;border-radius:8px;border:1px solid {{btnBorder}};background:{{paperBg}};color:{{fg}}">
<option value="GB18030">GB18030</option>
<option value="UTF-8">UTF-8 (含替换符)</option>
</select>
</label>
<button type="button" class="btn" onClick="{{confirmEncodingEdit}}" style="background:{{selBg}};color:{{fg}};border:1px solid {{accent}}">按 {{legacyEncoding}} 解码并解锁编辑</button>
</div>
</div>
</sc-if>

<sc-if value="{{isTextView}}" hint-placeholder-val="{{true}}">
<div style="border:1px solid {{borderCol}};border-radius:10px;background:{{codeBg}};overflow:hidden">
<div style="padding:8px 14px;border-bottom:1px solid {{borderCol}};display:flex;align-items:center;justify-content:space-between;color:{{subFg}}">
<span class="mono">{{editorModeLabel}}</span>
<span class="mono">行 {{lineCount}} · 字符 {{charCount}}</span>
</div>

<div style="position:relative;min-height:460px">
<pre aria-hidden="true" class="mono" style="margin:0;padding:16px 18px;font-size:14px;line-height:22px;white-space:{{preWrap}};word-break:{{wordBreak}};color:{{fg}};pointer-events:none;min-height:460px"><sc-for list="{{tokens}}" as="tk" hint-placeholder-count="16"><span style="color:{{tk.color}}">{{tk.text}}</span></sc-for>
</pre>
<sc-if value="{{canEditText}}" hint-placeholder-val="{{true}}">
<textarea value="{{currentText}}" onInput="{{onTextInput}}" spellcheck="false" aria-label="源码与文本编辑器" class="mono" style="position:absolute;inset:0;width:100%;height:100%;margin:0;padding:16px 18px;border:0;outline:0;resize:none;background:transparent;color:transparent;caret-color:{{accent}};font-size:14px;line-height:22px;white-space:{{preWrap}};word-break:{{wordBreak}};overflow:hidden"></textarea>
</sc-if>
</div>
</div>
</sc-if>

<sc-if value="{{isImageView}}" hint-placeholder-val="{{false}}">
<div style="border:1px solid {{borderCol}};border-radius:10px;background:{{codeBg}};padding:20px;display:flex;flex-direction:column;gap:14px">
<div style="min-height:420px;max-height:540px;overflow:auto;border-radius:8px;background:{{paperBg}};border:1px solid {{borderCol}};display:flex;align-items:center;justify-content:center;padding:20px">
<img src="/_blob/66c6955d7ad40d92535cdcb2e5ba7c69" alt="cover.png 项目吉祥物图标集预览" style="width:{{imgWidthPx}};height:auto;max-width:{{imgMaxWidth}};border-radius:8px;display:block" />
</div>
<div style="display:flex;align-items:center;justify-content:space-between;color:{{subFg}}">
<span>图片查看器 · 支持常见栅格与矢量图缩放查看，不内置重型修图管线</span>
<span class="mono">PNG · 1024 × 768 · 示例资源</span>
</div>
</div>
</sc-if>

<sc-if value="{{isExternalView}}" hint-placeholder-val="{{false}}">
<div style="border:1px solid {{borderCol}};border-radius:10px;background:{{sideBg}};padding:28px 24px;display:flex;flex-direction:column;gap:18px">
<div style="display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap">
<div style="display:flex;align-items:center;gap:12px">
<div style="width:44px;height:44px;border-radius:10px;background:{{selBg}};border:1px solid {{accent}};display:flex;align-items:center;justify-content:center;color:{{accent}};flex:none">
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.75 3.75H13.5L18.75 9V18.5A1.75 1.75 0 0 1 17 20.25H6.75A1.75 1.75 0 0 1 5 18.5V5.5A1.75 1.75 0 0 1 6.75 3.75Z" fill="{{iconFill}}" stroke="currentColor" stroke-width="1.6"></path><path d="M10 12.5H15M10 15.5H13.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
</div>
<div>
<div class="mono" style="font-size:16px;font-weight:560;color:{{fg}}">{{activeName}}</div>
<div style="color:{{subFg}}">{{externalDesc}}</div>
</div>
</div>
<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
<button type="button" class="btn" onClick="{{openSystemDefault}}" style="background:{{selBg}};color:{{fg}};border:1px solid {{accent}};font-weight:500">使用系统默认应用打开</button>
<button type="button" class="btn" onClick="{{simulateOpenFail}}" style="background:{{paperBg}};color:{{subFg}};border:1px solid {{btnBorder}}">模拟打开异常</button>
</div>
</div>

<div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;padding-top:14px;border-top:1px solid {{borderCol}}">
<div><div style="color:{{subFg}}">类型与后缀</div><div class="mono" style="font-weight:500;margin-top:2px">{{activeBadge}} · {{activeMime}}</div></div>
<div><div style="color:{{subFg}}">文件大小（示例）</div><div class="mono" style="font-weight:500;margin-top:2px">{{activeSize}}</div></div>
<div><div style="color:{{subFg}}">工作区相对路径</div><div class="mono" style="font-weight:500;margin-top:2px">{{activePath}}</div></div>
</div>

<div style="color:{{subFg}}">为保持安装包精简与启动流畅，音视频、PDF 与压缩包不内嵌重型解码器或阅读器，统一交由 macOS / Windows 系统默认程序处理。</div>
</div>
</sc-if>

</div>
</div>
</main>
</div>
</div>
</x-dc>

<script type="text/x-dc" data-dc-script data-props='{"theme":{"editor":"enum","default":"light","options":["light","dark"]},"$preview":{"width":1440,"height":900}}'>
class Component extends DCLogic {
  constructor(p) {
    super(p);
    this.timers = {};
    this.state = {
      sidebarOpen: true,
      query: '',
      activeId: 'index.html',
      wrap: true,
      zoomMode: 'fit',
      zoomPct: 100,
      toast: '',
      legacyEncoding: 'GB18030',
      legacyUnlocked: false,
      saveStatus: {},
      langOverride: {},
      contents: {
        'index.html': '<!doctype html>\n<html lang="zh-CN">\n<head>\n  <meta charset="utf-8">\n  <title>Block 静态页面示例</title>\n</head>\n<body>\n  <main class="container">\n    <h1>本地源码直编模式</h1>\n    <p>HTML 文件展示可编辑源码与语法着色，顶栏提供默认浏览器打开入口。</p>\n  </main>\n</body>\n</html>',
        'settings.json': '{\n  "workspace": "thinkly-fast",\n  "autosave": true,\n  "editorWidth": 720,\n  "externalHandoff": ["pdf", "mp4", "zip"],\n  "maxInlineSizeMB": 10\n}',
        'notes.txt': '发布检查备忘（纯文本 / 未知语言回退示例）\n1. 普通文本文件直接作为可编辑源码打开，无需手动保存按钮。\n2. 未知后缀或无语法定义时自动回退为纯文本（Plain Text）。\n3. 切换左侧文件后，已修改的内容在组件状态中持续保留。',
        'huge.log': '[2026-11-05 09:14:02] WARN  indexer::scan skipped 3 binary blobs (>20MB)\n[2026-11-05 09:14:08] ERROR sync::worker connection reset by peer (retry 1/3)\n[2026-11-05 09:14:15] WARN  buffer::guard file exceeds inline edit threshold, switched to read-only tail view',
        'legacy.txt': '【GB18030 历史归档记录】\n编号：ARCHIVE-2019-08\n说明：检测到非 UTF-8 字节流。明确选择编码并确认后，方可转为可编辑状态。'
      }
    };
  }
  scheduleSave(id) {
    if (this.timers[id]) clearTimeout(this.timers[id]);
    this.timers[id] = setTimeout(() => {
      const next = Object.assign({}, this.state.saveStatus);
      next[id] = 'saved';
      this.setState({ saveStatus: next });
    }, 420);
  }
  tokenize(text, lang, dark) {
    if (lang === 'plain') return [{ text, color: dark ? '#e6edf3' : '#20242c' }];
    const kw = dark ? '#ff7b72' : '#cf222e';
    const str = dark ? '#a5d6ff' : '#0a3069';
    const prop = dark ? '#7ee787' : '#116329';
    const num = dark ? '#79c0ff' : '#0550ae';
    const punc = dark ? '#8b949e' : '#57606a';
    const base = dark ? '#e6edf3' : '#20242c';
    const re = /(&lt;\/?[a-zA-Z0-9!-]+|\b(?:true|false|null)\b|"[^"\n]*"|\b\d+(?:\.\d+)?\b|[{}[\]:,&lt;&gt;=/])/g;
    const out = [];
    let last = 0;
    let m;
    while ((m = re.exec(text)) !== null) {
      if (m.index > last) out.push({ text: text.slice(last, m.index), color: base });
      const tk = m[0];
      let c = punc;
      if (tk.startsWith('"')) c = (lang === 'json' && text.slice(m.index + tk.length).trimStart().startsWith(':')) ? prop : str;
      else if (tk.startsWith('<')) c = prop;
      else if (/^(true|false|null)$/.test(tk)) c = kw;
      else if (/^\d/.test(tk)) c = num;
      out.push({ text: tk, color: c });
      last = m.index + tk.length;
    }
    if (last < text.length) out.push({ text: text.slice(last), color: base });
    return out;
  }
  renderVals() {
    const dark = (this.props.theme ?? 'light') === 'dark';
    const files = [
      { id: 'index.html', name: 'index.html', badge: 'HTML', kind: 'text', lang: 'html', size: '4.2 KB', mime: 'text/html', path: 'docs/index.html', summary: 'HTML 源码 · UTF-8' },
      { id: 'settings.json', name: 'settings.json', badge: 'JSON', kind: 'text', lang: 'json', size: '1.8 KB', mime: 'application/json', path: 'config/settings.json', summary: 'JSON 配置 · UTF-8' },
      { id: 'notes.txt', name: 'notes.txt', badge: 'TXT', kind: 'text', lang: 'plain', size: '2.1 KB', mime: 'text/plain', path: 'notes/notes.txt', summary: '纯文本回退 · UTF-8' },
      { id: 'cover.png', name: 'cover.png', badge: 'PNG', kind: 'image', lang: 'plain', size: '312 KB', mime: 'image/png', path: 'assets/cover.png', summary: '图片预览 · 1024×768' },
      { id: 'walkthrough.mp4', name: 'walkthrough.mp4', badge: 'MP4', kind: 'external', lang: 'plain', size: '18.4 MB', mime: 'video/mp4', path: 'media/walkthrough.mp4', summary: '视频文件 · 外部打开', desc: '视频文件（示例数据）：不内嵌视频解码器，点击右侧按钮交由系统默认播放器打开。' },
      { id: 'guide.pdf', name: 'guide.pdf', badge: 'PDF', kind: 'external', lang: 'plain', size: '3.6 MB', mime: 'application/pdf', path: 'docs/guide.pdf', summary: 'PDF 文档 · 外部打开', desc: 'PDF 文档（示例数据）：不内嵌 PDF 渲染引擎，交由系统默认阅读器查看。' },
      { id: 'archive.zip', name: 'archive.zip', badge: 'ZIP', kind: 'external', lang: 'plain', size: '9.1 MB', mime: 'application/zip', path: 'releases/archive.zip', summary: '二进制归档 · 外部打开', desc: '二进制压缩归档（示例数据）：不支持直接作为文本编辑，可交由系统归档工具或在访达中定位。' },
      { id: 'huge.log', name: 'huge.log', badge: 'LOG', kind: 'text', lang: 'plain', size: '48.6 MB', mime: 'text/plain', path: 'logs/huge.log', summary: '大文件只读 · UTF-8' },
      { id: 'legacy.txt', name: 'legacy.txt', badge: '编码待定', kind: 'text', lang: 'plain', size: '6.4 KB', mime: 'text/plain', path: 'archive/legacy.txt', summary: '编码待确认 · 只读保护' }
    ];
    const q = this.state.query.trim().toLowerCase();
    const filtered = files.filter((f) => !q || f.name.toLowerCase().includes(q) || f.badge.toLowerCase().includes(q));
    const cur = files.find((f) => f.id === this.state.activeId) || files[0];
    const activeLang = this.state.langOverride[cur.id] || cur.lang;
    let rawText = this.state.contents[cur.id] || '';
    if (cur.id === 'legacy.txt' && this.state.legacyEncoding === 'UTF-8' && !this.state.legacyUnlocked) {
      rawText = '【GB18030 ������】\n编号：ARCHIVE-2019-08\n说明：UTF-8 解码存在无法识别字节（�），请切换为 GB18030 后确认解锁。';
    }
    const isLargeLog = cur.id === 'huge.log';
    const isEncodingLocked = cur.id === 'legacy.txt' && !this.state.legacyUnlocked;
    const canEditText = cur.kind === 'text' && !isLargeLog && !isEncodingLocked;
    const st = this.state.saveStatus[cur.id];
    const saveLabel = st === 'saving' ? '正在暂存…' : (st === 'saved' ? '已暂存（演示）' : '自动暂存就绪（演示）');
    const lines = rawText ? rawText.split('\n').length : 1;
    const accent = dark ? '#779de8' : '#547dd0';
    const selBg = dark ? '#343434' : '#e5edfc';
    return {
      shellBg: dark ? '#343434' : '#f1f1f1',
      sideBg: dark ? '#222222' : '#fafafa',
      paperBg: dark ? '#181818' : '#ffffff',
      codeBg: dark ? '#1d2026' : '#f3f1ec',
      fg: dark ? '#ececec' : '#20242c',
      subFg: dark ? '#b4b4b4' : '#526071',
      accent,
      iconFill: dark ? '#31456a' : '#c9d8f3',
      selBg,
      borderCol: dark ? '#2e2e2e' : '#e4e6ea',
      sideBorder: dark ? '#333333' : '#e6e6e6',
      btnBorder: dark ? '#444444' : '#dcdcdc',
      sidebarOpen: this.state.sidebarOpen,
      toggleSidebar: () => this.setState({ sidebarOpen: !this.state.sidebarOpen }),
      query: this.state.query,
      hasQuery: q.length > 0,
      noMatch: filtered.length === 0,
      onQueryInput: (e) => this.setState({ query: e && e.target ? e.target.value : '' }),
      clearQuery: () => this.setState({ query: '' }),
      filteredFiles: filtered.map((f) => ({
        ...f,
        rowBg: f.id === cur.id ? selBg : 'transparent',
        rowRing: f.id === cur.id ? `inset 0 0 0 1px ${accent}` : 'none',
        rowWeight: f.id === cur.id ? '500' : '400',
        iconCol: f.id === cur.id ? accent : (dark ? '#b4b4b4' : '#526071'),
        pick: () => this.setState({ activeId: f.id, toast: '' })
      })),
      activeName: cur.name,
      activePath: cur.path,
      activeSummary: cur.summary,
      activeBadge: cur.badge,
      activeMime: cur.mime,
      activeSize: cur.size,
      externalDesc: cur.desc || '',
      isTextView: cur.kind === 'text',
      isImageView: cur.kind === 'image',
      isExternalView: cur.kind === 'external',
      isHtmlFile: cur.id === 'index.html',
      isLargeLog,
      isEncodingLocked,
      canEditText,
      isDirty: Boolean(st),
      saveLabel,
      activeLang,
      onLangChange: (e) => {
        const v = e && e.target ? e.target.value : 'plain';
        this.setState({ langOverride: Object.assign({}, this.state.langOverride, { [cur.id]: v }) });
      },
      wrapLabel: this.state.wrap ? '自动换行：开' : '自动换行：关',
      wrapBtnBg: this.state.wrap ? selBg : (dark ? '#181818' : '#ffffff'),
      wrapBtnRing: this.state.wrap ? `inset 0 0 0 1px ${accent}` : 'none',
      toggleWrap: () => this.setState({ wrap: !this.state.wrap }),
      preWrap: this.state.wrap ? 'pre-wrap' : 'pre',
      wordBreak: this.state.wrap ? 'break-all' : 'normal',
      editorModeLabel: canEditText ? `可编辑源码 (${activeLang.toUpperCase()})` : '只读源码视图 (Read-only)',
      lineCount: String(lines),
      charCount: String(rawText.length),
      currentText: rawText,
      tokens: this.tokenize(rawText, activeLang, dark),
      onTextInput: (e) => {
        if (!canEditText) return;
        const val = e && e.target ? e.target.value : '';
        const id = cur.id;
        this.setState({
          contents: Object.assign({}, this.state.contents, { [id]: val }),
          saveStatus: Object.assign({}, this.state.saveStatus, { [id]: 'saving' })
        });
        this.scheduleSave(id);
      },
      legacyEncoding: this.state.legacyEncoding,
      onEncodingChange: (e) => this.setState({ legacyEncoding: e && e.target ? e.target.value : 'GB18030' }),
      confirmEncodingEdit: () => this.setState({
        legacyUnlocked: true,
        toast: `原型演示：已确认按 ${this.state.legacyEncoding} 解码 legacy.txt，现已解锁编辑。`
      }),
      zoomText: this.state.zoomMode === 'fit' ? '自适应宽度' : `${this.state.zoomPct}%`,
      fitBtnBg: this.state.zoomMode === 'fit' ? selBg : 'transparent',
      fitBtnRing: this.state.zoomMode === 'fit' ? `inset 0 0 0 1px ${accent}` : 'none',
      oneBtnBg: (this.state.zoomMode === 'pct' && this.state.zoomPct === 100) ? selBg : 'transparent',
      oneBtnRing: (this.state.zoomMode === 'pct' && this.state.zoomPct === 100) ? `inset 0 0 0 1px ${accent}` : 'none',
      imgWidthPx: this.state.zoomMode === 'fit' ? '100%' : `${Math.round(520 * this.state.zoomPct / 100)}px`,
      imgMaxWidth: this.state.zoomMode === 'fit' ? '520px' : 'none',
      zoomFit: () => this.setState({ zoomMode: 'fit' }),
      zoom100: () => this.setState({ zoomMode: 'pct', zoomPct: 100 }),
      zoomIn: () => this.setState({ zoomMode: 'pct', zoomPct: Math.min(200, (this.state.zoomMode === 'fit' ? 100 : this.state.zoomPct) + 25) }),
      zoomOut: () => this.setState({ zoomMode: 'pct', zoomPct: Math.max(50, (this.state.zoomMode === 'fit' ? 100 : this.state.zoomPct) - 25) }),
      hasToast: Boolean(this.state.toast),
      toastMsg: this.state.toast,
      dismissToast: () => this.setState({ toast: '' }),
      openInBrowser: () => this.setState({ toast: `原型演示：将使用默认浏览器打开 ${cur.name}（未实际调用系统浏览器）` }),
      openSystemDefault: () => this.setState({ toast: `原型演示：将调用系统默认应用打开 ${cur.name}（未实际启动外部进程）` }),
      revealInFinder: () => this.setState({ toast: `原型演示：将在访达中定位 ${cur.path}` }),
      simulateOpenFail: () => this.setState({ toast: `原型演示：外部应用未能响应 ${cur.name}，请检查系统默认程序关联或重试。` })
    };
  }
}
</script>
