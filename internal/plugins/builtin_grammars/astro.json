  "sample": "---\nimport Layout from '../layouts/Layout.astro';\nimport Card from '../components/Card.astro';\n\ninterface Props {\n  title: string;\n  items?: string[];\n}\n\nconst { title, items = ['Astro', 'Block'] } = Astro.props;\n---\n\n<!-- Component template -->\n<Layout title={title}>\n  <main class:list={['container', { active: items.length > 0 }]}>\n    <h1>{title}</h1>\n    {items.map((item) => <Card name={item} client:load />)}\n  </main>\n</Layout>\n\n<style>\n  .container {\n    padding: 1.5rem;\n    color: #1f2937;\n  }\n</style>"
