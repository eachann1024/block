{
  "schema_version": 1,
  "block_comment": ["<%!--", "--%>"],
  "word_chars": "_?!",
  "tab_size": 2,
  "hard_tabs": false,
  "brackets": [
    ["<%", "%>"],
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["<", ">"]
  ],
  "auto_close": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "initial_state": "root",
  "states": {
    "root": [
      {
        "match": "<%!--",
        "token": "comment",
        "push": "heex_comment"
      },
      {
        "match": "<%%|%%>",
        "token": "escape"
      },
      {
        "match": "<%#",
        "token": "comment",
        "push": "eex_comment"
      },
      {
        "match": "<%[=%/-]?",
        "token": "meta",
        "push": "eex_tag"
      },
      {
        "match": "<!--",
        "token": "comment",
        "push": "html_comment"
      },
      {
        "match": "<!DOCTYPE\\b[^>]*>",
        "token": "meta"
      },
      {
        "match": "(</?)(\\.[a-z_][a-zA-Z0-9_!?]*|[A-Za-z][A-Za-z0-9:._-]*)",
        "captures": {
          "1": "punctuation",
          "2": "tag"
        },
        "push": "html_tag"
      },
      {
        "match": "\\{",
        "token": "meta",
        "push": "heex_brace"
      },
      {
        "match": "&[A-Za-z0-9#]+;",
        "token": "escape"
      },
      {
        "match": "[^<>&{\\r\\n]+",
        "token": "text"
      }
    ],
    "heex_comment": [
      {
        "match": "--%>",
        "token": "comment",
        "pop": true
      },
      {
        "match": "[^-\\r\\n]+|-",
        "token": "comment"
      }
    ],
    "eex_comment": [
      {
        "match": "%>",
        "token": "comment",
        "pop": true
      },
      {
        "match": "[^%\\r\\n]+|%",
        "token": "comment"
      }
    ],
    "html_comment": [
      {
        "match": "-->",
        "token": "comment",
        "pop": true
      },
      {
        "match": "[^-\\r\\n]+|-",
        "token": "comment"
      }
    ],
    "html_tag": [
      {
        "match": "/?>",
        "token": "punctuation",
        "pop": true
      },
      {
        "match": "<%!--",
        "token": "comment",
        "push": "heex_comment"
      },
      {
        "match": "<%#",
        "token": "comment",
        "push": "eex_comment"
      },
      {
        "match": "<%[=%/-]?",
        "token": "meta",
        "push": "eex_tag"
      },
      {
        "match": "\\{",
        "token": "meta",
        "push": "heex_brace"
      },
      {
        "match": "\"",
        "token": "string",
        "push": "attr_dquote"
      },
      {
        "match": "'",
        "token": "string",
        "push": "attr_squote"
      },
      {
        "match": "=",
        "token": "operator"
      },
      {
        "match": ":[a-z_][a-zA-Z0-9_-]*",
        "token": "attribute"
      },
      {
        "match": "[A-Za-z_][A-Za-z0-9_:.-]*",
        "token": "attribute"
      },
      {
        "match": "[ \\t]+",
        "token": "text"
      }
    ],
    "attr_dquote": [
      {
        "match": "\"",
        "token": "string",
        "pop": true
      },
      {
        "match": "<%[=%/-]?",
        "token": "meta",
        "push": "eex_tag"
      },
      {
        "match": "\\\\.",
        "token": "escape"
      },
      {
        "match": "[^\"\\\\<\\r\\n]+|<",
        "token": "string"
      }
    ],
    "attr_squote": [
      {
        "match": "'",
        "token": "string",
        "pop": true
      },
      {
        "match": "<%[=%/-]?",
        "token": "meta",
        "push": "eex_tag"
      },
      {
        "match": "\\\\.",
        "token": "escape"
      },
      {
        "match": "[^'\\\\<\\r\\n]+|<",
        "token": "string"
      }
    ],
    "eex_tag": [
      {
        "match": "%>",
        "token": "meta",
        "pop": true
      },
      {
        "match": "#(?:[^%\\r\\n]|%[^>\\r\\n])*",
        "token": "comment"
      },
      {
        "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*(?:\"|$)",
        "token": "string"
      },
      {
        "match": "'(?:\\\\.|[^'\\\\\\r\\n])*(?:'|$)",
        "token": "string"
      },
      {
        "match": "~[A-Za-z](?:\"(?:\\\\.|[^\"\\\\\\r\\n])*\"|'(?:\\\\.|[^'\\\\\\r\\n])*'|\\[(?:\\\\.|[^\\]\\\\\\r\\n])*\\]|\\((?:\\\\.|[^)\\\\\\r\\n])*\\)|\\{(?:\\\\.|[^}\\\\\\r\\n])*\\}|/(?:\\\\.|[^/\\\\\\r\\n])*/)[a-z]*",
        "token": "string"
      },
      {
        "match": "@[a-z_][a-zA-Z0-9_]*",
        "token": "variable"
      },
      {
        "match": ":[a-zA-Z_][a-zA-Z0-9_@]*[!?]?",
        "token": "constant"
      },
      {
        "match": "([a-z_][a-zA-Z0-9_]*[!?]?)(:)(?:[ \\t]|$)",
        "captures": {
          "1": "property",
          "2": "punctuation"
        }
      },
      {
        "match": "\\b(?:do|end|if|else|unless|case|cond|for|with|fn|def|defp|defmodule|in|not|and|or|when|after|rescue|catch|try|import|alias|require|use|receive|raise|throw)\\b",
        "token": "keyword"
      },
      {
        "match": "\\b(?:true|false|nil)\\b",
        "token": "constant"
      },
      {
        "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
        "token": "type"
      },
      {
        "match": "\\b(?:0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9_]+)?)\\b",
        "token": "number"
      },
      {
        "match": "([a-z_][a-zA-Z0-9_]*[!?]?)([ \\t]*\\()",
        "captures": {
          "1": "function",
          "2": "punctuation"
        }
      },
      {
        "match": "[a-z_][a-zA-Z0-9_]*[!?]?",
        "token": "variable"
      },
      {
        "match": "\\|>|<-|->|=>|===|!==|==|!=|<=|>=|&&|\\|\\||<>|\\+\\+|--|::|=~|[+\\-*/=!<>|&^~]",
        "token": "operator"
      },
      {
        "match": "[(){}\\[\\],.;:%]",
        "token": "punctuation"
      },
      {
        "match": "[ \\t]+",
        "token": "text"
      }
    ],
    "heex_brace": [
      {
        "match": "\\}",
        "token": "meta",
        "pop": true
      },
      {
        "match": "\\{",
        "token": "punctuation",
        "push": "heex_brace_inner"
      },
      {
        "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*(?:\"|$)",
        "token": "string"
      },
      {
        "match": "'(?:\\\\.|[^'\\\\\\r\\n])*(?:'|$)",
        "token": "string"
      },
      {
        "match": "@[a-z_][a-zA-Z0-9_]*",
        "token": "variable"
      },
      {
        "match": ":[a-zA-Z_][a-zA-Z0-9_@]*[!?]?",
        "token": "constant"
      },
      {
        "match": "([a-z_][a-zA-Z0-9_]*[!?]?)(:)(?:[ \\t]|$)",
        "captures": {
          "1": "property",
          "2": "punctuation"
        }
      },
      {
        "match": "\\b(?:do|end|if|else|unless|case|cond|for|with|fn|in|not|and|or|when)\\b",
        "token": "keyword"
      },
      {
        "match": "\\b(?:true|false|nil)\\b",
        "token": "constant"
      },
      {
        "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
        "token": "type"
      },
      {
        "match": "\\b(?:0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9_]+)?)\\b",
        "token": "number"
      },
      {
        "match": "([a-z_][a-zA-Z0-9_]*[!?]?)([ \\t]*\\()",
        "captures": {
          "1": "function",
          "2": "punctuation"
        }
      },
      {
        "match": "[a-z_][a-zA-Z0-9_]*[!?]?",
        "token": "variable"
      },
      {
        "match": "\\|>|<-|->|=>|===|!==|==|!=|<=|>=|&&|\\|\\||<>|\\+\\+|--|::|=~|[+\\-*/=!<>|&^~]",
        "token": "operator"
      },
      {
        "match": "[()\\[\\],.;:%]",
        "token": "punctuation"
      },
      {
        "match": "[ \\t]+",
        "token": "text"
      }
    ],
    "heex_brace_inner": [
      {
        "match": "\\}",
        "token": "punctuation",
        "pop": true
      },
      {
        "match": "\\{",
        "token": "punctuation",
        "push": "heex_brace_inner"
      },
      {
        "match": "\"(?:\\\\.|[^\"\\\\\\r\\n])*(?:\"|$)",
        "token": "string"
      },
      {
        "match": "'(?:\\\\.|[^'\\\\\\r\\n])*(?:'|$)",
        "token": "string"
      },
      {
        "match": "@[a-z_][a-zA-Z0-9_]*",
        "token": "variable"
      },
      {
        "match": ":[a-zA-Z_][a-zA-Z0-9_@]*[!?]?",
        "token": "constant"
      },
      {
        "match": "([a-z_][a-zA-Z0-9_]*[!?]?)(:)(?:[ \\t]|$)",
        "captures": {
          "1": "property",
          "2": "punctuation"
        }
      },
      {
        "match": "\\b(?:do|end|if|else|unless|case|cond|for|with|fn|in|not|and|or|when)\\b",
        "token": "keyword"
      },
      {
        "match": "\\b(?:true|false|nil)\\b",
        "token": "constant"
      },
      {
        "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
        "token": "type"
      },
      {
        "match": "\\b(?:0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9_]+)?)\\b",
        "token": "number"
      },
      {
        "match": "([a-z_][a-zA-Z0-9_]*[!?]?)([ \\t]*\\()",
        "captures": {
          "1": "function",
          "2": "punctuation"
        }
      },
      {
        "match": "[a-z_][a-zA-Z0-9_]*[!?]?",
        "token": "variable"
      },
      {
        "match": "\\|>|<-|->|=>|===|!==|==|!=|<=|>=|&&|\\|\\||<>|\\+\\+|--|::|=~|[+\\-*/=!<>|&^~]",
        "token": "operator"
      },
      {
        "match": "[()\\[\\],.;:%]",
        "token": "punctuation"
      },
      {
        "match": "[ \\t]+",
        "token": "text"
      }
    ]
  },
  "sample": "<div class=\"card\">\n  <.button phx-click=\"save\" :if={@can_save}>\n    <%= @label %>\n  </.button>\n</div>"
}
